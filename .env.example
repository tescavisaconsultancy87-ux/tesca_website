# ─────────────────────────────────────────────
# Gmail Mailer (PRIMARY — used for sending emails to users)
# ─────────────────────────────────────────────
GMAIL_USER=your_email@gmail.com
# Generate an App Password at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=your_gmail_app_password

# ─────────────────────────────────────────────
# Google Sheets Integration
# ─────────────────────────────────────────────
GOOGLE_SHEET_URL=https://script.google.com/macros/s/YOUR_GOOGLE_APPS_SCRIPT_ID/exec

# ─────────────────────────────────────────────
# Supabase Configuration
# ─────────────────────────────────────────────
PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
# Anon key is public-safe ONLY if Row Level Security (RLS) is enabled on all tables
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key MUST NEVER be exposed to the client
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─────────────────────────────────────────────
# CRM Supabase Integration
# ─────────────────────────────────────────────
CRM_SUPABASE_URL=https://your-crm-supabase-project.supabase.co
CRM_SUPABASE_ANON_KEY=your_crm_supabase_anon_key_here

# ─────────────────────────────────────────────
# PostHog Analytics
# ─────────────────────────────────────────────
PUBLIC_POSTHOG_KEY=your_posthog_project_api_key
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─────────────────────────────────────────────
# AI & Operational Configuration
# ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
OWNER_EMAIL=admin_email@example.com
STRICT_RATE_LIMITS=true

