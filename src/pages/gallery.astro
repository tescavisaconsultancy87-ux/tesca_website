---
import Layout from "../layouts/Layout.astro";
import AICounsellor from "../components/AICounsellor";
import { supabase } from "../utils/supabase";

const COUNTRY_CODE_MAP: Record<string, string> = {
  canada: "ca", australia: "au", "united kingdom": "gb", uk: "gb",
  "united states": "us", usa: "us", germany: "de", ireland: "ie",
  "new zealand": "nz", singapore: "sg", japan: "jp", dubai: "ae",
  uae: "ae", malaysia: "my", switzerland: "ch", europe: "eu",
};

const countryToCode = (country: string) => {
  if (!country) return "";
  return COUNTRY_CODE_MAP[country.toLowerCase().trim()] || country.slice(0, 2).toLowerCase();
};

let stories: any[] = [];

try {
  const { data, error } = await supabase
    .from('success_stories')
    .select('*')
    .order('id', { ascending: false });

  if (!error && data) {
    stories = data;
  }
} catch (err) {
  console.error("Failed to load success stories from Supabase:", err);
}
---

<Layout 
  title="TESCA Gallery | Success Stories & Office Tour"
  description="Browse TESCA Visa Consultancy's success gallery — visa approvals, IELTS & PTE achievements, and a virtual office tour of our Surat campus."
>
  <section class="max-w-7xl mx-auto px-6 md:px-8 py-12">
    
    <!-- Premium Header Banner Card -->
    <div class="glass-card rounded-[2rem] overflow-hidden bg-slate-50/80 border border-slate-200/60 shadow-lg grid grid-cols-1 md:grid-cols-12 gap-8 items-center p-8 md:p-12 relative mb-16">
      
      {/* Subtle Background Auroras */}
      <div class="aurora-bg w-[300px] h-[300px] bg-accent-blue/5 -top-12 -left-12 rounded-full blur-[80px]"></div>

      {/* Left Column: Text Content */}
      <div class="md:col-span-7 space-y-6 text-left relative z-10">
        <span class="inline-block text-xs font-semibold tracking-wider text-slate-800 bg-accent-blue/10 px-4 py-1.5 rounded-full border border-accent-blue/20 font-sans uppercase">
          Our Gallery
        </span>
        <h1 class="text-[36px] sm:text-[48px] lg:text-[56px] font-extrabold font-display text-support-white tracking-tight leading-none">
          Success Stories & Office Tour
        </h1>
        <p class="text-base md:text-[18px] text-support-gray font-sans font-normal leading-relaxed max-w-xl">
          Browse real visa approvals, IELTS & PTE achievements from our students, and take a virtual tour of our Surat office.
        </p>
      </div>

      {/* Right Column: Hero Image cutout */}
      <div class="md:col-span-5 relative flex justify-center md:justify-end self-stretch items-center">
        <div class="relative w-full max-w-[320px] md:max-w-[400px] flex items-center aspect-[4/3] rounded-2xl overflow-hidden shadow-md border border-accent-blue/15">
          <img 
            src="/images/gallery_hero.webp" 
            alt="TESCA success gallery" 
            class="object-cover w-full h-full select-none"
            decoding="async"
            width="1920"
            height="1080"
          />
        </div>
      </div>

    </div>
  </section>

  <section class="max-w-7xl mx-auto px-6 md:px-8 py-12">
    {/* Virtual Office Tour Video Section */}
    <div class="mb-20">
      <div class="flex items-center gap-3 mb-10">
        <div class="p-3 rounded-xl bg-accent-blue/10 text-accent-blue flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2" ry="2"/></svg>
        </div>
        <div>
          <h2 class="text-[28px] sm:text-[32px] font-bold text-slate-800 font-display tracking-tight">Virtual Office Tour</h2>
          <p class="text-sm text-slate-500 font-sans font-normal">Step inside our premium consultancy space in Surat</p>
        </div>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="relative aspect-[16/9] rounded-[2rem] overflow-hidden bg-slate-900 border border-slate-200/60 shadow-xl group">
          <video 
            poster="/images/office_photo.jpg"
            preload="metadata" 
            controls 
            playsinline 
            class="w-full h-full object-cover select-none"
          >
            <source src="/VIDEO/tesca-office-reel.mp4" type="video/mp4" />
            Your browser does not support the video tag.
          </video>
        </div>
      </div>
    </div>

    {/* Success Gallery Section */}
    <div class="mb-20">
      <div class="flex items-center gap-3 mb-10">
        <div class="p-3 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 10 3 12 0v-5"/></svg>
        </div>
        <div>
          <h2 class="text-[28px] sm:text-[32px] font-bold text-slate-800 font-display tracking-tight">Success Gallery</h2>
          <p class="text-sm text-slate-500 font-sans font-normal">Real visa approvals, IELTS & PTE achievements from our students</p>
        </div>
      </div>

      {stories.length === 0 ? (
        <div class="bg-white rounded-3xl border border-slate-200/80 p-12 text-center space-y-4 shadow-sm">
          <div class="w-16 h-16 rounded-2xl bg-emerald-50 text-emerald-600 mx-auto flex items-center justify-center text-3xl">
            🎓
          </div>
          <h3 class="text-xl font-bold text-slate-900 font-display">Success Stories Coming Soon</h3>
          <p class="text-sm text-slate-500 font-sans max-w-md mx-auto leading-relaxed">
            Our success gallery is being updated. Check back soon to see our students' achievements!
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-5">
          {stories.map((student) => {
            const isVisa = student.type === "Visa Success";
            const cc = student.country ? countryToCode(student.country) : "";
            
            return (
              <div class="rounded-2xl overflow-hidden border border-slate-200 bg-white shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300 group text-left flex flex-col">
                {/* Photo */}
                <div class="relative w-full aspect-[4/5] overflow-hidden bg-slate-50 shrink-0">
                  <img 
                    src={student.photo} 
                    alt={student.name} 
                    class="w-full h-full object-contain group-hover:scale-[1.03] transition-transform duration-500 select-none"
                    loading="lazy"
                    decoding="async"
                    width="400"
                    height="500"
                  />

                  {/* Country flag for visa success */}
                  {isVisa && cc && (
                    <div class="absolute top-2.5 right-2.5 bg-white/90 backdrop-blur-[2px] p-1.5 rounded-xl shadow-xs border border-slate-100 flex items-center justify-center">
                      <img
                        src={`https://flagcdn.com/w40/${cc}.png`}
                        alt={`${student.country} flag`}
                        class="w-5 h-3.5 rounded-xs object-cover"
                        loading="lazy"
                      />
                    </div>
                  )}

                  {/* Type badge overlay */}
                  <div class="absolute bottom-2.5 left-2.5">
                    <span class:list={[
                      "text-[10px] font-bold uppercase tracking-wider px-2.5 py-1 rounded-lg shadow-sm backdrop-blur-sm",
                      isVisa ? "bg-emerald-500/90 text-white" : student.type === "IELTS" ? "bg-blue-500/90 text-white" : "bg-purple-500/90 text-white"
                    ]}>
                      {student.type}
                    </span>
                  </div>
                </div>

                {/* Info */}
                <div class="p-3.5 border-t border-slate-100 flex-grow flex flex-col justify-between">
                  <div>
                    <h3 class="text-sm font-bold text-slate-800 font-display truncate leading-snug group-hover:text-[#0A7880] transition-colors">
                      {student.name}
                    </h3>
                    <p class="text-[11px] text-slate-500 font-medium mt-1 truncate">
                      {isVisa ? `Visa: ${student.country}` : `${student.type} Overall: ${student.score}`}
                    </p>
                  </div>
                  <div class="flex items-center justify-between mt-3 pt-2.5 border-t border-slate-100">
                    <span class="text-[12px] font-extrabold text-[#0A7880] font-display">
                      {isVisa ? "Approved ✓" : student.score}
                    </span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>

  </section>

  <AICounsellor client:only="react" />
</Layout>

