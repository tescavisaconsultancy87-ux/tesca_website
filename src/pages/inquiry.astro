---
export const prerender = true;
import "../styles/global.css";
import InquiryFormCRM from "../components/InquiryFormCRM";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <title>Quick Enquiry & Free Assessment | TESCA Visa Consultancy</title>
    <meta name="description" content="Get free study abroad and visa counselling. Fill in your details and our expert counsellors will assess your profile within 24 hours." />
    <link rel="canonical" href="https://tescavisa.com/inquiry" />
    <meta property="og:title" content="Quick Enquiry & Free Assessment | TESCA Visa Consultancy" />
    <meta property="og:description" content="Get free study abroad and visa counselling. Fill in your details and our expert counsellors will assess your profile within 24 hours." />
    <meta property="og:url" content="https://tescavisa.com/inquiry" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://tescavisa.com/images/Tesca_logo.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "ContactPage",
        "name": "Quick Enquiry & Free Assessment",
        "description": "Get free study abroad counselling from TESCA Visa Consultancy.",
        "url": "https://tescavisa.com/inquiry"
      }
    </script>
  </head>
  <body class="bg-gradient-to-br from-slate-50 via-slate-50 to-[#0F4C81]/5 min-h-screen flex flex-col items-center justify-start p-3 sm:p-6 font-sans">
    
    <!-- Top Navigation Header -->
    <header class="w-full max-w-5xl mx-auto flex items-center justify-between py-4 px-2 mb-2">
      <a 
        href="/" 
        class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-slate-700 hover:text-accent-blue transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        <span>Back to Home</span>
      </a>

      <div class="flex items-center gap-2">
        <a 
          href="https://wa.me/919824152731" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold shadow-sm transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          <span>WhatsApp Us</span>
        </a>
      </div>
    </header>

    <main class="w-full max-w-5xl mx-auto">
      <!-- Full CRM Assessment Form -->
      <InquiryFormCRM client:load />
    </main>

  </body>
</html>
