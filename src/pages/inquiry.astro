---
export const prerender = true;
import "../styles/global.css";
import InquiryFormCRM from "../components/InquiryFormCRM";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <title>Quick Enquiry | TESCA Visa Consultancy</title>
    <meta name="description" content="Get free study abroad counselling. Fill in your details and our expert counsellors will contact you within 24 hours." />
    <link rel="canonical" href="https://tescavisa.com/inquiry/" />
    <meta property="og:title" content="Quick Enquiry | TESCA Visa Consultancy" />
    <meta property="og:description" content="Get free study abroad counselling. Fill in your details and our expert counsellors will contact you within 24 hours." />
    <meta property="og:url" content="https://tescavisa.com/inquiry/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://tescavisa.com/images/Tesca_logo.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json">{"@context":"https://schema.org","@type":"ContactPage","name":"Quick Enquiry","description":"Get free study abroad counselling from TESCA Visa Consultancy.","url":"https://tescavisa.com/inquiry/"}</script>
  </head>
  <body class="bg-gradient-to-br from-slate-50 to-[#0F4C81]/5 min-h-screen flex flex-col items-center justify-center p-3 md:p-8 font-sans">
    
    <main class="w-full max-w-5xl mx-auto p-2 sm:p-4 md:p-6">
      
      <!-- Full CRM Assessment Form -->
      <InquiryFormCRM client:load />
      
    </main>

  </body>
</html>
