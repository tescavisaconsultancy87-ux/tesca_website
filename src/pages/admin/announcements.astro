---
import Layout from "../../layouts/Layout.astro";
import AdminHeader from "../../components/AdminHeader.astro";
import { checkAdminAuth } from "../../utils/adminAuth";
import { supabase } from "../../utils/supabase";

// Inline SVG helpers — zero React dependencies = zero hydration errors
const _s = (d: string) => `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const SVG = {
  Trash2: _s('<path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/>'),
  Plus: _s('<path d="M12 5v14"/><path d="M5 12h14"/>'),
  Megaphone: _s('<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>'),
  Search: _s('<circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>'),
  ShieldAlert: _s('<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v4"/><path d="M12 16h.01"/>'),
};

// Check session
const isAuthenticated = await checkAdminAuth(Astro.cookies);
if (!isAuthenticated) {
  return Astro.redirect("/admin");
}

let announcements: any[] = [];
let successMessage = "";
let errorMessage = "";

// Handle server actions (Add / Delete / Bulk Delete)
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("action");

    if (action === "add-announcement") {
      const text = formData.get("text")?.toString().trim();

      if (text) {
        const { error } = await supabase
          .from("announcements")
          .insert({ text });

        if (error) throw error;
        successMessage = "New announcement alert posted successfully.";
      } else {
        errorMessage = "Announcement text cannot be empty.";
      }
    } else if (action === "delete-announcement") {
      const id = parseInt(formData.get("id")?.toString() || "0");
      if (id) {
        const { error } = await supabase
          .from("announcements")
          .delete()
          .eq("id", id);

        if (error) throw error;
        successMessage = "Announcement removed successfully.";
      }
    } else if (action === "bulk-delete-announcements") {
      const idsRaw = formData.get("ids")?.toString() || "";
      const ids = idsRaw.split(",").map(id => parseInt(id.trim())).filter(id => !isNaN(id) && id > 0);

      if (ids.length > 0) {
        const { error } = await supabase
          .from("announcements")
          .delete()
          .in("id", ids);

        if (error) throw error;
        successMessage = `${ids.length} announcements deleted successfully.`;
      }
    }
  } catch (err: any) {
    console.error("Failed to process announcement action:", err);
    errorMessage = "Failed to complete action. Please try again.";
  }
}

// Load announcements
try {
  const { data, error } = await supabase
    .from("announcements")
    .select("*")
    .order("id", { ascending: false });

  if (error) throw error;
  announcements = data || [];
} catch (err) {
  console.error("Failed to load announcements:", err);
  errorMessage = "Failed to load database records.";
}
---

<Layout 
  title="Manage Announcement Bar Alerts | TESCA Admin"
  description="Administrative portal to configure announcement banner alert strings."
  showNavFooter={false}
>
  <div class="min-h-screen bg-slate-50 text-slate-800 font-sans flex flex-col lg:flex-row">
    <AdminHeader activeTab="announcements" />

    <main class="flex-1 px-4 md:px-8 py-10 overflow-y-auto text-left lg:ml-64">
      <div class="mb-8">
        <h1 class="text-3xl font-extrabold font-display tracking-tight text-slate-800">
          Announcement Alert Bar
        </h1>
        <p class="text-slate-500 text-xs mt-1">Configure alerts rotating dynamically in the header strip at the top of the website.</p>
      </div>

      <!-- Messages -->
      {errorMessage && (
        <div class="p-4 bg-rose-50 border border-rose-200 rounded-2xl text-rose-600 text-xs font-semibold mb-6 flex items-center gap-2">
          <Fragment set:html={SVG.ShieldAlert} />
          <span>{errorMessage}</span>
        </div>
      )}
      {successMessage && (
        <div class="p-4 bg-emerald-50 border border-emerald-200 rounded-2xl text-emerald-600 text-xs font-semibold mb-6 flex items-center gap-2">
          <span class="text-emerald-500 font-bold">✓</span>
          <span>{successMessage}</span>
        </div>
      )}

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left Form Panel -->
        <div class="lg:col-span-5 bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
          <h2 class="text-base font-bold text-slate-800 mb-4 flex items-center gap-2">
            <span class="text-indigo-600 font-bold"><Fragment set:html={SVG.Plus} /></span>
            <span>Add Announcement Alert</span>
          </h2>

          <form method="POST" class="space-y-4 text-xs font-semibold text-slate-600" id="announcement-form">
            <input type="hidden" name="action" value="add-announcement" />

            <div class="space-y-1.5">
              <label class="text-[10px] text-slate-500 uppercase tracking-wide">Alert Message Text *</label>
              <textarea
                name="text"
                required
                rows="4"
                class="w-full px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all"
                placeholder="e.g. 🎓 Fall 2026 Admissions Open for UK & Canada! Book your free profile evaluation today."
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold rounded-xl shadow-sm transition flex items-center justify-center gap-2 cursor-pointer"
            >
              <Fragment set:html={SVG.Megaphone} />
              <span>Post Announcement</span>
            </button>
          </form>
        </div>

        <!-- Right Announcements List -->
        <div class="lg:col-span-7 space-y-4">
          <div class="bg-white border border-slate-200 rounded-3xl p-6 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
              <div>
                <h2 class="text-base font-bold text-slate-800">Active Header Alerts</h2>
                <p class="text-slate-500 text-xs mt-0.5">{announcements.length} total rotating alerts</p>
              </div>

              <div id="bulk-delete-container" class="hidden">
                <form method="POST" id="bulk-delete-form">
                  <input type="hidden" name="action" value="bulk-delete-announcements" />
                  <input type="hidden" name="ids" id="bulk-delete-ids" value="" />
                  <button
                    type="submit"
                    class="py-2 px-3 bg-rose-600 hover:bg-rose-700 text-white rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-sm cursor-pointer"
                  >
                    <Fragment set:html={SVG.Trash2} />
                    <span id="bulk-delete-count-btn">Delete Selected</span>
                  </button>
                </form>
              </div>
            </div>

            <!-- Search Input -->
            <div class="relative mb-4">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400">
                <Fragment set:html={SVG.Search} />
              </span>
              <input
                type="text"
                id="announcement-search-input"
                placeholder="Search alerts..."
                class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all"
              />
            </div>

            <!-- List -->
            {announcements.length === 0 ? (
              <div class="text-center py-12 border-2 border-dashed border-slate-100 rounded-2xl">
                <div class="text-slate-300 mx-auto mb-2 flex justify-center scale-150">
                  <Fragment set:html={SVG.Megaphone} />
                </div>
                <p class="text-slate-500 text-xs font-medium mt-2">No announcements found in database.</p>
              </div>
            ) : (
              <div class="space-y-3 max-h-[550px] overflow-y-auto pr-1" id="announcements-list">
                <div class="flex items-center justify-between px-3 py-2 bg-slate-50 rounded-xl text-[10px] uppercase font-bold text-slate-400 tracking-wider">
                  <label class="flex items-center gap-2 cursor-pointer">
                    <input
                      type="checkbox"
                      id="select-all-announcements"
                      class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-3.5 h-3.5 cursor-pointer"
                    />
                    <span>Select All</span>
                  </label>
                  <span>Action</span>
                </div>

                {announcements.map((item) => (
                  <div
                    class="announcement-card p-4 rounded-2xl border border-slate-100 hover:border-slate-200 bg-white transition-all flex items-start justify-between gap-3"
                    data-id={item.id}
                    data-text={(item.text || "").toLowerCase()}
                  >
                    <div class="flex items-start gap-3 min-w-0 pt-0.5">
                      <input
                        type="checkbox"
                        class="announcement-checkbox rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 w-3.5 h-3.5 mt-0.5 cursor-pointer"
                        value={item.id}
                      />
                      <div class="space-y-1 min-w-0">
                        <p class="text-xs font-semibold text-slate-800 leading-snug">{item.text || ""}</p>
                      </div>
                    </div>

                    <form method="POST" class="delete-single-form shrink-0">
                      <input type="hidden" name="action" value="delete-announcement" />
                      <input type="hidden" name="id" value={item.id} />
                      <button
                        type="submit"
                        class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition cursor-pointer"
                        title="Delete Announcement"
                      >
                        <Fragment set:html={SVG.Trash2} />
                      </button>
                    </form>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  function setupAnnouncements() {
    const searchInput = document.getElementById("announcement-search-input") as HTMLInputElement;
    const cards = document.querySelectorAll(".announcement-card");
    const selectAllCheckbox = document.getElementById("select-all-announcements") as HTMLInputElement;
    const itemCheckboxes = document.querySelectorAll(".announcement-checkbox") as NodeListOf<HTMLInputElement>;
    const bulkContainer = document.getElementById("bulk-delete-container");
    const bulkDeleteIdsInput = document.getElementById("bulk-delete-ids") as HTMLInputElement;
    const bulkCountBtn = document.getElementById("bulk-delete-count-btn");

    function updateBulkState() {
      const selected: string[] = [];
      itemCheckboxes.forEach(cb => {
        if (cb.checked) {
          selected.push(cb.value);
          cb.closest(".announcement-card")?.classList.add("bg-indigo-50/50", "border-indigo-200");
        } else {
          cb.closest(".announcement-card")?.classList.remove("bg-indigo-50/50", "border-indigo-200");
        }
      });

      if (bulkContainer && bulkDeleteIdsInput) {
        if (selected.length > 0) {
          bulkContainer.classList.remove("hidden");
          bulkDeleteIdsInput.value = selected.join(",");
          if (bulkCountBtn) bulkCountBtn.textContent = `Delete (${selected.length})`;
        } else {
          bulkContainer.classList.add("hidden");
          bulkDeleteIdsInput.value = "";
        }
      }

      if (selectAllCheckbox) {
        selectAllCheckbox.checked = itemCheckboxes.length > 0 && Array.from(itemCheckboxes).every(cb => cb.checked);
      }
    }

    if (selectAllCheckbox) {
      selectAllCheckbox.addEventListener("change", () => {
        itemCheckboxes.forEach(cb => {
          const card = cb.closest(".announcement-card") as HTMLElement;
          if (card && card.style.display !== "none") {
            cb.checked = selectAllCheckbox.checked;
          }
        });
        updateBulkState();
      });
    }

    itemCheckboxes.forEach(cb => {
      cb.addEventListener("change", updateBulkState);
    });

    if (searchInput) {
      searchInput.addEventListener("input", () => {
        const query = searchInput.value.trim().toLowerCase();
        cards.forEach(c => {
          const el = c as HTMLElement;
          const text = el.dataset.text || "";

          if (!query || text.includes(query)) {
            el.style.display = "";
          } else {
            el.style.display = "none";
          }
        });
      });
    }

    // Confirmation on single delete
    const deleteForms = document.querySelectorAll(".delete-single-form");
    deleteForms.forEach(form => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const confirmed = typeof window !== "undefined" && (window as any).showConfirmDialog
          ? await (window as any).showConfirmDialog({
              title: "Delete Announcement Alert?",
              description: "Are you sure you want to delete this announcement alert? This action cannot be undone.",
              actionText: "Delete",
              cancelText: "Cancel",
              variant: "destructive",
              from: "bottom"
            })
          : confirm("Are you sure you want to delete this announcement?");

        if (confirmed) {
          (form as HTMLFormElement).submit();
        }
      });
    });

    // Confirmation on bulk delete
    const bulkDeleteForm = document.getElementById("bulk-delete-form");
    if (bulkDeleteForm) {
      bulkDeleteForm.addEventListener("submit", async (e) => {
        e.preventDefault();
        const count = bulkDeleteIdsInput?.value.split(",").filter(Boolean).length || 0;
        const confirmed = typeof window !== "undefined" && (window as any).showConfirmDialog
          ? await (window as any).showConfirmDialog({
              title: "Delete Selected Announcements?",
              description: `Are you sure you want to delete ${count} selected announcements? This cannot be undone.`,
              actionText: "Delete",
              cancelText: "Cancel",
              variant: "destructive",
              from: "bottom"
            })
          : confirm(`Are you sure you want to delete ${count} selected announcements? This cannot be undone.`);

        if (confirmed) {
          (bulkDeleteForm as HTMLFormElement).submit();
        }
      });
    }
  }

  setupAnnouncements();
  document.addEventListener("astro:page-load", setupAnnouncements);
</script>
