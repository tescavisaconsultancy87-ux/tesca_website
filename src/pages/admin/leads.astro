          `;

          listContainer.appendChild(followupSection);
          modalContent.appendChild(listContainer);

          // Add AJAX submit handler for details modal follow-up note form (adding new note)
          const detailsFollowupForm = modalContent.querySelector("form") as HTMLFormElement;
          if (detailsFollowupForm) {
            detailsFollowupForm.addEventListener("submit", async (fe) => {
              fe.preventDefault();
              const noteEl = detailsFollowupForm.querySelector('textarea[name="note"]') as HTMLTextAreaElement;
              const dateEl = detailsFollowupForm.querySelector('input[name="next_followup"]') as HTMLInputElement;
              const dateVal = dateEl ? dateEl.value.trim() : "";
              const noteText = noteEl ? noteEl.value.trim() : "";
              const wordCount = noteText ? noteText.split(/\s+/).filter(Boolean).length : 0;

              if (!dateVal) {
                alert("Next follow-up date is required.");
                return;
              }

              if (wordCount < 3) {
                alert(`Follow-up note must contain at least 3 words (currently ${wordCount} word${wordCount === 1 ? '' : 's'}).`);
                return;
              }

              const submitBtn = detailsFollowupForm.querySelector('button[type="submit"]') as HTMLElement;
              if ((window as any).showBtnLoader) (window as any).showBtnLoader(submitBtn, "Saving...");

              const formData = new FormData(detailsFollowupForm);
              try {
                const res = await fetch(window.location.href, {
                  method: "POST",
                  body: formData
                });
                const ok = await handleResponse(res, "Follow-up note logged successfully.");
                if (ok) {
                  const updatedBtn = document.querySelector(`.view-details-btn[data-id="${leadId}"]`);
                  if (updatedBtn) openModal(updatedBtn);
                }
              } catch (err) {
                console.error("AJAX add note error:", err);
              } finally {
                if ((window as any).hideBtnLoader) (window as any).hideBtnLoader(submitBtn);
              }
            });
          }

          // Attach event handlers for Edit & Delete buttons inside timeline entries
          const noteCards = modalContent.querySelectorAll(".note-card-item");
          noteCards.forEach((card) => {
            const noteId = card.getAttribute("data-note-id");
            const viewBox = card.querySelector(".note-view-box") as HTMLElement;
            const editBox = card.querySelector(".note-edit-box") as HTMLElement;
            const btnEdit = card.querySelector(".btn-edit-note") as HTMLButtonElement;
            const btnDelete = card.querySelector(".btn-delete-note") as HTMLButtonElement;
            const btnCancel = card.querySelector(".btn-cancel-edit") as HTMLButtonElement;
            const btnSave = card.querySelector(".btn-save-edit") as HTMLButtonElement;
            const noteTextarea = card.querySelector(".input-edit-note") as HTMLTextAreaElement;
            const dateInput = card.querySelector(".input-edit-date") as HTMLInputElement;
            const outcomeSelect = card.querySelector(".input-edit-outcome") as HTMLSelectElement;
            const wordBadge = card.querySelector(".word-count-badge") as HTMLElement;

            if (btnEdit && viewBox && editBox) {
              btnEdit.addEventListener("click", () => {
                viewBox.classList.add("hidden");
                editBox.classList.remove("hidden");
                if (noteTextarea && wordBadge) {
                  const updateCount = () => {
                    const words = noteTextarea.value.trim().split(/\s+/).filter(Boolean).length;
                    wordBadge.textContent = words >= 3 ? `${words} words` : `${words}/3 words min`;
                    wordBadge.className = words >= 3 ? "word-count-badge text-[9px] font-bold text-emerald-600" : "word-count-badge text-[9px] font-bold text-rose-500";
                  };
                  noteTextarea.oninput = updateCount;
                  updateCount();
                }
              });
            }

            if (btnCancel && viewBox && editBox) {
              btnCancel.addEventListener("click", () => {
                editBox.classList.add("hidden");
                viewBox.classList.remove("hidden");
              });
            }

            if (btnSave) {
              btnSave.addEventListener("click", async () => {
                const outcomeVal = outcomeSelect ? outcomeSelect.value : "";
                const dateVal = dateInput ? dateInput.value.trim() : "";
                const noteVal = noteTextarea ? noteTextarea.value.trim() : "";
                const wordCount = noteVal ? noteVal.split(/\s+/).filter(Boolean).length : 0;

                if (!dateVal) {
                  alert("Next follow-up date is required.");
                  return;
                }
                if (wordCount < 3) {
                  alert(`Follow-up note must contain at least 3 words (currently ${wordCount}).`);
                  return;
                }

                if ((window as any).showBtnLoader) (window as any).showBtnLoader(btnSave, "Saving...");

                const formData = new FormData();
                formData.append("action", "edit-followup-note");
                formData.append("id", leadId);
                formData.append("note_id", noteId || "");
                formData.append("outcome", outcomeVal);
                formData.append("next_followup", dateVal);
                formData.append("note", noteVal);

                try {
                  const res = await fetch(window.location.href, {
                    method: "POST",
                    body: formData
                  });
                  const ok = await handleResponse(res, "Follow-up note updated successfully.");
                  if (ok) {
                    const updatedBtn = document.querySelector(`.view-details-btn[data-id="${leadId}"]`);
                    if (updatedBtn) openModal(updatedBtn);
                  }
                } catch (err) {
                  console.error("AJAX edit note error:", err);
                } finally {
                  if ((window as any).hideBtnLoader) (window as any).hideBtnLoader(btnSave);
                }
              });
            }

            if (btnDelete) {
              btnDelete.addEventListener("click", async () => {
                let confirmed = true;
                if ((window as any).showConfirmDialog) {
                  confirmed = await (window as any).showConfirmDialog({
                    title: "Delete Follow-Up Note?",
                    description: "Are you sure you want to delete this follow-up note entry from the call history?",
                    actionText: "Delete Note",
                    cancelText: "Cancel",
                    variant: "destructive",
                    from: "bottom"
                  });
                } else {
                  confirmed = confirm("Are you sure you want to delete this follow-up note entry?");
                }
                if (!confirmed) return;

                const formData = new FormData();
                formData.append("action", "delete-followup-note");
                formData.append("id", leadId);
                formData.append("note_id", noteId || "");

                try {
                  const res = await fetch(window.location.href, {
                    method: "POST",
                    body: formData
                  });
                  const ok = await handleResponse(res, "Follow-up note deleted successfully.");
                  if (ok) {
                    const updatedBtn = document.querySelector(`.view-details-btn[data-id="${leadId}"]`);
                    if (updatedBtn) openModal(updatedBtn);
                  }
                } catch (err) {
                  console.error("AJAX delete note error:", err);
                }
              });
            }
          });

          // Attach custom animated dropdown listeners
          const dropBtn = modalContent.querySelector("#outcome-dropdown-btn");
          const dropMenu = modalContent.querySelector("#outcome-dropdown-menu");
          const dropChevron = modalContent.querySelector("#outcome-chevron");
          const hiddenInput = modalContent.querySelector("#outcome-hidden-input") as HTMLInputElement;
          const selectedLabel = modalContent.querySelector("#outcome-selected-label");

          if (dropBtn && dropMenu) {
            dropBtn.addEventListener("click", (e) => {
              e.stopPropagation();
              const isHidden = dropMenu.classList.contains("hidden");
              if (isHidden) {
                dropMenu.classList.remove("hidden");
                requestAnimationFrame(() => {
                  dropMenu.classList.remove("scale-95", "opacity-0");
                  dropMenu.classList.add("scale-100", "opacity-100");
                });
                dropChevron?.classList.add("rotate-180");
              } else {
                dropMenu.classList.remove("scale-100", "opacity-100");
                dropMenu.classList.add("scale-95", "opacity-0");
                dropChevron?.classList.remove("rotate-180");
                setTimeout(() => dropMenu.classList.add("hidden"), 150);
              }
            });

            const optionItems = dropMenu.querySelectorAll(".outcome-option-item");
            optionItems.forEach((item) => {
              item.addEventListener("click", (e) => {
                e.stopPropagation();
                const val = item.getAttribute("data-val") || "";
                if (hiddenInput) hiddenInput.value = val;
                if (selectedLabel) selectedLabel.innerHTML = item.querySelector("span")?.innerHTML || val;

                optionItems.forEach((opt) => {
                  opt.classList.remove("bg-violet-50", "text-violet-700", "font-bold");
                  opt.classList.add("font-semibold", "text-slate-700");
                  const check = opt.querySelector("svg");
                  if (check) check.remove();
                });

                item.classList.add("bg-violet-50", "text-violet-700", "font-bold");
                item.classList.remove("font-semibold", "text-slate-700");
                
                const checkSvg = document.createElement("div");
                checkSvg.innerHTML = `<svg class="w-3.5 h-3.5 text-violet-600 font-bold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>`;
                item.appendChild(checkSvg.firstElementChild!);

                dropMenu.classList.remove("scale-100", "opacity-100");
                dropMenu.classList.add("scale-95", "opacity-0");
                dropChevron?.classList.remove("rotate-180");
                setTimeout(() => dropMenu.classList.add("hidden"), 150);
              });
            });

            document.addEventListener("click", () => {
              if (!dropMenu.classList.contains("hidden")) {
                dropMenu.classList.remove("scale-100", "opacity-100");
                dropMenu.classList.add("scale-95", "opacity-0");
                dropChevron?.classList.remove("rotate-180");
                setTimeout(() => dropMenu.classList.add("hidden"), 150);
              }
            });
          }
        } catch (e) {
          modalContent.innerText = "Error parsing lead details.";
        }
      }

      modal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    };

    const closeModal = () => {
      modal?.classList.add("hidden");
      document.body.style.overflow = "";
    };

    // Remove old event listeners if any (though astro runs scripts scoped, it's good practice)
    viewButtons.forEach(btn => {
      btn.addEventListener("click", () => openModal(btn));
    });

    closeBtn?.addEventListener("click", closeModal);
    closeFooterBtn?.addEventListener("click", closeModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) closeModal();
    });
  }

  async function handleResponse(res: Response, successMsg: string, targetRow?: HTMLElement | null) {
    if (res.redirected || (res.url && res.url.includes("/admin") && !window.location.pathname.endsWith("/admin"))) {
      window.location.href = res.url || "/admin";
      return false;
    }
    if (res.ok) {
      if (targetRow) {
        targetRow.style.transition = "all 0.3s ease";
        targetRow.style.opacity = "0";
        targetRow.style.transform = "scale(0.95)";
        setTimeout(() => targetRow.remove(), 300);
      } else {
        const htmlText = await res.text();
        const parser = new DOMParser();
        const doc = parser.parseFromString(htmlText, "text/html");
        const errorBanner = doc.querySelector(".admin-alert-banner.bg-rose-50");
        if (errorBanner) {
          alert("Error: " + (errorBanner.textContent?.trim() || "An error occurred"));
          return false;
        }
        const currentContainer = document.querySelector("#leads-table-container") || document.querySelector("main");
        const newContainer = doc.querySelector("#leads-table-container") || doc.querySelector("main");
        if (currentContainer && newContainer && newContainer.children.length > 0) {
          currentContainer.innerHTML = newContainer.innerHTML;
          setupLeadsPage();
        } else {
          window.location.reload();
          return true;
        }
      }
      if ((window as any).showToast) {
        (window as any).showToast(successMsg, "success");
      }
      return true;
    }
    alert("Request failed. Please try again.");
    return false;
  }

  function setupLeadsPage() {
    setupModal();
    setupTableSlider();

    function setupTableSlider() {
      const container = document.getElementById("leads-table-container");
      const topSlider = document.getElementById("table-slider-input") as HTMLInputElement;
      const topBtnLeft = document.getElementById("slider-btn-left");
      const topBtnRight = document.getElementById("slider-btn-right");
      const stickyBar = document.getElementById("floating-scroll-bar");
      const stickySlider = document.getElementById("sticky-slider-input") as HTMLInputElement;
      const stickyBtnLeft = document.getElementById("sticky-btn-left");
      const stickyBtnRight = document.getElementById("sticky-btn-right");

      if (!container) return;

      function updateSliderVisibility() {
        if (!container) return;
        const maxScroll = container.scrollWidth - container.clientWidth;
        const hasOverflow = maxScroll > 5;
        
        if (stickyBar) {
          if (hasOverflow) {
            stickyBar.classList.remove("opacity-0", "translate-y-2", "pointer-events-none");
            stickyBar.classList.add("opacity-100", "translate-y-0");
          } else {
            stickyBar.classList.add("opacity-0", "translate-y-2", "pointer-events-none");
            stickyBar.classList.remove("opacity-100", "translate-y-0");
          }
        }
      }

      function syncSlidersFromScroll() {
        if (!container) return;
        const maxScroll = container.scrollWidth - container.clientWidth;
        if (maxScroll <= 0) return;
        const pct = Math.round((container.scrollLeft / maxScroll) * 100);
        if (topSlider) topSlider.value = String(pct);
        if (stickySlider) stickySlider.value = String(pct);
      }

      function scrollTableToPct(pct: number) {
        if (!container) return;
        const maxScroll = container.scrollWidth - container.clientWidth;
        container.scrollLeft = (pct / 100) * maxScroll;
      }

      function scrollByOffset(offset: number) {
        if (!container) return;
        container.scrollBy({ left: offset, behavior: "smooth" });
      }

      container.addEventListener("scroll", syncSlidersFromScroll, { passive: true });

      topSlider?.addEventListener("input", (e) => {
        scrollTableToPct(parseFloat((e.target as HTMLInputElement).value));
      });

      stickySlider?.addEventListener("input", (e) => {
        scrollTableToPct(parseFloat((e.target as HTMLInputElement).value));
      });

      topBtnLeft?.addEventListener("click", () => scrollByOffset(-250));
      topBtnRight?.addEventListener("click", () => scrollByOffset(250));
      stickyBtnLeft?.addEventListener("click", () => scrollByOffset(-250));
      stickyBtnRight?.addEventListener("click", () => scrollByOffset(250));

      window.addEventListener("resize", updateSliderVisibility);
      updateSliderVisibility();
    }

    // AJAX for changing status and deleting lead
    const forms = document.querySelectorAll("form");
    forms.forEach(form => {
      if ((form as any)._ajaxBound) return;
      (form as any)._ajaxBound = true;



      const toggleMenu = (dropdownEl: HTMLElement, show: boolean) => {
        const menuEl = dropdownEl.querySelector(".dropdown-menu-content") as HTMLElement;
        if (show) {
          dropdownEl.classList.add("open");
          if (menuEl) {
            menuEl.classList.remove("opacity-0", "scale-95", "translate-y-[-4px]", "pointer-events-none");
            menuEl.classList.add("opacity-100", "scale-100", "translate-y-0", "pointer-events-auto");
          }
        } else {
          dropdownEl.classList.remove("open");
          if (menuEl) {
            menuEl.classList.add("opacity-0", "scale-95", "translate-y-[-4px]", "pointer-events-none");
            menuEl.classList.remove("opacity-100", "scale-100", "translate-y-0", "pointer-events-auto");
          }
        }
      };

      // Bind custom dropdown menu interactions
      const dropdown = form.querySelector('.custom-dropdown') as HTMLElement;
      if (dropdown) {
        const trigger = dropdown.querySelector(".status-dropdown-trigger") as HTMLButtonElement;
        const statusInput = form.querySelector('input[name="status"]') as HTMLInputElement;

        trigger?.addEventListener("click", (e) => {
          e.stopPropagation();
          // Close other dropdowns
          document.querySelectorAll(".custom-dropdown").forEach(other => {
            if (other !== dropdown) toggleMenu(other as HTMLElement, false);
          });
          const isOpen = dropdown.classList.contains("open");
          toggleMenu(dropdown, !isOpen);
        });

        const items = dropdown.querySelectorAll("[role='menuitem']");
        items.forEach(item => {
          item.addEventListener("click", async (e) => {
            e.stopPropagation();
            const val = item.getAttribute("data-value") || "pending";
            const prevVal = statusInput.value || "pending";

            if (val === prevVal) {
              toggleMenu(dropdown, false);
              return;
            }

            if (val === 'follow up') {
              toggleMenu(dropdown, false);
              const promptModal = document.getElementById("followup-prompt-modal");
              const promptForm = document.getElementById("followup-prompt-form") as HTMLFormElement;
              const leadIdInput = document.getElementById("followup-prompt-lead-id") as HTMLInputElement;
              const dateInput = document.getElementById("followup-prompt-date") as HTMLInputElement;
              const outcomeInput = document.getElementById("followup-prompt-outcome") as HTMLSelectElement;
              const noteInput = document.getElementById("followup-prompt-note") as HTMLTextAreaElement;
              const errorDiv = document.getElementById("followup-prompt-error");
              const wordCountBadge = document.getElementById("followup-word-count-badge");
              const closeBtn = document.getElementById("close-followup-prompt-btn");
              const cancelBtn = document.getElementById("cancel-followup-prompt-btn");

              if (promptModal && promptForm && leadIdInput) {
                leadIdInput.value = form.querySelector('input[name="id"]')?.getAttribute("value") || "";

                // Set default date to tomorrow
                const tomorrow = new Date();
                tomorrow.setDate(tomorrow.getDate() + 1);
                dateInput.value = tomorrow.toISOString().split("T")[0];
                outcomeInput.value = "Connected - Interested";
                noteInput.value = "";
                if (errorDiv) {
                  errorDiv.innerText = "";
                  errorDiv.classList.add("hidden");
                }

                const updateWordCount = () => {
                  const text = noteInput.value.trim();
                  const words = text ? text.split(/\s+/).filter(Boolean).length : 0;
                  if (wordCountBadge) {
                    if (words >= 3) {
                      wordCountBadge.innerText = `${words} words (✓ Meets requirement)`;
                      wordCountBadge.className = "text-[10px] font-bold text-emerald-600 mt-1 text-right";
                    } else {
                      wordCountBadge.innerText = `${words} words (Minimum 3 words required)`;
                      wordCountBadge.className = "text-[10px] font-bold text-rose-500 mt-1 text-right";
                    }
                  }
                };

                noteInput.oninput = updateWordCount;
                updateWordCount();

                const closePrompt = () => {
                  promptModal.classList.add("hidden");
                  document.body.style.overflow = "";
                };

                if (closeBtn) closeBtn.onclick = closePrompt;
                if (cancelBtn) cancelBtn.onclick = closePrompt;

                promptModal.classList.remove("hidden");
                document.body.style.overflow = "hidden";

                promptForm.onsubmit = async (pe) => {
                  pe.preventDefault();
                  const dateVal = dateInput.value.trim();
                  const outcomeVal = outcomeInput.value.trim();
                  const noteVal = noteInput.value.trim();
                  const wordCount = noteVal ? noteVal.split(/\s+/).filter(Boolean).length : 0;

                  if (!dateVal) {
                    if (errorDiv) {
                      errorDiv.innerText = "Next follow-up date is required.";
                      errorDiv.classList.remove("hidden");
                    }
                    return;
                  }
                  if (!outcomeVal) {
                    if (errorDiv) {
                      errorDiv.innerText = "Call outcome selection is required.";
                      errorDiv.classList.remove("hidden");
                    }
                    return;
                  }
                  if (wordCount < 3) {
                    if (errorDiv) {
                      errorDiv.innerText = `Follow-up notes must contain at least 3 words (currently ${wordCount} word${wordCount === 1 ? '' : 's'}).`;
                      errorDiv.classList.remove("hidden");
                    }
                    return;
                  }

                  closePrompt();

                  // Update UI trigger text and colors
                  const spanText = trigger.querySelector("span");
                  if (spanText) {
                    spanText.textContent = item.textContent?.trim() || "Follow Up";
                  }
                  trigger.className = `status-dropdown-trigger flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-[10px] font-bold tracking-wide focus:outline-none transition-all duration-200 hover:brightness-95 cursor-pointer bg-violet-50 text-violet-700 border-violet-200`;

                  statusInput.value = "follow up";

                  const postData = new FormData(form);
                  postData.append("next_followup", dateVal);
                  postData.append("outcome", outcomeVal);
                  postData.append("note", noteVal);

                  try {
                    const res = await fetch(window.location.href, {
                      method: "POST",
                      body: postData
                    });
                    await handleResponse(res, "Follow-up status and note saved successfully.");
                  } catch (err) {
                    console.error("AJAX status update error:", err);
                  }
                };

                return;
              }
            }

            let reason = "";
            if (val === 'completed') {
              let promptMsg = "Please enter the completion reason / answer (Required):";
              let userInput = "";
              while (true) {
                const res = prompt(promptMsg);
                if (res === null) {
                  toggleMenu(dropdown, false);
                  return;
                }
                userInput = res.trim();
                if (userInput) {
                  reason = userInput;
                  break;
                }
                promptMsg = "Completion reason is REQUIRED. Please enter a reason / answer:";
              }
            }

            // Update UI trigger text and colors
            const spanText = trigger.querySelector("span");
            if (spanText) {
              spanText.textContent = item.textContent?.trim() || "";
            }
            trigger.className = `status-dropdown-trigger flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-[10px] font-bold tracking-wide focus:outline-none transition-all duration-200 hover:brightness-95 cursor-pointer ` +
              (val === 'completed' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
               val === 'not_available' ? 'bg-slate-100 text-slate-600 border-slate-200' :
               val === 'follow up' ? 'bg-violet-50 text-violet-700 border-violet-200' :
               'bg-amber-50 text-amber-700 border-amber-200');

            // Apply selected background to items
            items.forEach(btn => {
              const bVal = btn.getAttribute("data-value");
              btn.className = `flex w-full items-center justify-between rounded-lg px-2 py-1 text-[10px] font-bold text-left transition-colors cursor-pointer `;
              if (bVal === val) {
                btn.classList.add(
                  val === 'completed' ? 'bg-emerald-50' :
                  val === 'not_available' ? 'bg-slate-100' :
                  val === 'follow up' ? 'bg-violet-50' :
                  'bg-amber-50'
                );
                btn.classList.add(
                  val === 'completed' ? 'text-emerald-700' :
                  val === 'not_available' ? 'text-slate-700' :
                  val === 'follow up' ? 'text-violet-700' :
                  'text-amber-700'
                );
                // Ensure checkmark SVG is there
                if (!btn.querySelector("svg")) {
                  const checkSvg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
                  checkSvg.setAttribute("width", "10");
                  checkSvg.setAttribute("height", "10");
                  checkSvg.setAttribute("viewBox", "0 0 24 24");
                  checkSvg.setAttribute("fill", "none");
                  checkSvg.setAttribute("stroke", "currentColor");
                  checkSvg.setAttribute("stroke-width", "3");
                  checkSvg.setAttribute("stroke-linecap", "round");
                  checkSvg.setAttribute("stroke-linejoin", "round");
                  checkSvg.innerHTML = '<path d="M20 6 9 17l-5-5"/>';
                  btn.appendChild(checkSvg);
                }
              } else {
                btn.classList.add('text-slate-600', 'hover:bg-slate-50', 'hover:text-slate-900');
                const existingCheck = btn.querySelector("svg");
                if (existingCheck) btn.removeChild(existingCheck);
              }
            });

            statusInput.value = val;
            toggleMenu(dropdown, false);

            const formData = new FormData(form);
            if (val === 'completed' && reason) {
              formData.append("completion_reason", reason);
            }

            try {
              const res = await fetch(window.location.href, {
                method: "POST",
                body: formData
              });
              await handleResponse(res, "Lead status updated successfully.");
            } catch (err) {
              console.error("AJAX status update error:", err);
            }
          });
        });
      }
      if (form.classList.contains("delete-lead-form")) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const confirmed = await (window as any).showConfirmDialog({
            title: "Are you absolutely sure?",
            description: "This action cannot be undone. This will permanently delete this lead record.",
            actionText: "Delete",
            cancelText: "Cancel",
            variant: "destructive",
            from: "bottom"
          });
          if (!confirmed) return;

          const btn = form.querySelector('button[type="submit"]') as HTMLElement;
          (window as any).showBtnLoader?.(btn);

          const formData = new FormData(form);
          try {
            const res = await fetch(window.location.href, {
              method: "POST",
              body: formData
            });
            await handleResponse(res, "Lead removed successfully.");
          } catch (err) {
            console.error("AJAX delete lead error:", err);
          }
        });
      }
    });

    // Close dropdowns on clicking outside
    document.addEventListener("click", () => {
      document.querySelectorAll(".custom-dropdown").forEach(dropdown => {
        const menu = dropdown.querySelector(".dropdown-menu-content") as HTMLElement;
        dropdown.classList.remove("open");
        if (menu) {
          menu.classList.add("opacity-0", "scale-95", "translate-y-[-4px]", "pointer-events-none");
          menu.classList.remove("opacity-100", "scale-100", "translate-y-0", "pointer-events-auto");
        }
      });
    });

    // Mark leads as read on client
    const main = document.querySelector("main");
    if (main) {
      const total = main.getAttribute("data-total-leads") || "0";
      localStorage.setItem("lastViewedLeadsCount", total);

      // Hide notification badges immediately
      document.querySelectorAll(".leads-nav-badge").forEach(badge => {
        badge.classList.add("hidden");
      });
    }

    // Select All and Delete Selected Logic
    const selectAllCheckbox = document.getElementById("select-all-leads") as HTMLInputElement;
    const deleteSelectedBtn = document.getElementById("delete-selected-leads-btn") as HTMLButtonElement;
    const itemCheckboxes = document.querySelectorAll(".lead-checkbox") as NodeListOf<HTMLInputElement>;

    function updateDeleteButtonState() {
      if (!deleteSelectedBtn) return;
      const checkedCount = Array.from(itemCheckboxes).filter(cb => cb.checked).length;
      deleteSelectedBtn.disabled = checkedCount === 0;
      if (checkedCount > 0) {
        deleteSelectedBtn.innerText = `Delete Selected (${checkedCount})`;
      } else {
        deleteSelectedBtn.innerText = "Delete Selected";
      }
    }

    if (selectAllCheckbox) {
      selectAllCheckbox.addEventListener("change", () => {
        itemCheckboxes.forEach(cb => {
          cb.checked = selectAllCheckbox.checked;
        });
        updateDeleteButtonState();
      });
    }

    itemCheckboxes.forEach(cb => {
      cb.addEventListener("change", () => {
        if (selectAllCheckbox) {
          selectAllCheckbox.checked = Array.from(itemCheckboxes).every(c => c.checked);
        }
        updateDeleteButtonState();
      });
    });

    if (deleteSelectedBtn) {
      deleteSelectedBtn.addEventListener("click", async () => {
        const selectedIds = Array.from(itemCheckboxes)
          .filter(cb => cb.checked)
          .map(cb => cb.getAttribute("data-id"));

        if (selectedIds.length === 0) return;

        const confirmed = await (window as any).showConfirmDialog({
          title: "Delete Selected Leads?",
          description: `Are you sure you want to permanently delete these ${selectedIds.length} selected lead records? This action cannot be undone.`,
          actionText: "Delete All",
          cancelText: "Cancel",
          variant: "destructive",
          from: "bottom"
        });
        if (!confirmed) return;

        (window as any).showBtnLoader?.(deleteSelectedBtn, "Deleting...");

        const params = new URLSearchParams();
        params.append("action", "delete-multiple-leads");
        params.append("ids", selectedIds.join(","));

        try {
          const res = await fetch(window.location.href, {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: params
          });
          await handleResponse(res, `${selectedIds.length} leads removed successfully.`);
        } catch (err) {
          console.error("AJAX error:", err);
          alert("An error occurred. Please try again.");
        } finally {
          (window as any).hideBtnLoader?.(deleteSelectedBtn);
        }
      });
    }
  }

  // Bind handlers
  setupLeadsPage();
  document.addEventListener("astro:page-load", setupLeadsPage);
</script>

<style is:global>
  /* Custom animated dropdown styling */
  .custom-dropdown .dropdown-menu-content {
    opacity: 0;
    transform: scale(0.95) translateY(-4px);
    pointer-events: none;
    transition: opacity 0.2s cubic-bezier(0.16, 1, 0.3, 1), transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: top left;
  }
  .custom-dropdown.open .dropdown-menu-content {
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
  }
  .custom-dropdown.open .dropdown-arrow {
    transform: rotate(180deg);
  }
</style>
