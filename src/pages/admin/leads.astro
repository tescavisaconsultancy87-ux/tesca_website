                              </button>
                              <button type="button" class="btn-save-edit px-3 py-1 bg-violet-600 hover:bg-violet-700 text-white font-bold text-[11px] rounded-lg shadow transition-colors cursor-pointer flex items-center gap-1" data-note-id="${entryId}">
