                    });
                    const entryId = escapeHTML(String(entry.id));
                    return `
                      <div class="note-card-item p-3 bg-white border border-slate-200 rounded-2xl space-y-2 shadow-sm relative transition-all" data-note-id="${entryId}">
                        <div class="note-view-box space-y-1">
                          <div class="flex items-center justify-between text-[11px] gap-2">
                            <div class="flex items-center gap-1.5 flex-wrap">
                              <span class="px-2 py-0.5 rounded-md bg-violet-100 text-violet-800 font-bold">${escapeHTML(entry.outcome || "Call Logged")}</span>
                              <span class="text-slate-400 text-[10px] font-semibold">${dt}</span>
                              ${entry.edited_at ? `<span class="text-[9px] text-slate-400 font-medium italic bg-slate-100 px-1.5 py-0.5 rounded-md">(edited)</span>` : ''}
