---
import Layout from "../../layouts/Layout.astro";
import AdminHeader from "../../components/AdminHeader.astro";
import { checkAdminAuth } from "../../utils/adminAuth";
import { supabase } from "../../utils/supabase";
import { getEnv } from "../../utils/env";
// Inline SVG helpers — no lucide-react in .astro (SSR hook errors)
const _s = (d: string) => `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
const SVG = {
  Trash2: _s('<path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" x2="10" y1="11" y2="17"/><line x1="14" x2="14" y1="11" y2="17"/>'),
  Eye: _s('<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>'),
  Calendar: _s('<rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/>'),
  User: _s('<path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/>'),
  Phone: _s('<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.61 3.4a2 2 0 0 1 2-2.18h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>'),
  Mail: _s('<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>'),
  X: _s('<path d="M18 6 6 18"/><path d="m6 6 12 12"/>'),
};

// Check session
const isAuthenticated = await checkAdminAuth(Astro.cookies);
if (!isAuthenticated) {
  return Astro.redirect("/admin");
}

let leads = [];
let successMessage = "";
let errorMessage = "";

// Release a booked slot on Google Calendar when a lead is removed or its booking becomes inactive.
// Best-effort: never throws, so lead deletion always proceeds even if the calendar call fails.
async function releaseBookedSlot(leadId: number): Promise<void> {
  try {
    const { data: lead } = await supabase
      .from('leads')
      .select('status, details')
      .eq('id', leadId)
      .single();

    if (!lead || lead.status !== 'booked') return;

    let details: any = {};
    if (lead.details) {
      try {
        details = typeof lead.details === 'string' ? JSON.parse(lead.details) : lead.details;
      } catch (e) {
        details = {};
      }
    }

    const selectedDate = details.selectedDate;
    const selectedTime = details.selectedTime;
    if (!selectedDate || !selectedTime) return;

    const googleSheetUrl = getEnv('GOOGLE_SHEET_URL') || import.meta.env.GOOGLE_SHEET_URL;
    if (!googleSheetUrl) {
      console.warn("[admin-leads] GOOGLE_SHEET_URL not set — cannot release calendar slot for lead", leadId);
      return;
    }

    const params = new URLSearchParams({
      action: "cancelSlot",
      date: selectedDate,
      time: selectedTime,
      reason: "Booking released from admin panel"
    });

    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 8000);
    let res: Response;
    try {
      res = await fetch(`${googleSheetUrl}?${params.toString()}`, { signal: controller.signal });
    } finally {
      clearTimeout(timeout);
    }
    if (!res.ok) {
      console.warn(`[admin-leads] cancelSlot returned status ${res.status} for lead`, leadId);
      return;
    }
    const text = await res.text();
    let data: any;
    try {
      data = JSON.parse(text);
    } catch (e) {
      console.warn("[admin-leads] cancelSlot returned non-JSON response:", text.slice(0, 200));
      return;
    }
    if (!data.success) {
      console.warn("[admin-leads] cancelSlot failed:", data.error);
    }
  } catch (err) {
    console.warn("[admin-leads] Failed to release booked slot:", err);
  }
}

// Handle server actions (e.g. delete lead, update status)
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("action");

    if (action === "delete-lead") {
      const id = formData.get("id")?.toString() || "";
      const leadId = parseInt(id, 10);
      if (!isNaN(leadId)) {
        await releaseBookedSlot(leadId);
      }
      const { error } = await supabase
        .from('leads')
        .delete()
        .eq('id', id);

      if (error) throw error;
      successMessage = "Lead removed successfully.";
    } else if (action === "delete-multiple-leads") {
      const idsStr = formData.get("ids")?.toString() || "";
      const ids = idsStr.split(",").map(id => id.trim()).filter(id => id);
      
      if (ids.length > 0) {
        for (const rawId of ids) {
          const leadId = parseInt(rawId, 10);
          if (!isNaN(leadId)) {
            await releaseBookedSlot(leadId);
          }
        }
        const { error } = await supabase
          .from('leads')
          .delete()
          .in('id', ids);

        if (error) throw error;
        successMessage = `${ids.length} leads removed successfully.`;
      } else {
        errorMessage = "No leads selected for deletion.";
      }
    } else if (action === "update-status") {
      const id = formData.get("id")?.toString() || "";
      const status = formData.get("status")?.toString().trim();
      const allowedStatuses = new Set(["pending", "not_available", "follow up", "completed"]);
      if (!status || !allowedStatuses.has(status)) {
        throw new Error("Invalid lead status.");
      }
      const completionReason = formData.get("completion_reason")?.toString().trim();
      const nextFollowup = formData.get("next_followup")?.toString().trim();
      const outcome = formData.get("outcome")?.toString().trim() || "Connected - Interested";
      const noteText = formData.get("note")?.toString().trim();

      // Enforce date, outcome, and notes (at least 3 words) when status is follow up
      if (status === "follow up") {
        if (!nextFollowup) {
          throw new Error("Next follow-up date is required when status is set to Follow-Up.");
        }
        if (!outcome) {
          throw new Error("Call outcome selection is required when status is set to Follow-Up.");
        }
        const wordCount = noteText ? noteText.split(/\s+/).filter(w => w.length > 0).length : 0;
        if (wordCount < 3) {
          throw new Error("Follow-up notes must contain at least 3 words.");
        }
      }

      // If the lead is currently booked and its status is changing, release its calendar slot
      const leadId = parseInt(id, 10);
      if (!isNaN(leadId)) {
        await releaseBookedSlot(leadId);
      }
      
      if (status === "completed" && completionReason) {
        // Fetch current details JSON
        const { data: leadData } = await supabase
          .from('leads')
          .select('details')
          .eq('id', id)
          .single();

        let detailsObj: any = {};
        if (leadData && leadData.details) {
          try {
            detailsObj = typeof leadData.details === 'string' ? JSON.parse(leadData.details) : leadData.details;
          } catch (e) {
            console.error("Failed to parse existing lead details JSON:", e);
          }
        }
        
        // Append completion reason
        detailsObj.completionReason = completionReason;

        const { error } = await supabase
          .from('leads')
          .update({ 
            status,
            details: JSON.stringify(detailsObj)
          })
          .eq('id', id);

        if (error) throw error;
      } else if (status === "follow up") {
        const { data: leadData } = await supabase
          .from('leads')
          .select('details')
          .eq('id', id)
          .single();

        let detailsObj: any = {};
        if (leadData && leadData.details) {
          try {
            detailsObj = typeof leadData.details === 'string' ? JSON.parse(leadData.details) : leadData.details;
          } catch (e) {
            detailsObj = {};
          }
        }

        if (!Array.isArray(detailsObj.followup_history)) {
          detailsObj.followup_history = [];
        }

        const newEntry = {
          id: Date.now(),
          timestamp: new Date().toISOString(),
          note: noteText,
          outcome: outcome,
          next_followup: nextFollowup || null,
          author: "Counselor"
        };

        detailsObj.followup_history.unshift(newEntry);
        if (nextFollowup) {
          detailsObj.next_followup_date = nextFollowup;
        }

        const { error } = await supabase
          .from('leads')
          .update({ 
            status: 'follow up',
            details: JSON.stringify(detailsObj)
          })
          .eq('id', id);

        if (error) throw error;
      } else {
        // If changing status back to something else, remove completionReason
        const { data: leadData } = await supabase
          .from('leads')
          .select('details')
          .eq('id', id)
          .single();

        let detailsObj: any = null;
        if (leadData && leadData.details) {
          try {
            detailsObj = typeof leadData.details === 'string' ? JSON.parse(leadData.details) : leadData.details;
            if (detailsObj.completionReason) {
              delete detailsObj.completionReason;
            }
          } catch (e) {}
        }

        const { error } = await supabase
          .from('leads')
          .update({ 
            status,
            ...(detailsObj ? { details: JSON.stringify(detailsObj) } : {})
          })
          .eq('id', id);

        if (error) throw error;
      }

      successMessage = "Lead status updated successfully.";
    } else if (action === "add-followup-note") {
      const id = formData.get("id")?.toString() || "";
      const noteText = formData.get("note")?.toString().trim() || "";
      const outcome = formData.get("outcome")?.toString().trim() || "Connected - Interested";
      const nextFollowup = formData.get("next_followup")?.toString().trim() || "";

      if (!nextFollowup) {
        throw new Error("Next follow-up date is required.");
      }
      if (!outcome) {
        throw new Error("Call outcome selection is required.");
      }
      const wordCount = noteText ? noteText.split(/\s+/).filter(w => w.length > 0).length : 0;
      if (wordCount < 3) {
        throw new Error("Follow-up note must contain at least 3 words.");
      }

      const { data: leadData } = await supabase
        .from('leads')
        .select('details, status')
        .eq('id', id)
        .single();

      let detailsObj: any = {};
      if (leadData && leadData.details) {
        try {
          detailsObj = typeof leadData.details === 'string' ? JSON.parse(leadData.details) : leadData.details;
        } catch (e) {
          detailsObj = {};
        }
      }

      if (!Array.isArray(detailsObj.followup_history)) {
        detailsObj.followup_history = [];
      }

      const newEntry = {
        id: Date.now(),
        timestamp: new Date().toISOString(),
        note: noteText,
        outcome: outcome,
        next_followup: nextFollowup || null,
        author: "Counselor"
      };

      detailsObj.followup_history.unshift(newEntry);
      if (nextFollowup) {
        detailsObj.next_followup_date = nextFollowup;
      }

      const { error } = await supabase
        .from('leads')
        .update({
          status: 'follow up',
          details: JSON.stringify(detailsObj)
        })
        .eq('id', id);

      if (error) throw error;
      successMessage = "Follow-up note logged successfully.";
    } else if (action === "edit-followup-note") {
      const id = formData.get("id")?.toString() || "";
      const noteIdRaw = formData.get("note_id")?.toString() || "";
      const noteText = formData.get("note")?.toString().trim() || "";
      const outcome = formData.get("outcome")?.toString().trim() || "Connected - Interested";
      const nextFollowup = formData.get("next_followup")?.toString().trim() || "";

      if (!id || !noteIdRaw) {
        throw new Error("Invalid request parameters.");
      }
      if (!nextFollowup) {
        throw new Error("Next follow-up date is required.");
      }
      if (!outcome) {
        throw new Error("Call outcome selection is required.");
      }
      const wordCount = noteText ? noteText.split(/\s+/).filter(w => w.length > 0).length : 0;
      if (wordCount < 3) {
        throw new Error("Follow-up note must contain at least 3 words.");
      }

      const { data: leadData } = await supabase
        .from('leads')
        .select('details')
        .eq('id', id)
        .single();

      let detailsObj: any = {};
      if (leadData && leadData.details) {
        try {
          detailsObj = typeof leadData.details === 'string' ? JSON.parse(leadData.details) : leadData.details;
        } catch (e) {
          detailsObj = {};
        }
      }

      if (!Array.isArray(detailsObj.followup_history)) {
        detailsObj.followup_history = [];
      }

      const entryIndex = detailsObj.followup_history.findIndex(
        (item: any) => String(item.id) === String(noteIdRaw)
      );

      if (entryIndex === -1) {
        throw new Error("Follow-up note entry not found.");
      }

      detailsObj.followup_history[entryIndex] = {
        ...detailsObj.followup_history[entryIndex],
        note: noteText,
        outcome: outcome,
        next_followup: nextFollowup || null,
        edited_at: new Date().toISOString()
      };

      const firstWithNextDate = detailsObj.followup_history.find((item: any) => item.next_followup);
      if (firstWithNextDate) {
        detailsObj.next_followup_date = firstWithNextDate.next_followup;
      }

      const { error } = await supabase
        .from('leads')
        .update({
          details: JSON.stringify(detailsObj)
        })
        .eq('id', id);

      if (error) throw error;
      successMessage = "Follow-up note updated successfully.";
    } else if (action === "delete-followup-note") {
      const id = formData.get("id")?.toString() || "";
      const noteIdRaw = formData.get("note_id")?.toString() || "";

      if (!id || !noteIdRaw) {
        throw new Error("Invalid request parameters.");
      }

      const { data: leadData } = await supabase
        .from('leads')
        .select('details')
        .eq('id', id)
        .single();

      let detailsObj: any = {};
      if (leadData && leadData.details) {
        try {
          detailsObj = typeof leadData.details === 'string' ? JSON.parse(leadData.details) : leadData.details;
        } catch (e) {
          detailsObj = {};
        }
      }

      if (Array.isArray(detailsObj.followup_history)) {
        detailsObj.followup_history = detailsObj.followup_history.filter(
          (item: any) => String(item.id) !== String(noteIdRaw)
        );
      } else {
        detailsObj.followup_history = [];
      }

      const firstWithNextDate = detailsObj.followup_history.find((item: any) => item.next_followup);
      if (firstWithNextDate) {
        detailsObj.next_followup_date = firstWithNextDate.next_followup;
      } else {
        delete detailsObj.next_followup_date;
      }

      const { error } = await supabase
        .from('leads')
        .update({
          details: JSON.stringify(detailsObj)
        })
        .eq('id', id);

      if (error) throw error;
      successMessage = "Follow-up note deleted successfully.";
    }
  } catch (err: any) {
    console.error("Failed to process action:", err);
    errorMessage = `Failed to complete action: ${err.message || "Unknown error"}`;
  }
}

// Fetch leads
try {
  const { data, error } = await supabase
    .from('leads')
    .select('*')
    .neq('lead_type', 'partner')
    .order('created_at', { ascending: false });

  if (error) throw error;
  leads = data || [];
} catch (err) {
  console.error("Failed to load leads from Supabase:", err);
  errorMessage = "Failed to load database records.";
}
---

<Layout 
  title="Manage Student Leads | TESCA Admin"
  description="Administrative dashboard to view student visa and admissions inquiries."
  showNavFooter={false}
>
  <div class="min-h-screen bg-slate-50 text-slate-800 font-sans flex flex-col lg:flex-row">
    <AdminHeader activeTab="leads" />

    <main class="flex-1 px-4 md:px-8 py-10 overflow-y-auto text-left lg:ml-64" data-total-leads={leads.length}>
      
      {/* Title block */}
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
          <h1 class="text-3xl font-extrabold font-display tracking-tight text-slate-800">
            Student Leads
          </h1>
          <p class="text-slate-500 text-xs mt-1">Review student assessments, eligibility finder requests, and counselor forms.</p>
        </div>
        
        <div class="flex flex-wrap items-center gap-3">
          {/* Top Horizontal Table Slider */}
          <div id="table-slider-control-top" class="flex items-center gap-2 bg-white border border-slate-200 shadow-sm rounded-2xl px-3.5 py-2 text-xs">
            <span class="text-indigo-600 font-extrabold text-[11px] uppercase tracking-wider flex items-center gap-1.5 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8L22 12L18 16"/><path d="M6 8L2 12L6 16"/><path d="M2 12H22"/></svg>
              Scroll
            </span>
            <button
              type="button"
              id="slider-btn-left"
              title="Scroll Left"
              class="p-1 rounded-lg hover:bg-slate-100 text-slate-600 transition-colors cursor-pointer border border-slate-200 shrink-0"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <input
              type="range"
              id="table-slider-input"
              min="0"
              max="100"
              value="0"
              class="w-28 sm:w-40 h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600 focus:outline-none"
              title="Drag to scroll table horizontally"
            />
            <button
              type="button"
              id="slider-btn-right"
              title="Scroll Right"
              class="p-1 rounded-lg hover:bg-slate-100 text-slate-600 transition-colors cursor-pointer border border-slate-200 shrink-0"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>

          {leads.length > 0 && (
            <button
              type="button"
              id="delete-selected-leads-btn"
              disabled
              class="flex items-center justify-center gap-1.5 px-4 py-2 bg-rose-50 hover:bg-rose-100 disabled:opacity-50 disabled:hover:bg-rose-50 text-rose-600 font-bold text-xs rounded-xl transition-all cursor-pointer border border-rose-200 disabled:cursor-not-allowed uppercase tracking-wider shrink-0"
            >
              <span set:html={SVG.Trash2} class="w-3.5 h-3.5" />
              Delete Selected
            </button>
          )}
        </div>
      </div>

      {/* Messages */}
      {errorMessage && (
        <div class="admin-alert-banner p-4 bg-rose-50 border border-rose-200 rounded-2xl text-rose-600 text-xs font-semibold mb-6">
          {errorMessage}
        </div>
      )}
      {successMessage && (
        <div class="admin-alert-banner p-4 bg-emerald-50 border border-emerald-200 rounded-2xl text-emerald-600 text-xs font-semibold mb-6">
          {successMessage}
        </div>
      )}

      {/* Table */}
      {leads.length === 0 ? (
        <div class="bg-white border border-slate-200 rounded-3xl p-12 text-center">
          <p class="text-sm text-slate-500">No student leads found in the database.</p>
        </div>
      ) : (
        <div class="relative bg-white border border-slate-200 rounded-3xl overflow-hidden shadow-sm">
          <div id="leads-table-container" class="overflow-x-auto w-full min-h-[320px] scroll-smooth">
            <table class="w-full min-w-[900px] text-left border-collapse text-xs">
              <thead>
                <tr class="bg-slate-50 text-slate-500 border-b border-slate-200 font-bold uppercase tracking-wider">
                  <th class="px-6 py-4 w-[40px] text-center">
                    <input type="checkbox" id="select-all-leads" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" />
                  </th>
                  <th class="px-6 py-4 w-[160px]">Submitted At</th>
                  <th class="px-6 py-4 w-[140px]">Lead Type</th>
                  <th class="px-6 py-4 w-[160px]">Student Name</th>
                  <th class="px-6 py-4 w-[180px]">Contact Info</th>
                  <th class="px-6 py-4 w-[120px]">Status</th>
                  <th class="px-6 py-4 text-right w-[140px]">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {leads.map((lead) => {
                  let typeLabel = "Eligibility Finder";
                  let typeBg = "bg-teal-50 text-teal-700 border-teal-200";
                  if (lead.lead_type === "inquiry") {
                    typeLabel = "CRM Inquiry";
                    typeBg = "bg-indigo-50 text-indigo-700 border-indigo-200";
                  } else if (lead.lead_type === "counsellor") {
                    typeLabel = "Counselor Booking";
                    typeBg = "bg-amber-50 text-amber-700 border-amber-200";
                  } else if (lead.lead_type === "popup") {
                    typeLabel = "Popup Inquiry";
                    typeBg = "bg-purple-50 text-purple-700 border-purple-200";
                  }

                  const formattedDate = new Date(lead.created_at || Date.now()).toLocaleString("en-IN", {
                    timeZone: "Asia/Kolkata",
                    dateStyle: "medium",
                    timeStyle: "short"
                  });

                  return (
                    <tr class="hover:bg-slate-50 transition-colors">
                      <td class="px-6 py-4 w-[40px] text-center whitespace-nowrap">
                        <input type="checkbox" class="lead-checkbox rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" data-id={lead.id} />
                      </td>
                      <td class="px-6 py-4 text-slate-600 whitespace-nowrap">
                        <span class="flex items-center gap-1.5">
                          <span class="text-slate-400" set:html={SVG.Calendar} />
                          {formattedDate}
                        </span>
                      </td>
                      <td class="px-6 py-4 whitespace-nowrap">
                        <span class={`px-2.5 py-1 rounded-full border text-[10px] font-bold tracking-wide ${typeBg}`}>
                          {typeLabel}
                        </span>
                      </td>
                      <td class="px-6 py-4 font-bold text-slate-800 whitespace-nowrap">
                        <span class="flex items-center gap-1.5">
                          <span class="text-slate-400" set:html={SVG.User} />
                          {lead.name}
                        </span>
                        {(() => {
                          let historyCount = 0;
                          let nextFollowup = "";
                          if (lead.details) {
                            try {
                              const d = typeof lead.details === 'string' ? JSON.parse(lead.details) : lead.details;
                              if (Array.isArray(d.followup_history)) historyCount = d.followup_history.length;
                              if (d.next_followup_date) nextFollowup = d.next_followup_date;
                            } catch (e) {}
                          }
                          return (historyCount > 0 || nextFollowup) ? (
                            <div class="mt-1 flex flex-wrap items-center gap-1.5 font-normal text-[10px]">
                              {historyCount > 0 && (
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-violet-50 text-violet-700 font-bold border border-violet-200">
                                  💬 {historyCount} Note{historyCount > 1 ? 's' : ''}
                                </span>
                              )}
                              {nextFollowup && (
                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 font-bold border border-amber-200">
                                  ⏰ Next: {nextFollowup}
                                </span>
                              )}
                            </div>
                          ) : null;
                        })()}
                      </td>
                      <td class="px-6 py-4 space-y-1">
                        <div class="flex items-center gap-1.5 text-slate-600">
                          <span class="text-slate-400" set:html={SVG.Phone} />
                          <span>{lead.phone}</span>
                        </div>
                        {lead.email && (
                          <div class="flex items-center gap-1.5 text-slate-500">
                            <span class="text-slate-400" set:html={SVG.Mail} />
                            <span>{lead.email}</span>
                          </div>
                        )}
                      </td>
                      <td class="px-6 py-4">
                        <form method="POST" class="inline-block relative status-update-form">
                          <input type="hidden" name="action" value="update-status" />
                          <input type="hidden" name="id" value={lead.id} />
                          <input type="hidden" name="status" value={lead.status || "pending"} />
                          
                          <div class="relative inline-block text-left custom-dropdown">
                            <button
                              type="button"
                              class={`status-dropdown-trigger flex items-center gap-1.5 px-2.5 py-1 rounded-full border text-[10px] font-bold tracking-wide focus:outline-none transition-all duration-200 hover:brightness-95 cursor-pointer ` +
                                (lead.status === 'completed' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
                                 lead.status === 'not_available' ? 'bg-slate-100 text-slate-600 border-slate-200' :
                                 lead.status === 'follow up' ? 'bg-violet-50 text-violet-700 border-violet-200' :
                                 'bg-amber-50 text-amber-700 border-amber-200')}
                              aria-haspopup="true"
                              aria-expanded="false"
                            >
                              <span>
                                {lead.status === 'completed' ? 'Completed' :
                                 lead.status === 'not_available' ? 'Not Available' :
                                 lead.status === 'follow up' ? 'Follow Up' :
                                 'Pending'}
                              </span>
                              <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="transition-transform duration-200 dropdown-arrow"><path d="m6 9 6 6 6-6"/></svg>
                            </button>

                            <div 
                              class="dropdown-menu-content absolute left-0 mt-1.5 w-36 rounded-xl border border-slate-200 bg-white shadow-lg p-1 focus:outline-none opacity-0 scale-95 translate-y-[-4px] pointer-events-none transition-all duration-200 ease-out z-30"
                              role="menu"
                            >
                              <div class="text-[8px] font-bold text-slate-400 px-2 py-0.5 uppercase tracking-wider">Change Status</div>
                              <div class="space-y-0.5">
                                <button 
                                  type="button" 
                                  role="menuitem"
                                  data-value="pending"
                                  class={`flex w-full items-center justify-between rounded-lg px-2 py-1 text-[10px] font-bold text-left transition-colors cursor-pointer ` + 
                                    (lead.status === 'pending' || !lead.status ? 'bg-amber-50 text-amber-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900')}
                                >
                                  Pending
                                  {(lead.status === 'pending' || !lead.status) && <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>}
                                </button>

                                <button 
                                  type="button" 
                                  role="menuitem"
                                  data-value="not_available"
                                  class={`flex w-full items-center justify-between rounded-lg px-2 py-1 text-[10px] font-bold text-left transition-colors cursor-pointer ` + 
                                    (lead.status === 'not_available' ? 'bg-slate-100 text-slate-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900')}
                                >
                                  Not Available
                                  {lead.status === 'not_available' && <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>}
                                </button>

                                <button 
                                  type="button" 
                                  role="menuitem"
                                  data-value="follow up"
                                  class={`flex w-full items-center justify-between rounded-lg px-2 py-1 text-[10px] font-bold text-left transition-colors cursor-pointer ` + 
                                    (lead.status === 'follow up' ? 'bg-violet-50 text-violet-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900')}
                                >
                                  Follow Up
                                  {lead.status === 'follow up' && <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>}
                                </button>

                                <button 
                                  type="button" 
                                  role="menuitem"
                                  data-value="completed"
                                  class={`flex w-full items-center justify-between rounded-lg px-2 py-1 text-[10px] font-bold text-left transition-colors cursor-pointer ` + 
                                    (lead.status === 'completed' ? 'bg-emerald-50 text-emerald-700' : 'text-slate-600 hover:bg-slate-50 hover:text-slate-900')}
                                >
                                  Completed
                                  {lead.status === 'completed' && <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>}
                                </button>
                              </div>
                            </div>
                          </div>
                        </form>
                        {(() => {
                          let reason = "";
                          if (lead.status === 'completed' && lead.details) {
                            try {
                              const d = JSON.parse(lead.details);
                              reason = d.completionReason || "";
                            } catch (e) {}
                          }
                          return reason ? (
                            <div class="text-[10px] text-slate-400 mt-1 max-w-[150px] truncate italic block" title={reason}>
                              "{reason}"
                            </div>
                          ) : null;
                        })()}
                      </td>
                      <td class="px-6 py-4 text-right whitespace-nowrap space-x-1.5">
                        <button
                          type="button"
                          class="view-details-btn px-3 py-1.5 bg-white hover:bg-slate-50 text-slate-600 hover:text-slate-800 rounded-lg transition-all cursor-pointer font-bold inline-flex items-center gap-1 border border-slate-200"
                          data-id={lead.id}
                          data-details={lead.details}
                          data-name={lead.name}
                          data-phone={lead.phone}
                          data-email={lead.email}
                          data-type={typeLabel}
                          data-status={lead.status || "pending"}
                        >
                          <span set:html={SVG.Eye} /> View Details
                        </button>
                        <form method="POST" class="inline delete-lead-form">
                          <input type="hidden" name="action" value="delete-lead" />
                          <input type="hidden" name="id" value={lead.id} />
                          <button
                            type="submit"
                            class="p-2 text-rose-500 hover:bg-rose-50 rounded-lg hover:scale-105 transition-all cursor-pointer border border-transparent hover:border-rose-200"
                            aria-label="Delete lead"
                          >
                            <span set:html={SVG.Trash2} />
                          </button>
                        </form>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          {/* Sticky Bottom Floating Horizontal Scroll Slider Bar */}
          <div
            id="floating-scroll-bar"
            class="sticky bottom-4 right-4 z-40 float-right my-3 mr-4 bg-white/95 backdrop-blur-md shadow-2xl border border-slate-200/90 rounded-full px-4 py-2.5 flex items-center gap-3 text-xs font-semibold text-slate-700 transition-all duration-300 transform opacity-0 translate-y-2 pointer-events-none"
          >
            <span class="text-indigo-600 font-extrabold text-[11px] uppercase tracking-wider flex items-center gap-1.5 shrink-0">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8L22 12L18 16"/><path d="M6 8L2 12L6 16"/><path d="M2 12H22"/></svg>
              Scroll Right
            </span>
            <button
              type="button"
              id="sticky-btn-left"
              class="p-1 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors cursor-pointer border border-slate-200 shrink-0"
              title="Scroll Left"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            </button>
            <input
              type="range"
              id="sticky-slider-input"
              min="0"
              max="100"
              value="0"
              class="w-32 sm:w-48 h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-indigo-600 focus:outline-none"
              title="Drag right to view hidden columns"
            />
            <button
              type="button"
              id="sticky-btn-right"
              class="p-1 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors cursor-pointer border border-slate-200 shrink-0"
              title="Scroll Right"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
        </div>
      )}

    </main>

    {/* Lead Details Modal Overlay */}
    <div id="details-modal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="bg-white border border-slate-200 w-full max-w-2xl rounded-3xl shadow-xl overflow-hidden flex flex-col max-h-[85vh] text-left">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 bg-slate-50">
          <div>
            <h3 class="text-base font-extrabold text-slate-800" id="modal-title">Lead details</h3>
            <p class="text-[10px] text-indigo-600 font-bold uppercase tracking-wider mt-0.5" id="modal-subtitle">Type</p>
          </div>
          <button id="close-modal-btn" class="p-1.5 hover:bg-slate-100 text-slate-400 hover:text-slate-600 rounded-xl transition-colors cursor-pointer">
            <span set:html={SVG.X} />
          </button>
        </div>

        <div class="p-6 overflow-y-auto space-y-4 text-sm" id="modal-content-list">
          {/* Populated via client-side JavaScript */}
        </div>

        <div class="px-6 py-4 border-t border-slate-200 bg-slate-50/60 text-right">
          <button id="close-modal-footer-btn" class="px-5 py-2.5 bg-white hover:bg-slate-50 text-slate-600 hover:text-slate-800 rounded-xl transition-all cursor-pointer text-xs font-bold border border-slate-200">
            Close Details
          </button>
        </div>
      </div>
    </div>

    {/* Follow-Up Details Required Modal Overlay */}
    <div id="followup-prompt-modal" class="hidden fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-sm flex items-center justify-center p-4">
      <div class="bg-white border border-slate-200 w-full max-w-md rounded-3xl shadow-2xl overflow-hidden flex flex-col text-left transform transition-all">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-200 bg-violet-50/80">
          <div class="flex items-center gap-2">
            <span class="p-1.5 rounded-xl bg-violet-100 text-violet-700 font-bold text-sm">📅</span>
            <div>
              <h3 class="text-base font-extrabold text-slate-800">Set Follow-Up Details</h3>
              <p class="text-[10px] text-violet-600 font-bold uppercase tracking-wider">Required for Follow-Up Status</p>
            </div>
          </div>
          <button id="close-followup-prompt-btn" type="button" class="p-1.5 hover:bg-slate-200/60 text-slate-400 hover:text-slate-600 rounded-xl transition-colors cursor-pointer">
            <span set:html={SVG.X} />
          </button>
        </div>

        <form id="followup-prompt-form" class="p-6 space-y-4">
          <input type="hidden" id="followup-prompt-lead-id" value="" />

          <!-- Error Alert Banner -->
          <div id="followup-prompt-error" class="hidden p-3 bg-rose-50 border border-rose-200 rounded-xl text-rose-600 font-bold text-xs">
          </div>

          <!-- Date Input -->
          <div>
            <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-1">
              Next Follow-Up Date <span class="text-rose-500">*</span>
            </label>
            <input 
              type="date" 
              id="followup-prompt-date" 
              required 
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl p-3 font-semibold text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-500/20 focus:border-violet-500 transition-all cursor-pointer" 
            />
          </div>

          <!-- Outcome Select -->
          <div>
            <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-1">
              Call Outcome / Tag <span class="text-rose-500">*</span>
            </label>
            <select 
              id="followup-prompt-outcome" 
              required
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl p-3 font-bold text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-500/20 focus:border-violet-500 transition-all cursor-pointer"
            >
              <option value="Connected - Interested">📞 Connected - Interested</option>
              <option value="Sent Document Checklist">📄 Sent Document Checklist</option>
              <option value="Price Quoted">💰 Price / Quote Offered</option>
              <option value="Follow-up Scheduled">⏳ Follow-up Scheduled</option>
              <option value="No Answer / Busy">❌ No Answer / Busy</option>
              <option value="Not Interested / Dropped">🚫 Not Interested / Dropped</option>
            </select>
          </div>

          <!-- Notes Input -->
          <div>
            <label class="block text-xs font-extrabold text-slate-700 uppercase tracking-wider mb-1">
              Follow-Up Notes <span class="text-rose-500">*</span>
              <span class="text-[10px] font-semibold text-slate-400 normal-case ml-1">(Minimum 3 words)</span>
            </label>
            <textarea 
              id="followup-prompt-note" 
              required 
              rows="3" 
              placeholder="Enter discussion remarks (at least 3 words, e.g. 'Client requested fee structure and document checklist by tomorrow')..." 
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl p-3 font-medium text-slate-800 focus:bg-white focus:outline-none focus:ring-2 focus:ring-violet-500/20 focus:border-violet-500 transition-all"
            ></textarea>
            <div id="followup-word-count-badge" class="text-[10px] font-bold text-slate-400 mt-1 text-right">
              0 words (Minimum 3 words required)
            </div>
          </div>

          <div class="pt-2 flex items-center justify-end gap-2">
            <button 
              type="button" 
              id="cancel-followup-prompt-btn" 
              class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs font-bold transition-all cursor-pointer"
            >
              Cancel
            </button>
            <button 
              type="submit" 
              id="save-followup-prompt-btn" 
              class="px-5 py-2.5 bg-violet-600 hover:bg-violet-700 text-white rounded-xl text-xs font-bold shadow-md transition-all cursor-pointer flex items-center gap-1.5"
            >
              Save Follow-Up & Update Status
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>
</Layout>

<script>
  function setupModal() {
    const viewButtons = document.querySelectorAll(".view-details-btn");
    const modal = document.getElementById("details-modal");
    const modalTitle = document.getElementById("modal-title");
    const modalSubtitle = document.getElementById("modal-subtitle");
    const modalContent = document.getElementById("modal-content-list");
    const closeBtn = document.getElementById("close-modal-btn");
    const closeFooterBtn = document.getElementById("close-modal-footer-btn");

    const openModal = (btn: Element) => {
      const name = btn.getAttribute("data-name") || "Student Details";
      const phone = btn.getAttribute("data-phone") || "";
      const email = btn.getAttribute("data-email") || "";
      const type = btn.getAttribute("data-type") || "Lead";
      const status = btn.getAttribute("data-status") || "pending";
      const detailsRaw = btn.getAttribute("data-details") || "{}";

      const escapeHTML = (str: string) => {
        const div = document.createElement("div");
        div.textContent = str;
        return div.innerHTML;
      };

      if (modalTitle) modalTitle.innerText = name;
      if (modalSubtitle) modalSubtitle.innerText = type;

      if (modalContent) {
        modalContent.innerHTML = "";
        try {
          const leadId = btn.getAttribute("data-id") || "";
          const details = JSON.parse(detailsRaw);
          
          // Map properties to a premium list key/value pair
          const listContainer = document.createElement("div");
          listContainer.className = "grid grid-cols-1 sm:grid-cols-2 gap-4";

          // Lead Status Item
          const statusItem = document.createElement("div");
          statusItem.className = "bg-slate-50 border border-slate-200 p-3.5 rounded-2xl space-y-1 col-span-1 sm:col-span-2";
          statusItem.innerHTML = `
            <span class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider">Lead Status</span>
            <span class="inline-block px-2.5 py-1 rounded-full border text-[10px] font-bold tracking-wide ${
              status === 'completed' ? 'bg-emerald-50 text-emerald-700 border-emerald-200' :
              status === 'not_available' ? 'bg-slate-100 text-slate-600 border-slate-200' :
              status === 'follow up' ? 'bg-violet-50 text-violet-700 border-violet-200' :
              'bg-amber-50 text-amber-700 border-amber-200'
            }">${escapeHTML(status === 'not_available' ? 'Not Available' : status.charAt(0).toUpperCase() + status.slice(1))}</span>
          `;
          listContainer.appendChild(statusItem);

          // Mobile / WhatsApp Number Item
          const phoneVal = phone || details.phone || details.mobile || details.mobileNumber || "Not provided";
          const phoneItem = document.createElement("div");
          phoneItem.className = "bg-slate-50 border border-slate-200 p-3.5 rounded-2xl space-y-1";
          phoneItem.innerHTML = `
            <span class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider">Mobile / WhatsApp No.</span>
            <span class="block text-xs font-bold text-slate-800 font-mono">${escapeHTML(phoneVal)}</span>
          `;
          listContainer.appendChild(phoneItem);

          // Email Address Item
          const emailVal = email || details.email || "Not provided";
          const emailItem = document.createElement("div");
          emailItem.className = "bg-slate-50 border border-slate-200 p-3.5 rounded-2xl space-y-1";
          emailItem.innerHTML = `
            <span class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider">Email Address</span>
            <span class="block text-xs font-semibold text-slate-800">${escapeHTML(emailVal)}</span>
          `;
          listContainer.appendChild(emailItem);

          Object.entries(details).forEach(([key, val]) => {
            if (
              key === "bookingTokenHash" || 
              key === "bookingTokenUsedAt" || 
              key === "followup_history" || 
              key === "next_followup_date" ||
              key === "name" ||
              key === "fullName" ||
              key === "full_name" ||
              key === "phone" ||
              key === "mobile" ||
              key === "mobileNumber" ||
              key === "email"
            ) return;
            // Format keys beautifully
            const formattedKey = key
              .replace(/([A-Z])/g, " $1")
              .replace(/_/g, " ")
              .replace(/^\w/, c => c.toUpperCase());

            let formattedVal = "";
            if (Array.isArray(val)) {
              formattedVal = val.join(", ");
            } else if (typeof val === "object" && val !== null) {
              formattedVal = JSON.stringify(val);
            } else {
              formattedVal = String(val);
            }

            if (!formattedVal.trim() || formattedVal === "null" || formattedVal === "undefined") {
              formattedVal = "Not provided";
            }

            const item = document.createElement("div");
            item.className = "bg-slate-50 border border-slate-200 p-3.5 rounded-2xl space-y-1";
            item.innerHTML = `
              <span class="block text-[10px] font-bold text-slate-500 uppercase tracking-wider">${escapeHTML(formattedKey)}</span>
              <span class="block text-xs font-semibold text-slate-700 leading-normal">${escapeHTML(formattedVal)}</span>
            `;
            listContainer.appendChild(item);
          });

          // Add Follow-Up Note & Call Log Section
          const followupSection = document.createElement("div");
          followupSection.className = "col-span-1 sm:col-span-2 border-t border-slate-200 pt-5 mt-2 space-y-4";
          
          const historyList = Array.isArray(details.followup_history) ? details.followup_history : [];

          followupSection.innerHTML = `
            <div class="bg-violet-50/80 border border-violet-200 p-4 rounded-2xl space-y-3 text-left">
              <h4 class="text-xs font-extrabold uppercase tracking-wider text-violet-800 flex items-center gap-1.5">
                <span>📝 Log Call Discussion / Follow-Up Note</span>
              </h4>
              <form method="POST" class="space-y-3">
                <input type="hidden" name="action" value="add-followup-note" />
                <input type="hidden" name="id" value="${escapeHTML(leadId)}" />

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label class="block text-[10px] font-bold text-slate-700 uppercase mb-1">Call Outcome / Tag</label>
                    <div class="relative custom-outcome-dropdown">
                      <input type="hidden" name="outcome" id="outcome-hidden-input" value="Connected - Interested" />
                      
                      <button 
                        type="button" 
                        id="outcome-dropdown-btn" 
                        class="w-full text-xs bg-white border border-slate-200 hover:border-violet-400 rounded-xl p-2.5 font-bold text-slate-800 flex items-center justify-between transition-all cursor-pointer shadow-sm hover:shadow focus:outline-none focus:ring-2 focus:ring-violet-500/20"
                      >
                        <span id="outcome-selected-label" class="flex items-center gap-2 font-bold text-slate-800">
                          📞 Connected - Interested
                        </span>
                        <svg class="w-4 h-4 text-slate-400 transition-transform duration-200" id="outcome-chevron" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
                      </button>

                      <div 
                        id="outcome-dropdown-menu" 
                        class="hidden absolute left-0 right-0 top-full mt-1.5 z-50 bg-white/98 backdrop-blur-xl border border-slate-200 rounded-2xl shadow-2xl p-1.5 space-y-1 transition-all duration-200 transform scale-95 opacity-0 origin-top"
                      >
                        <button type="button" data-val="Connected - Interested" class="outcome-option-item w-full text-left px-3 py-2 rounded-xl text-xs font-bold transition-all flex items-center justify-between cursor-pointer bg-violet-50 text-violet-700">
                          <span>📞 Connected - Interested</span>
                          <svg class="w-3.5 h-3.5 text-violet-600 font-bold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
                        </button>
                        <button type="button" data-val="Sent Document Checklist" class="outcome-option-item w-full text-left px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-all flex items-center justify-between cursor-pointer">
                          <span>📄 Sent Document Checklist</span>
                        </button>
                        <button type="button" data-val="Price Quoted" class="outcome-option-item w-full text-left px-3 py-2 rounded-xl text-xs font-semibold text-slate-700 hover:bg-violet-50 hover:text-violet-700 transition-all flex items-center justify-between cursor-pointer">
                          <span>💰 Price / Quote Offered</span>
                        </button>
