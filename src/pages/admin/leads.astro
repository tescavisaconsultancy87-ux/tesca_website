                                <option value="Sent Document Checklist" ${entry.outcome === "Sent Document Checklist" ? "selected" : ""}>📄 Sent Document Checklist</option>
                                <option value="Price Quoted" ${entry.outcome === "Price Quoted" ? "selected" : ""}>💰 Price / Quote Offered</option>
                                <option value="Follow-up Scheduled" ${entry.outcome === "Follow-up Scheduled" ? "selected" : ""}>⏳ Follow-up Scheduled</option>
                                <option value="No Answer / Busy" ${entry.outcome === "No Answer / Busy" ? "selected" : ""}>❌ No Answer / Busy</option>
