---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Contact Us | TESCA Visa Consultancy"
  description="Have a question, bug report, or feedback? Reach out to TESCA Visa Consultancy — we'll respond within 24 hours."
>
  <section class="max-w-7xl mx-auto px-6 md:px-8 pt-8 pb-20 text-left">

    <!-- Back Link -->
    <a href="/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-blue hover:underline mb-8 font-sans">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Back to Home
    </a>

    <!-- Header -->
    <div class="glass-card rounded-[2rem] overflow-hidden bg-slate-50/80 border border-slate-200/60 shadow-lg p-8 md:p-12 relative mb-12">
      <div class="aurora-bg w-[300px] h-[300px] bg-accent-blue/5 -top-12 -left-12 rounded-full blur-[80px]"></div>

      <div class="max-w-3xl space-y-4 relative z-10">
        <span class="inline-block text-xs font-semibold tracking-wider text-slate-800 bg-accent-blue/10 px-4 py-1.5 rounded-full border border-accent-blue/20 font-sans uppercase">
          Get In Touch
        </span>
        <h1 class="text-4xl md:text-5xl font-black font-display text-slate-900 leading-tight">
          We'd Love to Hear From You
        </h1>
        <p class="text-base md:text-lg text-slate-600 font-sans leading-relaxed max-w-2xl">
          Whether you have a question, found a bug, or want to report an error — fill in the form and our team will get back to you within 24 hours.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <!-- Contact Info Cards -->
      <div class="space-y-6">
        <!-- WhatsApp Primary CTA Card -->
        <div class="glass-card rounded-2xl bg-gradient-to-br from-emerald-500/10 via-emerald-500/5 to-teal-500/10 border border-emerald-500/30 shadow-lg p-6 relative overflow-hidden group hover:border-emerald-500/50 transition-all duration-300">
          <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-emerald-500/10 rounded-full blur-xl group-hover:scale-150 transition-transform duration-500"></div>
          
          <div class="flex items-center justify-between mb-4">
            <div class="w-12 h-12 rounded-xl bg-emerald-500/20 flex items-center justify-center text-emerald-600 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-emerald-500/15 text-emerald-700 border border-emerald-500/20 font-sans">
              <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
              Fastest Reply
            </span>
          </div>

          <h3 class="text-base font-bold text-slate-900 mb-1 font-display">Instant WhatsApp Support</h3>
          <p class="text-xs text-slate-600 font-sans mb-5 leading-relaxed">
            Get quick answers directly from our visa experts on WhatsApp.
          </p>

          <a 
            href="https://wa.me/919824152731" 
            target="_blank" 
            rel="noopener noreferrer" 
            id="track-whatsapp-click"
            class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold text-sm rounded-xl transition-all duration-200 font-sans shadow-md shadow-emerald-600/20 hover:shadow-emerald-600/30 group-hover:translate-y-[-1px]"
          >
            <span>Chat on WhatsApp</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Email Contact Card -->
        <div class="glass-card rounded-2xl bg-slate-50/80 border border-slate-200/60 shadow-md p-6 hover:border-slate-300 transition-all duration-200">
          <div class="w-12 h-12 rounded-xl bg-accent-blue/10 flex items-center justify-center mb-4 text-[#0F4C81]">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-1 font-sans">Email Address</h3>
          <a 
            href="mailto:tescavisaconsultancy87@gmail.com" 
            id="track-email-click"
            class="text-sm text-slate-900 hover:text-accent-blue font-semibold font-sans transition-colors break-all flex items-center gap-1 group"
          >
            <span>tescavisaconsultancy87@gmail.com</span>
          </a>
        </div>

        <!-- Phone Contact Card -->
        <div class="glass-card rounded-2xl bg-slate-50/80 border border-slate-200/60 shadow-md p-6 hover:border-slate-300 transition-all duration-200">
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 flex items-center justify-center mb-4 text-amber-600">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-500 mb-1 font-sans">Direct Helpline</h3>
          <a 
            href="tel:+919824152731" 
            id="track-phone-click"
            class="text-sm text-slate-900 hover:text-accent-blue font-semibold font-sans transition-colors inline-block"
          >
            +91 98241 52731
          </a>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="lg:col-span-2">
        <div class="glass-card rounded-[2rem] bg-white/90 border border-slate-200/60 shadow-xl p-8 md:p-10" id="contact-form-section">
          <h2 class="text-2xl font-extrabold font-display text-slate-900 mb-2">Send Us a Message</h2>
          <p class="text-sm text-slate-500 font-sans mb-8">All fields marked with * are required.</p>

          <form id="contact-form" class="space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <label for="cf-name" class="text-xs font-bold uppercase tracking-wider text-slate-600 font-sans block mb-1.5">Full Name *</label>
                <input id="cf-name" name="name" type="text" required
                  placeholder="John Doe"
                  class="w-full px-4 py-3 bg-white border border-slate-200 focus:border-[#0F4C81] focus:ring-2 focus:ring-[#0F4C81]/15 rounded-xl text-sm placeholder-slate-400 focus:outline-none transition-all font-sans"
                />
              </div>
              <div>
                <label for="cf-email" class="text-xs font-bold uppercase tracking-wider text-slate-600 font-sans block mb-1.5">Email *</label>
                <input id="cf-email" name="email" type="email" required
                  placeholder="john@email.com"
                  class="w-full px-4 py-3 bg-white border border-slate-200 focus:border-[#0F4C81] focus:ring-2 focus:ring-[#0F4C81]/15 rounded-xl text-sm placeholder-slate-400 focus:outline-none transition-all font-sans"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="cf-phone" class="text-xs font-bold uppercase tracking-wider text-slate-600 font-sans block">Phone (optional)</label>
                  <span id="cf-phone-counter" class="text-[10px] font-bold text-amber-600 font-mono">0/10 digits</span>
                </div>
                <input id="cf-phone" name="phone" type="tel" maxlength={10}
                  placeholder="e.g. 9824152731"
                  class="w-full px-4 py-3 bg-white border border-slate-200 focus:border-[#0F4C81] focus:ring-2 focus:ring-[#0F4C81]/15 rounded-xl text-sm placeholder-slate-400 focus:outline-none transition-all font-mono"
                />
              </div>
              <div>
                <label for="cf-category" class="text-xs font-bold uppercase tracking-wider text-slate-600 font-sans block mb-1.5">Category *</label>
                <select id="cf-category" name="category" required
                  class="w-full px-4 py-3 bg-white border border-slate-200 focus:border-[#0F4C81] focus:ring-2 focus:ring-[#0F4C81]/15 rounded-xl text-sm focus:outline-none transition-all font-sans text-slate-700"
                >
                  <option value="general">General Contact</option>
                  <option value="bug">🐛 Report a Bug</option>
                  <option value="error">⚠️ Report an Error</option>
                </select>
              </div>
            </div>

            <div>
              <label for="cf-subject" class="text-xs font-bold uppercase tracking-wider text-slate-600 font-sans block mb-1.5">Subject *</label>
              <input id="cf-subject" name="subject" type="text" required
                placeholder="How can we help you?"
                class="w-full px-4 py-3 bg-white border border-slate-200 focus:border-[#0F4C81] focus:ring-2 focus:ring-[#0F4C81]/15 rounded-xl text-sm placeholder-slate-400 focus:outline-none transition-all font-sans"
              />
            </div>

            <div>
              <label for="cf-message" class="text-xs font-bold uppercase tracking-wider text-slate-600 font-sans block mb-1.5">Message *</label>
              <textarea id="cf-message" name="message" required rows="6"
                placeholder="Describe your question, bug, or issue in detail..."
                class="w-full px-4 py-3 bg-white border border-slate-200 focus:border-[#0F4C81] focus:ring-2 focus:ring-[#0F4C81]/15 rounded-xl text-sm placeholder-slate-400 focus:outline-none transition-all font-sans resize-y"
              ></textarea>
            </div>

            <button type="submit" id="cf-submit"
              class="w-full py-3.5 px-6 bg-[#0F4C81] hover:bg-[#0a3a63] text-white font-bold text-sm rounded-xl transition-all duration-200 font-sans tracking-wide shadow-lg shadow-[#0F4C81]/20 hover:shadow-[#0F4C81]/30 active:scale-[0.98]"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("cf-submit") as HTMLButtonElement | null;
  const whatsappBtn = document.getElementById("track-whatsapp-click");
  const emailBtn = document.getElementById("track-email-click");
  const phoneBtn = document.getElementById("track-phone-click");
  const phoneInput = document.getElementById("cf-phone") as HTMLInputElement | null;
  const phoneCounter = document.getElementById("cf-phone-counter");

  if (phoneInput && phoneCounter) {
    phoneInput.addEventListener("input", () => {
      const digits = phoneInput.value.replace(/\D/g, "").slice(0, 10);
      phoneInput.value = digits;
      if (digits.length === 10) {
        phoneCounter.textContent = "10/10 digits ✓";
        phoneCounter.className = "text-[10px] font-bold text-emerald-600 font-mono";
      } else {
        phoneCounter.textContent = `${digits.length}/10 digits`;
        phoneCounter.className = "text-[10px] font-bold text-amber-600 font-mono";
      }
    });
  }

  // Helper for safe PostHog capture
  const captureEvent = (eventName: string, properties: Record<string, any> = {}) => {
    if (typeof window !== "undefined" && (window as any).posthog) {
      (window as any).posthog.capture(eventName, properties);
    }
  };

  // Track direct channel clicks
  whatsappBtn?.addEventListener("click", () => captureEvent("contact_whatsapp_clicked"));
  emailBtn?.addEventListener("click", () => captureEvent("contact_email_clicked"));
  phoneBtn?.addEventListener("click", () => captureEvent("contact_phone_clicked"));

  // Track form initiation
  let formStartTracked = false;
  form?.addEventListener("focusin", () => {
    if (!formStartTracked) {
      formStartTracked = true;
      captureEvent("contact_form_started");
    }
  });

  if (form && submitBtn) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const name = (document.getElementById("cf-name") as HTMLInputElement).value.trim();
      const email = (document.getElementById("cf-email") as HTMLInputElement).value.trim();
      const phoneRaw = (document.getElementById("cf-phone") as HTMLInputElement).value.trim();
      const phone = phoneRaw ? phoneRaw.replace(/\D/g, "") : "";
      if (phoneRaw && phone.length !== 10) {
        if (typeof window !== "undefined" && (window as any).showToast) {
          (window as any).showToast("Please enter a valid 10-digit phone number.", "warning");
        }
        return;
      }
      const category = (document.getElementById("cf-category") as HTMLSelectElement).value;
      const subject = (document.getElementById("cf-subject") as HTMLInputElement).value.trim();
      const message = (document.getElementById("cf-message") as HTMLTextAreaElement).value.trim();

      if (!name || !email || !subject || !message) {
        if (typeof window !== "undefined" && (window as any).showToast) {
          (window as any).showToast("Please fill in all required fields.", "warning");
        }
        captureEvent("contact_form_validation_failed");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Sending...";

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ name, email, phone, category, subject, message }),
        });

        const data = await res.json();

        if (data.success) {
          captureEvent("contact_form_submitted", { category, hasPhone: Boolean(phone) });

          if (typeof window !== "undefined" && (window as any).showToast) {
            (window as any).showToast("Message sent! We'll get back to you within 24 hours.", "success");
          }
          form.reset();
          formStartTracked = false;
        } else {
          captureEvent("contact_form_error", { error: data.error });

          if (typeof window !== "undefined" && (window as any).showToast) {
            (window as any).showToast(data.error || "Something went wrong. Please try again.", "error");
          }
        }
      } catch (error: any) {
        captureEvent("contact_form_network_error", { message: error?.message });

        if (typeof window !== "undefined" && (window as any).showToast) {
          (window as any).showToast("Network error. Please try again or WhatsApp us.", "error");
        }
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Send Message";
      }
    });
  }
</script>
