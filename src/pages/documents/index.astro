---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import AICounsellor from "../../components/AICounsellor";
import { documents } from "../../data/documents";

const categories = Array.from(new Set(documents.map((d) => d.category)));
---

<Layout 
  title="Shared Resources & PDF Documents Hub | TESCA Consultancy"
  description="Access, preview, and download official TESCA study abroad checklists, IELTS speaking cue cards, vocabulary sheets, and visa preparation documents."
  showNavFooter={false}
>
  <main class="min-h-screen bg-slate-50/50 pb-20">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      
      <!-- Go Back Link -->
      <a href="/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-blue hover:underline mb-8 font-sans">
        ← Back to Home
      </a>

      <!-- Header Card Banner -->
      <div class="rounded-3xl bg-slate-900 text-white p-8 md:p-12 relative overflow-hidden mb-12 shadow-xl border border-slate-800">
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-600/20 rounded-full blur-[100px] pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-indigo-600/20 rounded-full blur-[90px] pointer-events-none"></div>

        <div class="relative z-10 max-w-3xl space-y-4">
          <span class="inline-block text-xs font-semibold tracking-wider text-blue-300 bg-blue-500/20 px-4 py-1.5 rounded-full border border-blue-400/30 font-sans uppercase">
            Official Document & PDF Center
          </span>
          <h1 class="text-3xl sm:text-5xl font-extrabold font-display text-white tracking-tight leading-tight">
            Shareable Guides & Resources
          </h1>
          <p class="text-base sm:text-lg text-slate-300 font-sans font-normal leading-relaxed">
            Browse our curated library of IELTS preparation handbooks, visa checklists, and study abroad guides. Click any document to view, download, or share directly via WhatsApp.
          </p>
        </div>
      </div>

      <!-- Categories & Filter Stats Bar -->
      <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
        <div class="flex flex-wrap gap-2">
          <span class="px-4 py-2 rounded-xl text-xs font-bold bg-blue-600 text-white shadow-sm">
            All Documents ({documents.length})
          </span>
          {categories.map((cat) => (
            <span class="px-4 py-2 rounded-xl text-xs font-medium bg-white text-slate-600 border border-slate-200 shadow-xs">
              {cat}
            </span>
          ))}
        </div>

        <p class="text-xs text-slate-500 font-sans">
          💡 Select any document to open its dedicated shareable page link.
        </p>
      </div>

      <!-- Document Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
        {documents.length === 0 ? (
          <div class="col-span-full bg-white rounded-3xl border border-slate-200/80 p-12 text-center space-y-4 shadow-sm">
            <div class="w-16 h-16 rounded-2xl bg-blue-50 text-blue-600 mx-auto flex items-center justify-center text-3xl">
              📂
            </div>
            <h3 class="text-xl font-bold text-slate-900 font-display">No Documents Available</h3>
            <p class="text-sm text-slate-500 font-sans max-w-md mx-auto leading-relaxed">
              There are currently no shareable documents available. Please check back later or contact our team for assistance.
            </p>
            <div class="pt-2">
              <a href="/inquiry" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-md transition-all">
                Contact Counsellor →
              </a>
            </div>
          </div>
        ) : (
          documents.map((doc) => {
            const shareUrl = `https://tescavisa.com/documents/${doc.slug}`;
            const whatsappMsg = encodeURIComponent(`📄 Check out this resource from TESCA: "${doc.title}"\n${shareUrl}`);
            
            return (
              <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between overflow-hidden group">
                <div class="p-6 space-y-4">
                  
                  <!-- Category Badge & File Info -->
                  <div class="flex items-center justify-between gap-2">
                    <span class="px-3 py-1 rounded-md text-[11px] font-bold uppercase tracking-wider bg-blue-50 text-blue-700 border border-blue-100 font-sans">
                      {doc.category}
                    </span>
                    {doc.fileSize && (
                      <span class="text-xs text-slate-400 font-mono">
                        {doc.fileSize}
                      </span>
                    )}
                  </div>

                  <!-- Document Title -->
                  <a href={`/documents/${doc.slug}`} class="block group-hover:text-blue-600 transition-colors">
                    <h3 class="text-lg font-bold text-slate-900 font-display leading-snug line-clamp-2">
                      {doc.title}
                    </h3>
                  </a>

                  <!-- Description -->
                  <p class="text-xs text-slate-600 font-sans leading-relaxed line-clamp-3">
                    {doc.description}
                  </p>

                  <!-- Tags -->
                  {doc.tags && doc.tags.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 pt-1">
                      {doc.tags.slice(0, 3).map((tag) => (
                        <span class="text-[10px] font-medium text-slate-500 bg-slate-100 px-2 py-0.5 rounded">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </div>

                <!-- Card Action Footer -->
                <div class="p-4 bg-slate-50 border-t border-slate-100 flex items-center justify-between gap-2">
                  <a 
                    href={`/documents/${doc.slug}`}
                    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs shadow-xs transition-all"
                  >
                    View & Share →
                  </a>

                  <div class="flex items-center gap-1">
                    <!-- Direct Download Icon Button -->
                    <a 
                      href={doc.pdfUrl} 
                      download 
                      title="Download PDF" 
                      class="p-2 rounded-lg bg-white border border-slate-200 text-slate-600 hover:text-blue-600 hover:border-blue-300 transition-all"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                      </svg>
                    </a>

                    <!-- WhatsApp Share Icon Button -->
                    <a 
                      href={`https://wa.me/?text=${whatsappMsg}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      title="Share via WhatsApp" 
                      class="p-2 rounded-lg bg-emerald-50 text-emerald-700 border border-emerald-200 hover:bg-emerald-600 hover:text-white transition-all"
                    >
                      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                      </svg>
                    </a>
                  </div>
                </div>

              </div>
            );
          })
        )}
      </div>

    </section>
  </main>

  <AICounsellor client:only="react" />
</Layout>
