---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import AICounsellor from "../../components/AICounsellor";
import { documents, getDocumentBySlug } from "../../data/documents";

export function getStaticPaths() {
  return documents.map((doc) => ({
    params: { slug: doc.slug },
    props: { doc },
  }));
}

const { slug } = Astro.params;
const doc = Astro.props.doc || getDocumentBySlug(slug as string);

if (!doc) {
  return Astro.redirect("/documents");
}

const pageTitle = `${doc.title} | TESCA Document Center`;
const pageDescription = doc.description;
const canonicalUrl = `https://tescavisa.com/documents/${doc.slug}`;
const shareWhatsappText = encodeURIComponent(
  `📄 Check out this resource from TESCA Visa Consultancy: "${doc.title}"\n\nRead & Download here: ${canonicalUrl}`
);
const otherDocs = documents.filter((d) => d.slug !== doc.slug).slice(0, 3);
---

<Layout title={pageTitle} description={pageDescription}>
  <!-- OpenGraph and Twitter Share Metadata -->
  <Fragment slot="head">
    <meta property="og:title" content={doc.title} />
    <meta property="og:description" content={doc.description} />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="TESCA Visa & Study Abroad Consultancy" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={doc.title} />
    <meta name="twitter:description" content={doc.description} />
  </Fragment>

  <main class="min-h-screen bg-gradient-to-b from-slate-50 via-white to-slate-100/60 pb-20">
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      
      <!-- Back Navigation & Breadcrumb -->
      <div class="flex items-center justify-between gap-4 mb-6">
        <a 
          href="/documents" 
          class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-slate-600 hover:text-accent-blue transition-colors group"
        >
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Back to Resource Hub
        </a>

        <span class="text-xs font-medium text-slate-400 font-mono hidden sm:inline-block">
          DOC ID: {doc.id}
        </span>
      </div>

      <!-- Main Document Header Card -->
      <div class="rounded-3xl bg-slate-900 text-white p-6 sm:p-10 shadow-2xl relative overflow-hidden mb-8 border border-slate-800">
        <!-- Background Decorative Auroras -->
        <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-600/20 rounded-full blur-[100px] pointer-events-none"></div>
        <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-indigo-600/20 rounded-full blur-[90px] pointer-events-none"></div>

        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <div class="lg:col-span-8 space-y-4">
            <div class="flex flex-wrap items-center gap-2 sm:gap-3">
              <span class="px-3.5 py-1 rounded-full text-xs font-bold tracking-wider bg-blue-500/20 text-blue-300 border border-blue-400/30 uppercase">
                {doc.category}
              </span>
              {doc.fileSize && (
                <span class="px-3 py-1 rounded-full text-xs font-medium bg-slate-800 text-slate-300 border border-slate-700">
                  📁 {doc.fileSize}
                </span>
              )}
              <span class="px-3 py-1 rounded-full text-xs font-medium bg-slate-800 text-slate-300 border border-slate-700">
                🕒 Updated {doc.updatedAt}
              </span>
            </div>

            <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight font-display leading-tight text-white">
              {doc.title}
            </h1>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed max-w-3xl font-sans">
              {doc.description}
            </p>

            {doc.tags && doc.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 pt-2">
                {doc.tags.map((tag) => (
                  <span class="text-xs font-medium text-slate-400 bg-slate-800/80 px-2.5 py-1 rounded-md border border-slate-700/60">
                    #{tag}
                  </span>
                ))}
              </div>
            )}
          </div>

          <!-- Quick Action Buttons Column -->
          <div class="lg:col-span-4 flex flex-col gap-3 justify-center">
            
            <!-- Direct Download Button -->
            <a 
              href={doc.pdfUrl} 
              download 
              class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm shadow-lg shadow-blue-600/30 hover:shadow-blue-500/40 transition-all transform active:scale-[0.98]"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              Download PDF File
            </a>

            <div class="grid grid-cols-2 gap-2.5">
              <!-- WhatsApp Share Button -->
              <a 
                href={`https://wa.me/?text=${shareWhatsappText}`}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs sm:text-sm shadow-md transition-all"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                </svg>
                WhatsApp
              </a>

              <!-- Copy Share Link Button -->
              <button 
                id="copyLinkBtn"
                data-url={canonicalUrl}
                class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-semibold text-xs sm:text-sm border border-slate-700 shadow-md transition-all active:scale-[0.97]"
              >
                <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span id="copyLinkText">Copy Link</span>
              </button>
            </div>

            <!-- Open in New Tab -->
            <a 
              href={doc.pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-slate-800/60 hover:bg-slate-800 text-slate-300 hover:text-white font-medium text-xs border border-slate-700/60 transition-all text-center"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
              Open PDF in New Browser Tab
            </a>

          </div>
        </div>
      </div>

      <!-- PDF Embedded Viewer Section -->
      <div class="bg-white rounded-3xl border border-slate-200/80 shadow-xl overflow-hidden mb-12">
        
        <!-- Viewer Control Bar -->
        <div class="px-6 py-4 bg-slate-100/80 border-b border-slate-200 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3 text-slate-700 font-semibold text-sm">
            <span class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Document Preview Mode</span>
          </div>

          <div class="flex items-center gap-3 text-xs text-slate-500">
            <span>Powered by TESCA Document Viewer</span>
            <a 
              href={doc.pdfUrl} 
              target="_blank" 
              class="text-blue-600 font-semibold hover:underline flex items-center gap-1"
            >
              Full Screen ↗
            </a>
          </div>
        </div>

        <!-- Object / Embedded Reader Frame -->
        <div class="w-full bg-slate-900 relative" style="height: min(80vh, 900px); min-height: 500px;">
          <object
            data={`${doc.pdfUrl}#toolbar=1&navpanes=1&scrollbar=1`}
            type="application/pdf"
            class="w-full h-full border-0"
          >
            <!-- Fallback UI if browser blocks or doesn't support embedded PDF -->
            <div class="w-full h-full flex flex-col items-center justify-center p-8 text-center bg-slate-900 text-white space-y-4">
              <div class="w-16 h-16 rounded-full bg-blue-600/20 text-blue-400 flex items-center justify-center text-3xl">
                📄
              </div>
              <h3 class="text-xl font-bold font-display">PDF Preview Ready</h3>
              <p class="text-slate-400 text-sm max-w-md">
                Your browser requires direct opening or downloading to view this PDF file seamlessly.
              </p>
              <div class="flex flex-wrap gap-4 justify-center pt-2">
                <a
                  href={doc.pdfUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-6 py-3 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm shadow-md"
                >
                  View Full PDF
                </a>
                <a
                  href={doc.pdfUrl}
                  download
                  class="px-6 py-3 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-semibold text-sm border border-slate-700"
                >
                  Download File
                </a>
              </div>
            </div>
          </object>
        </div>
      </div>

      <!-- Bottom Layout Grid: CTA & Related Documents -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Left: Need Help / Inquiry Card -->
        <div class="lg:col-span-5 bg-gradient-to-br from-blue-900 to-slate-900 rounded-3xl p-8 text-white shadow-lg border border-blue-800/50 flex flex-col justify-between">
          <div class="space-y-4">
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-blue-500/20 text-blue-300 border border-blue-400/30">
              TESCA Expert Assistance
            </span>
            <h3 class="text-2xl font-bold font-display leading-tight">
              Have Questions About This Guide or Your Visa Process?
            </h3>
            <p class="text-slate-300 text-sm leading-relaxed font-sans">
              Connect directly with our senior visa counsellors in Surat for personalized guidance, profile evaluation, and document review.
            </p>
          </div>

          <div class="pt-6 space-y-3">
            <a 
              href="/inquiry" 
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-accent-blue hover:bg-blue-500 text-white font-bold text-sm shadow-lg transition-all"
            >
              Book Free Consultation
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
            <a 
              href="https://wa.me/919979708687" 
              target="_blank"
              class="w-full inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-emerald-700/60 hover:bg-emerald-700 text-emerald-100 font-semibold text-xs border border-emerald-600/40 text-center"
            >
              Instant WhatsApp Query
            </a>
          </div>
        </div>

        <!-- Right: Other Resources & PDF Guides -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-8 border border-slate-200/80 shadow-md">
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xl font-bold text-slate-900 font-display">
              More Shared Resources
            </h3>
            <a href="/documents" class="text-xs font-bold text-blue-600 hover:underline">
              View All ({documents.length}) →
            </a>
          </div>

          <div class="space-y-4">
            {otherDocs.map((item) => (
              <a 
                href={`/documents/${item.slug}`}
                class="group block p-4 rounded-2xl border border-slate-100 hover:border-blue-200 bg-slate-50/50 hover:bg-blue-50/40 transition-all"
              >
                <div class="flex items-start justify-between gap-4">
                  <div class="space-y-1">
                    <div class="flex items-center gap-2">
                      <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-blue-100 text-blue-700">
                        {item.category}
                      </span>
                      {item.fileSize && (
                        <span class="text-[11px] text-slate-400 font-sans">
                          {item.fileSize}
                        </span>
                      )}
                    </div>
                    <h4 class="text-base font-bold text-slate-800 group-hover:text-blue-600 transition-colors">
                      {item.title}
                    </h4>
                    <p class="text-xs text-slate-500 line-clamp-2 font-sans">
                      {item.description}
                    </p>
                  </div>
                  <span class="text-slate-400 group-hover:text-blue-600 group-hover:translate-x-1 transition-all shrink-0 mt-1">
                    →
                  </span>
                </div>
              </a>
            ))}
          </div>
        </div>

      </div>

    </section>
  </main>

  <AICounsellor client:only="react" />
</Layout>

<!-- Copy Link Interactive Client Script -->
<script>
  const copyBtn = document.getElementById("copyLinkBtn");
  const copyText = document.getElementById("copyLinkText");

  if (copyBtn && copyText) {
    copyBtn.addEventListener("click", async () => {
      const url = copyBtn.getAttribute("data-url") || window.location.href;
      try {
        await navigator.clipboard.writeText(url);
        copyText.textContent = "Copied Link! ✓";
        copyBtn.classList.remove("bg-slate-800");
        copyBtn.classList.add("bg-emerald-600");
        setTimeout(() => {
          copyText.textContent = "Copy Link";
          copyBtn.classList.remove("bg-emerald-600");
          copyBtn.classList.add("bg-slate-800");
        }, 3000);
      } catch (err) {
        console.error("Failed to copy URL:", err);
      }
    });
  }
</script>
