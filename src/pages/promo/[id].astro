---
export const prerender = false;
import Layout from "../../layouts/Layout.astro";
import { getSupabaseAdmin } from "../../utils/supabase";

const { id } = Astro.params;
const supabase = getSupabaseAdmin();

const { data: popup, error } = await supabase
  .from('popup_settings')
  .select('*')
  .eq('id', id)
  .single();

if (error || !popup) {
  return Astro.redirect("/");
}

const reqFields = Array.isArray(popup.required_fields) ? popup.required_fields : ["name", "phone"];
const isNameReq = reqFields.includes("name");
const isPhoneReq = reqFields.includes("phone");
const isEmailReq = reqFields.includes("email");

const whatsappMsg = encodeURIComponent(`Hello TESCA Visa Consultancy, I saw your update "${popup.title}" and would like more details.`);
const whatsappUrl = `https://wa.me/919824152731?text=${whatsappMsg}`;
---

<Layout
  title={`${popup.title} | TESCA`}
  description={popup.subtitle || "Register to receive details."}
>
  <main class="min-h-screen bg-slate-50 py-12 md:py-20 px-4 flex items-center justify-center">
    <div class="w-full max-w-5xl flex flex-col gap-5">
      <a 
        href="/" 
        class="inline-flex items-center gap-2 px-4 py-2 bg-white hover:bg-slate-50 text-slate-600 hover:text-slate-900 font-semibold text-xs rounded-full border border-slate-200/80 shadow-sm transition-all duration-200 hover:-translate-x-1 self-start font-sans group"
      >
        <svg 
          xmlns="http://www.w3.org/2000/svg" 
          width="14" 
          height="14" 
          viewBox="0 0 24 24" 
          fill="none" 
          stroke="currentColor" 
          stroke-width="2.5" 
          stroke-linecap="round" 
          stroke-linejoin="round" 
          class="transition-transform group-hover:-translate-x-0.5"
        >
          <path d="m12 19-7-7 7-7"/>
          <path d="M19 12H5"/>
        </svg>
        Back to Home
      </a>

      <div class="w-full bg-white rounded-[2rem] shadow-xl overflow-hidden border border-slate-100 flex flex-col md:flex-row min-h-[500px]">
      
      <!-- Left side: Flyer Image (hidden on mobile, visible on desktop md+) -->
      <div class="hidden md:flex w-full md:w-1/2 relative bg-slate-950 overflow-hidden items-center justify-center min-h-[350px] md:min-h-full">
        <img 
          src={popup.image_url} 
          alt="" 
          class="absolute inset-0 w-full h-full object-cover blur-2xl opacity-50 scale-125 pointer-events-none select-none" 
        />
        <img 
          src={popup.image_url} 
          alt={popup.title} 
          class="relative max-w-full max-h-full object-contain block z-10 p-2 sm:p-4 drop-shadow-2xl" 
        />
      </div>

      <!-- Right side: Lead capture form -->
      <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-center bg-white relative">
        
        <div id="form-container" class="space-y-6">
          <div>
            <span class="inline-block text-[9px] font-extrabold uppercase tracking-widest text-indigo-600 bg-indigo-50 border border-indigo-100 px-2.5 py-0.5 rounded-full mb-3">Featured Update</span>
            <h1 class="text-xl md:text-2xl font-extrabold tracking-tight text-slate-800 leading-tight">
              {popup.title}
            </h1>
            {popup.subtitle && (
              <p class="text-slate-500 text-xs mt-3 leading-relaxed font-sans font-normal">
                {popup.subtitle}
              </p>
            )}
          </div>

          <form id="promo-landing-lead-form" class="space-y-4 text-xs font-semibold text-slate-600" autocomplete="off">
            <input type="hidden" name="popupId" value={popup.id} />
            <input type="hidden" name="popupTitle" value={popup.title} />

            <div class="space-y-1.5">
              <label for="name" class="text-[10px] text-slate-500 uppercase tracking-wide">
                Full Name {isNameReq ? "*" : "(Optional)"}
              </label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required={isNameReq}
                class="w-full px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-850 focus:outline-none focus:ring-1 focus:ring-indigo-500 font-sans font-normal" 
                placeholder="e.g. John Doe" 
              />
            </div>

            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label for="phone" class="text-[10px] text-slate-500 uppercase tracking-wide">
                  Mobile Number {isPhoneReq ? "*" : "(Optional)"}
                </label>
                <span id="phone-counter" class="text-[10px] font-bold text-amber-600 font-mono">
                  0/10 digits
                </span>
              </div>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                maxlength={10}
                required={isPhoneReq}
                class="w-full px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-855 focus:outline-none focus:ring-1 focus:ring-indigo-500 font-mono font-normal" 
                placeholder="e.g. 9824152731" 
              />
            </div>

            <div class="space-y-1.5">
              <label for="email" class="text-[10px] text-slate-500 uppercase tracking-wide">
                Email Address {isEmailReq ? "*" : "(Optional)"}
              </label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required={isEmailReq}
                class="w-full px-3.5 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-860 focus:outline-none focus:ring-1 focus:ring-indigo-500 font-sans font-normal" 
                placeholder="e.g. johndoe@gmail.com" 
              />
            </div>

            <div class="pt-3">
              <button 
                type="submit" 
                id="submit-btn" 
                class="w-full py-3.5 bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700 text-white font-bold text-xs rounded-xl shadow-lg cursor-pointer hover:scale-[1.01] transition-all flex items-center justify-center gap-2"
              >
                Submit Registration
              </button>
            </div>
          </form>

          <!-- Direct Instant Connect CTAs -->
          <div class="pt-2 border-t border-slate-100">
            <div class="flex items-center justify-center mb-3">
              <span class="text-[10px] uppercase font-bold tracking-wider text-slate-400 bg-white px-2">Or connect instantly</span>
            </div>
            <div class="grid grid-cols-2 gap-2.5">
              <a 
                href="tel:+919824152731" 
                class="flex items-center justify-center gap-2 py-2.5 px-3 bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold text-xs rounded-xl border border-slate-200 transition-all hover:scale-[1.01] no-underline"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600 shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                <span>Call Us</span>
              </a>
              <a 
                href={whatsappUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="flex items-center justify-center gap-2 py-2.5 px-3 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold text-xs rounded-xl border border-emerald-200 transition-all hover:scale-[1.01] no-underline"
              >
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-current text-emerald-600 shrink-0"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.128.559 4.122 1.532 5.859L.057 23.5l5.784-1.518A11.932 11.932 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.846 0-3.573-.492-5.063-1.35L2.5 21.869l1.244-4.287A10 10 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
                <span>WhatsApp Us</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Success State Container -->
        <div id="success-container" class="hidden absolute inset-0 bg-white p-8 md:p-12 flex flex-col items-center justify-center text-center">
          <div class="w-16 h-16 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mb-5 border border-emerald-100">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <h2 class="text-lg md:text-xl font-extrabold text-slate-800">Registration Successful!</h2>
          <p class="text-slate-500 text-xs mt-2.5 leading-relaxed max-w-sm font-sans font-normal">
            Thank you for registering. Our student coordinator will contact you shortly to review your profile.
          </p>
          <div class="flex flex-wrap items-center justify-center gap-3 mt-6">
            <a 
              href="tel:+919824152731" 
              class="px-4 py-2.5 bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold text-xs rounded-xl border border-slate-200 transition-all flex items-center gap-2 no-underline"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-600"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              Call Us
            </a>
            <a 
              href={whatsappUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="px-4 py-2.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-bold text-xs rounded-xl border border-emerald-200 transition-all flex items-center gap-2 no-underline"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-3.5 h-3.5 fill-current text-emerald-600"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.128.559 4.122 1.532 5.859L.057 23.5l5.784-1.518A11.932 11.932 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.846 0-3.573-.492-5.063-1.35L2.5 21.869l1.244-4.287A10 10 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
              WhatsApp
            </a>
            <a 
              href="/" 
              class="px-4 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-xl transition-all"
            >
              Go to Homepage
            </a>
          </div>
        </div>

      </div>

    </div>
  </div>
</main>
</Layout>

<script>
  function setupPromoForm() {
    const form = document.getElementById("promo-landing-lead-form") as HTMLFormElement;
    if (!form || (form as any)._bound) return;
    (form as any)._bound = true;
    const formContainer = document.getElementById("form-container");
    const successContainer = document.getElementById("success-container");
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;
    const phoneInput = document.getElementById("phone") as HTMLInputElement;
    const phoneCounter = document.getElementById("phone-counter");

    if (phoneInput && phoneCounter) {
      phoneInput.addEventListener("input", () => {
        const digits = phoneInput.value.replace(/\D/g, "").slice(0, 10);
        phoneInput.value = digits;
        if (digits.length === 10) {
          phoneCounter.textContent = "10/10 digits ✓";
          phoneCounter.className = "text-[10px] font-bold text-emerald-600 font-mono";
        } else {
          phoneCounter.textContent = `${digits.length}/10 digits`;
          phoneCounter.className = "text-[10px] font-bold text-amber-600 font-mono";
        }
      });
    }

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(form);
      const phoneVal = (formData.get("phone")?.toString() || "").replace(/\D/g, "");
      if (phoneInput?.required && phoneVal.length !== 10) {
        alert("Please enter a valid 10-digit mobile number.");
        return;
      }

      const originalBtnContent = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = `
        <svg class="animate-spin h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Submitting...</span>
      `;

      const payload = {
        name: formData.get("name")?.toString() || null,
        phone: phoneVal || null,
        email: formData.get("email")?.toString() || null,
        popupId: formData.get("popupId")?.toString(),
        popupTitle: formData.get("popupTitle")?.toString()
      };

      try {
        const res = await fetch("/api/popup-lead", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || "Submission failed. Please try again.");
        }

        // Show success state
        if (formContainer && successContainer) {
          formContainer.classList.add("hidden");
          successContainer.classList.remove("hidden");
        }

      } catch (err: any) {
        alert(err.message || "An error occurred. Please try again.");
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalBtnContent;
      }
    });
  }

  document.addEventListener("astro:page-load", setupPromoForm);
  setupPromoForm();
</script>
