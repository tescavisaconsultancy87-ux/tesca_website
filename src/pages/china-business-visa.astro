---
export const prerender = true;
import Layout from "../layouts/Layout.astro";

const cantonPhases = [
  {
    phase: "Phase 1",
    dates: "April 15 – 19, 2026 / October 15 – 19, 2026",
    categories: "Consumer Electronics, Household Electrical Appliances, Industrial Machinery, Hardware, Tools, Vehicles & EV Parts, Lighting, New Energy.",
    badge: "High Demand"
  },
  {
    phase: "Phase 2",
    dates: "April 23 – 27, 2026 / October 23 – 27, 2026",
    categories: "Building & Decorative Materials, Sanitary & Bathroom Equipment, Furniture, Kitchenware, Ceramics, Home Decorations, Gifts & Premiums.",
    badge: "Trending"
  },
  {
    phase: "Phase 3",
    dates: "May 1 – 5, 2026 / October 31 – November 4, 2026",
    categories: "Textiles, Fabrics, Garments, Shoes, Bags, Office Supplies, Medical Devices & Health Products, Food & Native Produce, Personal Care.",
    badge: "Popular"
  }
];

const checklist = [
  { title: "Original Passport", desc: "Valid for at least 6 months with at least 2 blank visa pages, plus previous passports if any." },
  { title: "Official Invitation Letter", desc: "Chinese Business Invitation (PU Letter / Official Inviting Company Letter) with seal and authorized signature." },
  { title: "Indian Business Documents", desc: "Company GST registration, Certificate of Incorporation, or Partnership Deed verifying business legitimacy." },
  { title: "Company Covering Letter", desc: "Original on Indian company letterhead stating purpose of visit, trip dates, and financial responsibility." },
  { title: "Color Photographs", desc: "2 recent passport-size photos (33mm x 48mm) on matte white background without spectacles." },
  { title: "Bank Statements", desc: "Last 6 months updated company and personal bank statements with minimum required balance and bank seal." }
];

const faqs = [
  {
    q: "How long does it take to process a China Business (M) Visa?",
    a: "Standard processing typically takes 7-10 working days. With TESCA's express processing track, approvals can be obtained in 4-5 working days once biometric appointment is scheduled."
  },
  {
    q: "What is the Canton Fair badge and do I need an invitation to attend?",
    a: "Yes. To enter the China Import and Export Fair (Canton Fair in Guangzhou), overseas buyers must register online with an official buyer invitation to receive the Buyer Badge (IC Card)."
  },
  {
    q: "Can TESCA help if I do not have a Chinese supplier invitation letter?",
    a: "TESCA assists eligible Indian business owners and trade delegates with Canton Fair pre-registration, Buyer Invitation generation, and authorized Chinese trade association facilitation."
  },
  {
    q: "Do I need to visit the Chinese Visa Application Centre (VFS) in person?",
    a: "First-time applicants aged 14-70 must visit the Visa Application Service Centre (Mumbai/Delhi) for digital biometrics (fingerprints). Repeat travelers who gave biometrics within 5 years may be exempt."
  }
];

const chinaStructuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "China Business Visa & Canton Fair Processing",
  "serviceType": "Business Visa Consultancy",
  "provider": {
    "@type": "EducationalOrganization",
    "name": "TESCA Visa Consultancy",
    "url": "https://tescavisa.com"
  },
  "areaServed": "India",
  "description": "Fast-track 4-5 day China Business (M) visa processing, Canton Fair 2026 invitation assistance, and complete document filing support in Surat.",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "China Visa Services",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "China M-Visa (Single / Double Entry)" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Canton Fair Buyer Invitation & Registration" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Express Visa Processing (4-5 Days)" } }
    ]
  }
};

const faqStructuredData = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a }
  }))
};
---

<Layout
  title="China Business Visa & Canton Fair 2026 | Fast Express Processing | TESCA"
  description="Apply for China Business (M) Visa & Canton Fair 2026. 4-5 day fast-track processing, official buyer invitation assistance, document filing, and 97% visa success rate."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(chinaStructuredData)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqStructuredData)} />

  <section class="max-w-7xl mx-auto px-6 md:px-8 pt-8 pb-20 text-left font-sans">
    
    <!-- Breadcrumb / Back Link -->
    <a href="/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-blue hover:underline mb-8 font-sans">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
      Back to Home
    </a>

    <!-- Hero Header -->
    <div class="glass-card rounded-[2.5rem] overflow-hidden bg-gradient-to-br from-red-950/20 via-slate-50/80 to-amber-500/10 border border-slate-200/60 shadow-lg p-8 md:p-12 relative mb-12">
      <div class="aurora-bg w-[320px] h-[320px] bg-red-500/10 -top-12 -left-12 rounded-full blur-[80px]"></div>

      <div class="max-w-3xl space-y-5 relative z-10">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="inline-block text-xs font-bold tracking-wider text-red-700 bg-red-100/80 px-4 py-1.5 rounded-full border border-red-200 uppercase font-sans">
            🇨🇳 Business & Trade Visas
          </span>
          <span class="inline-block text-xs font-bold tracking-wider text-emerald-700 bg-emerald-100/80 px-4 py-1.5 rounded-full border border-emerald-200 uppercase font-sans">
            ⚡ 4–5 Day Express Processing
          </span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-black font-display text-slate-900 leading-tight">
          China Business (M) Visa & Canton Fair 2026
        </h1>
        
        <p class="text-base sm:text-lg text-slate-600 font-sans leading-relaxed max-w-2xl">
          Heading to Guangzhou, Shanghai, Yiwu, or Beijing for business, factory visits, or the world-famous Canton Fair? TESCA provides complete end-to-end China M-Visa filing with guaranteed error-free documentation.
        </p>

        <!-- CTAs -->
        <div class="flex flex-wrap items-center gap-3 pt-2">
          <a 
            href="https://wa.me/919824152731?text=Hi%20TESCA%2C%20I%20need%20assistance%20with%20China%20Business%20Visa%20%2F%20Canton%20Fair%202026."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 py-3 px-6 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-bold text-sm rounded-xl shadow-md transition-all hover:scale-105"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span>Apply via WhatsApp</span>
          </a>

          <a 
            href="#china-inquiry"
            class="inline-flex items-center justify-center gap-2 py-3 px-6 bg-[#0F4C81] hover:bg-[#0a3a63] text-white font-bold text-sm rounded-xl shadow-md transition-all"
          >
            <span>Get Free Assessment</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>

    <!-- 3 Key Features -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-2">
        <div class="w-10 h-10 rounded-xl bg-red-500/10 text-red-600 flex items-center justify-center font-bold text-lg mb-2">⚡</div>
        <h3 class="text-base font-bold text-slate-900 font-display">Express Turnaround</h3>
        <p class="text-xs text-slate-500 leading-relaxed">Fast-track processing in 4-5 business days. Urgent biometric slots booked in Mumbai and Delhi VFS centres.</p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-2">
        <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center font-bold text-lg mb-2">📄</div>
        <h3 class="text-base font-bold text-slate-900 font-display">Invitation Letter Support</h3>
        <p class="text-xs text-slate-500 leading-relaxed">Official verification of Chinese supplier invitation letters, PU Letters, and Canton Fair buyer pre-registration badges.</p>
      </div>

      <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-2">
        <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-600 flex items-center justify-center font-bold text-lg mb-2">🛡️</div>
        <h3 class="text-base font-bold text-slate-900 font-display">97% Visa Approval SLA</h3>
        <p class="text-xs text-slate-500 leading-relaxed">Zero risk of rejection due to formatting errors, missing company seals, or incomplete itinerary documentation.</p>
      </div>
    </div>

    <!-- Canton Fair 2026 Schedule Breakdown -->
    <div class="mb-16 space-y-6">
      <div class="max-w-2xl space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-red-600 font-sans">Guangzhou Trade Fair</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-display text-slate-900">Canton Fair 2026 Phases & Dates</h2>
        <p class="text-sm text-slate-500 leading-relaxed">Plan your travel according to your industry sector. Visa slots book out 3-4 weeks before each phase opens.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {cantonPhases.map((phase) => (
          <div class="glass-card rounded-2xl bg-white/90 border border-slate-200 shadow-md p-6 relative overflow-hidden flex flex-col justify-between">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="text-xl font-black font-display text-slate-900">{phase.phase}</h3>
                <span class="text-[10px] font-bold uppercase px-2.5 py-1 bg-red-100 text-red-700 rounded-full">{phase.badge}</span>
              </div>
              <p class="text-xs font-bold text-red-600 font-mono">{phase.dates}</p>
              <p class="text-xs text-slate-600 leading-relaxed">{phase.categories}</p>
            </div>
            <a 
              href="https://wa.me/919824152731?text=Hi%20TESCA%2C%20I%20want%20to%20apply%20for%20Canton%20Fair%20Visa%20for%20" + encodeURIComponent(phase.phase)
              target="_blank"
              rel="noopener noreferrer"
              class="mt-5 w-full py-2.5 px-4 bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs rounded-xl text-center transition-colors block"
            >
              Book for {phase.phase} →
            </a>
          </div>
        ))}
      </div>
    </div>

    <!-- Document Checklist -->
    <div class="mb-16 space-y-6">
      <div class="max-w-2xl space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-[#0F4C81] font-sans">Requirements</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-display text-slate-900">Required Documents Checklist</h2>
        <p class="text-sm text-slate-500 leading-relaxed">All business documents must be properly stamped and notarized where necessary.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {checklist.map((item, idx) => (
          <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-2">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-full bg-accent-blue/10 text-accent-blue flex items-center justify-center font-bold text-xs">{idx + 1}</span>
              <h3 class="text-sm font-bold text-slate-800 font-display">{item.title}</h3>
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Lead Form & Inquiry Section -->
    <div id="china-inquiry" class="rounded-3xl bg-slate-900 text-white p-8 md:p-12 shadow-2xl relative overflow-hidden mb-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div class="space-y-4">
          <span class="inline-block text-xs font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-full border border-emerald-500/20">
            Instant Visa Support
          </span>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-black font-display text-white">
            Ready to Apply for Your China Business Visa?
          </h2>
          <p class="text-sm text-slate-300 leading-relaxed">
            Fill out the form or WhatsApp our visa officers. We review your invitation letter and business papers within 2 hours.
          </p>

          <div class="pt-4 space-y-2 text-xs text-slate-300">
            <p class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span> Direct office in Simada Naka & Mota Varachha, Surat
            </p>
            <p class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span> Fast biometric appointment scheduling at Mumbai & Delhi centres
            </p>
            <p class="flex items-center gap-2">
              <span class="text-emerald-400 font-bold">✓</span> Over 1,500+ China visas processed for Gujarat trade delegates
            </p>
          </div>
        </div>

        <div class="bg-white/10 backdrop-blur-md rounded-2xl border border-white/15 p-6 shadow-xl">
          <h3 class="text-lg font-bold text-white mb-2 font-display">Inquire Now</h3>
          <p class="text-xs text-slate-300 mb-4">Our visa counsellor will call you within 24 hours.</p>

          <form id="china-visa-form" class="space-y-3">
            <input type="hidden" name="category" value="general" />
            <input type="hidden" name="subject" value="China Business & Canton Fair Visa Inquiry" />

            <div>
              <label for="cv-name" class="sr-only">Full Name</label>
              <input type="text" id="cv-name" name="name" required placeholder="Full Name *"
                class="w-full px-4 py-2.5 bg-slate-900/90 border border-white/20 rounded-xl text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400"
              />
            </div>

            <div>
              <label for="cv-phone" class="sr-only">Phone Number</label>
              <input type="tel" id="cv-phone" name="phone" maxlength="10" required placeholder="10-Digit Mobile Number *"
                class="w-full px-4 py-2.5 bg-slate-900/90 border border-white/20 rounded-xl text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400 font-mono"
              />
            </div>

            <div>
              <label for="cv-email" class="sr-only">Email Address</label>
              <input type="email" id="cv-email" name="email" required placeholder="Email Address *"
                class="w-full px-4 py-2.5 bg-slate-900/90 border border-white/20 rounded-xl text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400"
              />
            </div>

            <div>
              <label for="cv-city" class="sr-only">Company / City</label>
              <input type="text" id="cv-city" name="city" placeholder="Company Name & City (e.g. Surat, Mumbai)"
                class="w-full px-4 py-2.5 bg-slate-900/90 border border-white/20 rounded-xl text-xs text-white placeholder-slate-400 focus:outline-none focus:border-emerald-400"
              />
            </div>

            <button type="submit" id="cv-submit"
              class="w-full py-3 px-4 bg-emerald-600 hover:bg-emerald-500 active:bg-emerald-700 text-white font-bold text-xs rounded-xl shadow-lg transition-all cursor-pointer"
            >
              Submit Visa Inquiry
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Frequently Asked Questions -->
    <div class="space-y-6">
      <div class="max-w-2xl space-y-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-500 font-sans">Got Questions?</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-display text-slate-900">China Visa FAQs</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {faqs.map((faq) => (
          <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-2">
            <h3 class="text-sm font-bold text-slate-900 font-display">{faq.q}</h3>
            <p class="text-xs text-slate-600 leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>

  </section>

  <script>
    function initChinaForm() {
      const form = document.getElementById("china-visa-form") as HTMLFormElement | null;
      const submitBtn = document.getElementById("cv-submit") as HTMLButtonElement | null;
      const phoneInput = document.getElementById("cv-phone") as HTMLInputElement | null;

      if (phoneInput) {
        phoneInput.addEventListener("input", () => {
          phoneInput.value = phoneInput.value.replace(/\D/g, "").slice(0, 10);
        });
      }

      if (form && submitBtn) {
        if ((form as any).__bound) return;
        (form as any).__bound = true;

        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const name = (form.querySelector('[name="name"]') as HTMLInputElement).value.trim();
          const phone = (form.querySelector('[name="phone"]') as HTMLInputElement).value.trim();
          const email = (form.querySelector('[name="email"]') as HTMLInputElement).value.trim();
          const city = (form.querySelector('[name="city"]') as HTMLInputElement).value.trim();

          if (!name || !phone || phone.length !== 10 || !email) {
            if ((window as any).showToast) (window as any).showToast("Please enter all required fields with a valid 10-digit phone.", "warning");
            return;
          }

          submitBtn.disabled = true;
          submitBtn.textContent = "Submitting...";

          try {
            const res = await fetch("/api/contact", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                name,
                email,
                phone,
                category: "general",
                subject: "China Business & Canton Fair Visa Inquiry",
                message: `Lead for China Business Visa. Company/City: ${city || "Not provided"}. Phone: ${phone}. Email: ${email}.`
              })
            });

            const data = await res.json();
            if (data.success) {
              if ((window as any).showToast) (window as any).showToast("Inquiry received! Our China visa desk will contact you within 24 hours.", "success");
              if ((window as any).posthog) (window as any).posthog.capture("china_visa_lead_submitted", { city });
              form.reset();
              submitBtn.textContent = "Inquiry Sent ✓";
            } else {
              if ((window as any).showToast) (window as any).showToast(data.error || "Submission failed. Please WhatsApp us.", "error");
              submitBtn.disabled = false;
              submitBtn.textContent = "Submit Visa Inquiry";
            }
          } catch (err) {
            if ((window as any).showToast) (window as any).showToast("Network error. Please contact us on WhatsApp.", "error");
            submitBtn.disabled = false;
            submitBtn.textContent = "Submit Visa Inquiry";
          }
        });
      }
    }

    document.addEventListener("astro:page-load", initChinaForm);
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initChinaForm);
    } else {
      initChinaForm();
    }
  </script>
</Layout>
