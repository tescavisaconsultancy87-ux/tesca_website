  <!-- PDF.js Engine (Same-Origin for zero worker CORS blocking) -->
  <script is:inline src="/js/pdf.min.js"></script>

  <script is:inline define:vars={{ pdfUrl: doc.pdfUrl, docSlug: doc.slug, docTitle: doc.title }}>
    async function initPdfViewer() {
      const spinner = document.getElementById("loading-spinner");
      const wrapper = document.getElementById("pdf-viewer-wrapper");
      const pagesContainer = document.getElementById("pdf-pages-container");

      if (!pagesContainer) return;
      // Prevent duplicate rendering
      pagesContainer.innerHTML = "";

      const pdfjsLib = window.pdfjsLib || window["pdfjs-dist/build/pdf"];

      if (!pdfjsLib) {
        if (spinner) spinner.innerHTML = `<p class="text-xs text-rose-400 font-bold">Failed to load PDF viewer library.</p>`;
        return;
      }

      pdfjsLib.GlobalWorkerOptions.workerSrc = "/js/pdf.worker.min.js";

      try {
        const loadingTask = pdfjsLib.getDocument(pdfUrl);
        const pdf = await loadingTask.promise;

        if (spinner) spinner.classList.add("hidden");
        if (wrapper) wrapper.classList.remove("hidden");

        for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
          const page = await pdf.getPage(pageNum);
          
          // Compute High-DPI scale for razor-sharp text rendering on Retina & 4K screens
          const dpr = Math.max(window.devicePixelRatio || 1, 2.5);
          const containerWidth = pagesContainer.clientWidth || 800;
          const unscaledViewport = page.getViewport({ scale: 1.0 });
          const displayScale = Math.max((containerWidth - 32) / unscaledViewport.width, 0.8);
          const renderScale = displayScale * dpr;

          const viewport = page.getViewport({ scale: renderScale });

          const pageWrapper = document.createElement("div");
          pageWrapper.className = "relative w-full max-w-3xl rounded-2xl overflow-hidden bg-white shadow-2xl border border-slate-800 flex flex-col items-center";

          const canvas = document.createElement("canvas");
          const context = canvas.getContext("2d", { alpha: false });
          canvas.width = Math.floor(viewport.width);
          canvas.height = Math.floor(viewport.height);
          canvas.style.width = "100%";
          canvas.style.height = "auto";
          canvas.className = "w-full h-auto block select-none pointer-events-none";

          context.imageSmoothingEnabled = true;
          context.imageSmoothingQuality = "high";

          await page.render({ canvasContext: context, viewport: viewport }).promise;
          pageWrapper.appendChild(canvas);

          // Page Number Indicator Footer
          const pageFooter = document.createElement("div");
          pageFooter.className = "w-full py-2 bg-slate-100 border-t border-slate-200 text-center text-[10px] font-bold text-slate-500 uppercase tracking-wider";
          pageFooter.innerText = `Page ${pageNum} of ${pdf.numPages}`;
          pageWrapper.appendChild(pageFooter);

          pagesContainer.appendChild(pageWrapper);
        }
      } catch (err) {
        console.error("PDF Render Error:", err);
        if (spinner) {
          spinner.classList.remove("hidden");
          spinner.innerHTML = `<p class="text-xs text-rose-400 font-bold">Failed to load document preview. Please check URL.</p>`;
        }
      }
    }

    // Lead Form Handler
    function initLeadForm() {
      const form = document.getElementById("doc-lead-form");
      const submitBtn = document.getElementById("doc-lead-submit");
      const phoneInput = document.getElementById("doc-lead-phone");

      if (phoneInput) {
        phoneInput.addEventListener("input", () => {
          phoneInput.value = phoneInput.value.replace(/\D/g, "").slice(0, 10);
        });
      }

      if (form && submitBtn) {
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const name = form.querySelector('[name="name"]').value.trim();
          const phone = form.querySelector('[name="phone"]').value.trim();
          const email = form.querySelector('[name="email"]').value.trim();
          const city = form.querySelector('[name="city"]').value.trim();
          const source = form.querySelector('[name="source"]').value.trim();

          if (!name || !phone || phone.length !== 10 || !email) {
            if (window.showToast) window.showToast("Please provide your name, valid 10-digit phone number, and email.", "warning");
            return;
          }

          submitBtn.disabled = true;
          submitBtn.innerHTML = `<span>Submitting...</span>`;

          try {
            const res = await fetch("/api/contact", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                name,
                email,
                phone,
                subject: `Assessment Request: ${source}`,
                category: "general",
                message: `Lead from document guide: ${source}. City: ${city || "Not specified"}. Phone: ${phone}. Email: ${email}.`
              })
            });

            const data = await res.json();
            if (data.success) {
              if (window.showToast) {
                window.showToast("Thank you! Your assessment request has been received. Our team will contact you shortly.", "success");
              }
              if (window.posthog) {
                window.posthog.capture("document_lead_submitted", { source, city });
              }
              form.reset();
              submitBtn.innerHTML = `<span>Assessment Requested ✓</span>`;
            } else {
              if (window.showToast) window.showToast(data.error || "Submission failed. Please WhatsApp us directly.", "error");
              submitBtn.disabled = false;
              submitBtn.innerHTML = `<span>Request Free Assessment</span>`;
            }
          } catch (err) {
            if (window.showToast) window.showToast("Network error. Please chat with us on WhatsApp.", "error");
            submitBtn.disabled = false;
            submitBtn.innerHTML = `<span>Request Free Assessment</span>`;
          }
        });
      }
    }

    // Direct WhatsApp Analytics Tracker
    function initWhatsAppTracking() {
      document.querySelectorAll('a[href*="wa.me"]').forEach(link => {
        if (link.dataset.waAttached === "true") return;
        link.dataset.waAttached = "true";

        link.addEventListener('click', () => {
          const ctaLoc = link.getAttribute('data-cta-loc') || 'document_page';
          if (window.gtag) {
            window.gtag('event', 'whatsapp_click', {
              event_category: 'engagement',
              destination: link.href,
              location: ctaLoc
            });
            window.gtag('event', 'generate_lead', {
              event_category: 'conversion',
              lead_method: 'whatsapp',
              source: `Document Guide: ${docTitle}`
            });
          }
          if (window.posthog) {
            window.posthog.capture('whatsapp_click', {
              source: 'document_guide',
              doc_slug: docSlug,
              doc_title: docTitle,
              cta_location: ctaLoc
            });
            window.posthog.capture('contact_whatsapp_clicked', {
              source: 'document_guide',
              doc_slug: docSlug,
              doc_title: docTitle,
              cta_location: ctaLoc
            });
            window.posthog.capture('generate_lead', {
              lead_method: 'whatsapp',
              source: `Document Guide: ${docTitle}`,
              cta_location: ctaLoc
            });
          }
        });
      });
    }

    // View Transitions compatibility
    document.addEventListener("astro:page-load", () => {
      initPdfViewer();
      initLeadForm();
      initWhatsAppTracking();
    });

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        initPdfViewer();
        initLeadForm();
        initWhatsAppTracking();
      });
    } else {
      initPdfViewer();
      initLeadForm();
      initWhatsAppTracking();
    }

    // 🔒 Security Protection 1: Block Right-Click Context Menu
    document.addEventListener("contextmenu", (e) => {
      e.preventDefault();
    });

    // 🔒 Security Protection 2: Intercept Save & Print Keyboard Shortcuts
    document.addEventListener("keydown", (e) => {
      if (!e.key) return;
      const key = e.key.toLowerCase();
      if (
        (e.ctrlKey || e.metaKey) && 
        (key === "s" || key === "p" || key === "u" || key === "i" || key === "j" || key === "c")
      ) {
        e.preventDefault();
        e.stopPropagation();
      }
      if (key === "f12") {
        e.preventDefault();
      }
    });
  </script>

  <!-- 🔒 Security Protection 3: CSS Print Shield -->
