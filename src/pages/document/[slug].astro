---
export const prerender = true;
import Layout from "../../layouts/Layout.astro";
import { documents, getDocumentBySlug } from "../../data/documents";

export function getStaticPaths() {
  const paths: { params: { slug: string }; props: { doc: any } }[] = [];
  for (const doc of documents) {
    paths.push({ params: { slug: doc.slug }, props: { doc } });
    if (doc.slug.endsWith('-guide')) {
      paths.push({ params: { slug: doc.slug.replace(/-guide$/, '') }, props: { doc } });
    }
    if (doc.slug === 'uk-pr-stay-guide' || doc.slug === 'uk-pr-stay') {
      paths.push({ params: { slug: 'uk-pr-stay' }, props: { doc } });
      paths.push({ params: { slug: 'uk-pr-stay-guide' }, props: { doc } });
      paths.push({ params: { slug: 'uk-pr-stay-pathway-guide' }, props: { doc } });
    }
    if (doc.slug.includes('uk-care-home')) {
      paths.push({ params: { slug: 'uk-care-home-to-canada-pr-pathway' }, props: { doc } });
      paths.push({ params: { slug: 'uk-care-home-to-canada-pr-pathway-guide' }, props: { doc } });
      paths.push({ params: { slug: 'uk-care-home-to-canada-pr' }, props: { doc } });
      paths.push({ params: { slug: 'uk-care-home-canada-pr' }, props: { doc } });
    }
    if (doc.slug.includes('chevening')) {
      paths.push({ params: { slug: 'chevening-scholarship-guide' }, props: { doc } });
      paths.push({ params: { slug: 'chevening-scholarship' }, props: { doc } });
      paths.push({ params: { slug: 'chevening-scholarship-2027-2028' }, props: { doc } });
      paths.push({ params: { slug: 'chevening-scholarship-2027-2028-guide' }, props: { doc } });
    }
    if (doc.slug.includes('dubai-mibd') || doc.slug.includes('study-in-dubai')) {
      paths.push({ params: { slug: 'study-in-dubai-mibd-guide' }, props: { doc } });
      paths.push({ params: { slug: 'study-in-dubai-mibd' }, props: { doc } });
      paths.push({ params: { slug: 'dubai-mibd-guide' }, props: { doc } });
      paths.push({ params: { slug: 'dubai-mibd-university-guide' }, props: { doc } });
      paths.push({ params: { slug: 'study-in-dubai-guide' }, props: { doc } });
    }
    if (doc.slug.includes('apaar')) {
      paths.push({ params: { slug: 'apaar-id-guide' }, props: { doc } });
      paths.push({ params: { slug: 'apaar-id' }, props: { doc } });
      paths.push({ params: { slug: 'apaar-id-master-guide' }, props: { doc } });
    }
  }
  const uniqueMap = new Map();
  for (const p of paths) {
    if (!uniqueMap.has(p.params.slug)) {
      uniqueMap.set(p.params.slug, p);
    }
  }
  return Array.from(uniqueMap.values());
}

const { slug } = Astro.params;
const { doc: propDoc } = Astro.props;
const doc = propDoc || getDocumentBySlug(slug || "");

if (!doc) {
  return Astro.redirect("/404");
}

// Canonical document URL
const docCanonical = `https://tescavisa.com/document/${doc.slug}`;

// Curated FAQs and Key Highlights per document for AEO, GEO, and Search Engines
const docHighlightsMap: Record<string, { summary: string; bullets: string[]; faqs: { q: string; a: string }[] }> = {
  'nova-scotia-pr-pathway-guide': {
    summary: "Nova Scotia offers dedicated, fast-track provincial nomination streams (NSNP) for international graduates pursuing Continuing Care Assistant (CCA) and Early Childhood Educator (ECE) qualifications.",
    bullets: [
      "Zero prior Canadian work experience required to enroll in approved diploma programs.",
      "Accelerated pathway to Permanent Residency (PR) via Nova Scotia International Graduates in Demand Stream.",
      "High local job placement rates in healthcare facilities and early childhood centers.",
      "Work up to 20+ hours per week while studying, with Post-Graduation Work Permit (PGWP) eligibility upon completion."
    ],
    faqs: [
      {
        q: "What are the eligibility requirements for the Nova Scotia CCA/ECE PR pathway?",
        a: "Applicants need a valid high school diploma (10+2) or bachelor's degree, basic English proficiency (CLB 5 or equivalent IELTS/PTE), and acceptance into a designated Nova Scotia learning institution offering the CCA or ECE curriculum."
      },
      {
        q: "How fast can I obtain Canadian PR through Nova Scotia?",
        a: "Graduates with a full-time job offer in Nova Scotia in NOC 33102 (Nurse Aides/CCA) or NOC 42202 (ECE) can apply for provincial nomination immediately, typically receiving PR approval within 12 to 18 months."
      },
      {
        q: "Can I bring my spouse and children to Nova Scotia?",
        a: "Yes. Qualifying students enrolled in eligible designated diploma courses can support dependent visas, and spouses may qualify for open work permits."
      }
    ]
  },
  'uk-pr-stay-guide': {
    summary: "Comprehensive roadmap for international students and graduates in the UK navigating post-study work (PSW / Graduate Route), sponsorship transitions, Further Leave to Remain (FLR), Fee Waivers, and Indefinite Leave to Remain (ILR).",
    bullets: [
      "2-Year unsponsored work permission under the Graduate Route (3 years for PhD holders).",
      "Strategic steps to transition from Graduate Visa to Skilled Worker or Health and Care Worker sponsorship.",
      "Clear guidance on FLR (FP) family/private life routes and Home Office Fee Waiver applications.",
      "10-year continuous lawful residence pathway to Indefinite Leave to Remain (ILR) and British citizenship."
    ],
    faqs: [
      {
        q: "What should I do before my UK Graduate (PSW) visa expires?",
        a: "You should secure a sponsor-licensed employer for a Skilled Worker Visa, explore switching to a Health & Care visa, look into Global Talent or Innovator Founder visas, or apply for further higher education (Level 7/8)."
      },
      {
        q: "How long does it take to qualify for PR (ILR) in the UK?",
        a: "Most sponsored workers qualify after 5 consecutive years on a Skilled Worker or Scale-up visa. Alternatively, any continuous lawful stay of 10 years across any visas qualifies under the 10-Year Long Residence route."
      }
    ]
  },
  'uk-care-home-to-canada-pr-pathway': {
    summary: "Strategic conversion guide detailing how foreign healthcare workers and care home assistants in the United Kingdom can leverage their experience to obtain Canadian Permanent Residency (PR).",
    bullets: [
      "Convert UK care home experience into high Comprehensive Ranking System (CRS) points.",
      "Eligible for Express Entry Category-Based Healthcare Selections and Provincial Nominee Programs (PNPs).",
      "Direct pathways under British Columbia, Alberta, and Nova Scotia provincial healthcare quotas.",
      "Assistance with Educational Credential Assessment (ECA) and English testing (IELTS General / CELPIP)."
    ],
    faqs: [
      {
        q: "Does UK care home experience count as Canadian skilled work experience?",
        a: "Yes. Experience working in UK care homes under qualifying healthcare NOC/TEER categories is recognized as foreign skilled work experience for Canadian Federal Skilled Worker (FSW) and Category-Based draws."
      },
      {
        q: "Do I need a Canadian job offer to apply from the UK?",
        a: "Not necessarily. Healthcare workers with strong CRS scores or those selected under targeted Express Entry healthcare category draws can receive an Invitation to Apply (ITA) without a Canadian job offer."
      }
    ]
  },
  'chevening-scholarship-guide': {
    summary: "Complete handbook for applying to the prestigious UK Government Chevening Scholarship for the 2027–2028 academic year, covering fully funded 1-year Master's programs.",
    bullets: [
      "100% full university tuition fee coverage at any participating UK university.",
      "Monthly living stipend and return economy airfare included.",
      "Requires an undergraduate degree and a minimum of 2,800 hours of eligible work experience.",
      "Step-by-step breakdown of the 4 critical Chevening application essays."
    ],
    faqs: [
      {
        q: "What expenses does the Chevening Scholarship cover?",
        a: "Chevening covers 100% of university tuition fees, a monthly living allowance, economy return flights to the UK, and cash grants for visa and travel."
      },
      {
        q: "How is the 2,800 hours of work experience calculated?",
        a: "Work experience can be full-time, part-time, voluntary, or paid internships completed prior to the application deadline. 2,800 hours is roughly equivalent to two years of full-time work."
      }
    ]
  },
  'study-in-dubai-mibd-guide': {
    summary: "Admissions and visa blueprint for MIBD University in Dubai (UAE), highlighting affordable international tuition, English-medium pathways, study gap acceptance, and student work rights.",
    bullets: [
      "Direct admissions without mandatory IELTS or PTE test score requirements.",
      "Acceptance of study gaps up to 5 to 8+ years with valid work experience records.",
      "Level 4 & 5 International Diplomas with seamless top-up pathways to UK, European, and Australian universities.",
      "Legal part-time work rights and 1 to 2 year UAE student residence visas."
    ],
    faqs: [
      {
        q: "Can I study in Dubai at MIBD without taking IELTS?",
        a: "Yes. Students whose prior medium of instruction was English or who pass an internal university assessment are eligible for direct admission without IELTS or PTE."
      },
      {
        q: "Can international students work while studying in Dubai?",
        a: "Yes. International students in Dubai can work part-time (up to 20 hours per week during term and full-time during breaks) with a student work permit."
      }
    ]
  },
  'apaar-id-guide': {
    summary: "Official guide to creating, linking, and using the APAAR ID (Automated Permanent Academic Account Registry) and Academic Bank of Credits (ABC) via DigiLocker for overseas education verification.",
    bullets: [
      "12-digit permanent digital academic identifier recognized nationwide across India.",
      "Seamless digital transcript verification for international university admissions and credential evaluations (WES, IQAS).",
      "Instant linkage to DigiLocker and the Academic Bank of Credits (ABC).",
      "Prevents document forgery and eliminates physical courier delays for foreign visa authorities."
    ],
    faqs: [
      {
        q: "What is APAAR ID and why is it important for study abroad?",
        a: "APAAR ID (One Nation One Student ID) digitally consolidates all degrees, diplomas, and marks cards. Overseas universities and credential evaluation agencies use it to instantly verify academic authenticity."
      },
      {
        q: "How do I create an APAAR ID?",
        a: "Students can generate their APAAR ID through the DigiLocker portal or the ABC.gov.in website using their Aadhaar number and educational institute enrollment details."
      }
    ]
  }
};

const currentHighlights = docHighlightsMap[doc.slug] || {
  summary: doc.description,
  bullets: [
    "Official requirements, eligibility checklist, and step-by-step milestones.",
    "Verified fee structures, deadlines, and documentation guidelines.",
    "Expert tips from TESCA's licensed study abroad and visa consulting team."
  ],
  faqs: [
    {
      q: `How can TESCA Visa Consultancy help me with ${doc.title}?`,
      a: "TESCA provides 1-on-1 profile assessment, document review, university admission guidance, and complete visa filing support with a 97% visa success rate."
    }
  ]
};

// Structured Schema.org for Google, Perplexity, ChatGPT & AI Answer Engines (AEO/GEO)
const docStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "DigitalDocument",
    "name": doc.title,
    "headline": doc.title,
    "description": doc.description,
    "url": docCanonical,
    "fileFormat": "application/pdf",
    "inLanguage": "en",
    "author": {
      "@type": "Organization",
      "name": doc.author || "TESCA Visa Consultancy",
      "url": "https://tescavisa.com"
    },
    "publisher": {
      "@type": "EducationalOrganization",
      "name": "TESCA Visa Consultancy",
      "url": "https://tescavisa.com",
      "logo": "https://tescavisa.com/images/Tesca_logo.png"
    },
    "datePublished": "2026-01-01",
    "dateModified": "2026-09-09",
    "about": (doc.tags || []).map((t: string) => ({ "@type": "Thing", "name": t }))
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": currentHighlights.faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": {
        "@type": "Answer",
        "text": f.a
      }
    }))
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://tescavisa.com"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Guides & Documents",
        "item": "https://tescavisa.com/services"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": doc.title,
        "item": docCanonical
      }
    ]
  }
];

// Related documents to recommend at bottom
const relatedDocs = documents.filter(d => d.slug !== doc.slug).slice(0, 3);
const whatsappPrefill = encodeURIComponent(`Hi TESCA, I was reading the ${doc.title} and want to check my eligibility.`);
