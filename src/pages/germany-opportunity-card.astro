---
export const prerender = true;
import Layout from "../layouts/Layout.astro";
import AICounsellor from "../components/AICounsellor";

const SVG = {
  ArrowLeft: `<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="inline-block"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>`
};
---

<Layout 
  title="Germany Opportunity Card Consultant India | Points Calculator"
  description="Check your Chancenkarte eligibility using our Germany Opportunity Card points calculator. We are India's leading consultant for German job seeker visas."
>
  <section class="max-w-7xl mx-auto px-6 md:px-8 pt-8 pb-16 text-left">
    
    <a href="/" class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent-blue hover:underline mb-8 font-sans">
      <span set:html={SVG.ArrowLeft} /> Back to Home
    </a>

    <div class="glass-card rounded-[2.5rem] overflow-hidden bg-slate-50/80 border border-slate-200/60 shadow-lg p-8 md:p-12 relative mb-12">
      <div class="aurora-bg w-[300px] h-[300px] bg-accent-blue/5 -top-12 -left-12 rounded-full blur-[80px]"></div>
      
      <div class="max-w-3xl space-y-6 relative z-10 font-sans">
        <span class="inline-block text-xs font-semibold tracking-wider text-slate-800 bg-accent-blue/10 px-4 py-1.5 rounded-full border border-accent-blue/20 uppercase">
          Specialized Visas
        </span>
        <h1 class="text-[36px] sm:text-[48px] lg:text-[56px] font-extrabold font-display text-support-white tracking-tight leading-none">
          Germany Opportunity Card Consultant
        </h1>
        <p class="text-base md:text-[18px] text-support-gray font-normal leading-relaxed">
          Germany's new points-based system allows skilled professionals from India to live and seek employment in Germany for up to 1 year. Use our Chancenkarte points calculator and consult with our expert Germany Opportunity Card consultant in India.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- Interactive Points Calculator Widget (7 cols) -->
      <div class="lg:col-span-7 p-6 md:p-8 rounded-3xl border border-slate-200/80 bg-white shadow-md space-y-6 font-sans">
        <div>
          <h2 class="text-xl font-bold font-display text-slate-850">Chancenkarte Points Calculator</h2>
          <p class="text-xs text-slate-500 mt-1">Select your qualifications below. You need a minimum of <strong>6 points</strong> to qualify.</p>
        </div>

        <form id="chancenkarte-form" class="space-y-6 text-sm text-slate-700">
          
          <!-- Age Group -->
          <div class="space-y-2">
            <label class="block font-bold text-slate-800">1. Age group</label>
            <select id="calc-age" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-accent-blue">
              <option value="2">Up to 35 years old (+2 points)</option>
              <option value="1">35 to 40 years old (+1 point)</option>
              <option value="0">Over 40 years old (+0 points)</option>
            </select>
          </div>

          <!-- Professional Experience -->
          <div class="space-y-2">
            <label class="block font-bold text-slate-800">2. Professional Experience</label>
            <select id="calc-exp" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-accent-blue">
              <option value="3">5+ years experience in last 7 years (+3 points)</option>
              <option value="2">2+ years experience in last 5 years (+2 points)</option>
              <option value="0">Less than 2 years experience (+0 points)</option>
            </select>
          </div>

          <!-- Language Proficiency -->
          <div class="space-y-2">
            <label class="block font-bold text-slate-800">3. Language Proficiency</label>
            <select id="calc-lang" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-accent-blue">
              <option value="3">German B1 or higher (+3 points)</option>
              <option value="2">German A2 (+2 points)</option>
              <option value="1">German A1 or English B2 (+1 point)</option>
              <option value="0">None of the above (+0 points)</option>
            </select>
          </div>

          <!-- Qualification Recognition -->
          <div class="space-y-2">
            <label class="block font-bold text-slate-800">4. Foreign Degree Recognition</label>
            <select id="calc-deg" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-2.5 focus:outline-none focus:border-accent-blue">
              <option value="4">Fully recognized foreign degree (+4 points)</option>
              <option value="2">Partially recognized / H+ database listing (+2 points)</option>
              <option value="0">Unrecognized degree (+0 points)</option>
            </select>
          </div>

          <!-- Previous Stay in Germany -->
          <div class="space-y-2">
            <label class="block font-bold text-slate-800">5. Previous German Stay (min. 6 months in last 5 years)</label>
            <div class="flex gap-4">
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="calc-stay" value="1" class="w-4 h-4 text-accent-blue" />
                <span>Yes (+1 point)</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer">
                <input type="radio" name="calc-stay" value="0" checked class="w-4 h-4 text-accent-blue" />
                <span>No (+0 points)</span>
              </label>
            </div>
          </div>

          <!-- Result box -->
          <div id="calc-result" class="p-6 rounded-2xl bg-gradient-to-br from-slate-50 to-blue-50/50 border border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
              <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest block">Your Estimated Score</span>
              <span id="score-display" class="text-4xl font-extrabold font-display text-accent-blue">10 / 14</span>
            </div>
            <div class="text-right">
              <span id="status-display" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-100 border border-emerald-300 text-emerald-800 shadow-xs">
                Eligible to Apply (6+ Points) ✓
              </span>
            </div>
          </div>

          <!-- High-Converting Lead Magnet: Get Chancenkarte Checklist on WhatsApp -->
          <div id="chancenkarte-lead-box" class="p-6 rounded-2xl bg-gradient-to-br from-emerald-500/10 via-teal-500/5 to-transparent border border-emerald-500/30 space-y-4">
            <div class="space-y-1">
              <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-600/15 text-emerald-700 text-[11px] font-bold uppercase tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Instant Free Checklist
              </div>
              <h3 class="text-base font-bold text-slate-800 font-display">
                Get Your Official German Chancenkarte Checklist on WhatsApp
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Includes ANABIN H+ degree recognition verification, €1,027/mo blocked account options, and embassy appointment roadmap.
              </p>
            </div>

            <div id="chancenkarte-form-fields" class="space-y-3">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <input 
                  type="text" 
                  id="ck-lead-name" 
                  placeholder="Your Full Name *" 
                  required
                  class="w-full px-3.5 py-2.5 bg-white border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
                />
                <div class="flex gap-1.5">
                  <span class="inline-flex items-center px-3 py-2.5 bg-slate-100 border border-slate-200 rounded-xl text-xs font-bold text-slate-700 shrink-0">
                    🇮🇳 +91
                  </span>
                  <input 
                    type="tel" 
                    id="ck-lead-phone" 
                    placeholder="WhatsApp Number *" 
                    maxlength="10"
                    required
                    class="w-full px-3.5 py-2.5 bg-white border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 placeholder-slate-400 focus:outline-none focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500"
                  />
                </div>
              </div>

              <div id="ck-feedback" class="hidden text-xs font-semibold p-2.5 rounded-xl text-center"></div>

              <button 
                type="button" 
                id="ck-submit-lead-btn"
                class="w-full py-3 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs sm:text-sm shadow-md shadow-emerald-600/20 hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer border-none"
              >
                <span>📲 Send My Checklist & Roadmap to WhatsApp</span>
              </button>
            </div>

            <!-- Alternative helper for low points -->
            <div id="ck-low-points-box" class="hidden pt-2 border-t border-slate-200/60">
              <p class="text-xs text-amber-700 font-semibold mb-2">
                Need to reach 6 points? Chat with our German visa specialists to add points via language or job offers:
              </p>
              <a 
                href="https://wa.me/919824152731?text=Hi%20TESCA,%20I%20used%20the%20Chancenkarte%20calculator%20and%20need%20help%20boosting%20my%20points%20to%20qualify%20for%20Germany." 
                target="_blank" 
                rel="noopener noreferrer" 
                data-direct-wa="true"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 hover:underline"
              >
                <span>💬 Chat on WhatsApp for Point-Boosting Advice &rarr;</span>
              </a>
            </div>
          </div>

        </form>
      </div>

      <!-- Right column Details and CTA (5 cols) -->
      <div class="lg:col-span-5 space-y-6 font-sans">
        <div class="p-8 rounded-3xl bg-slate-50 border border-slate-200/50 shadow-sm space-y-4 text-slate-650 text-sm">
          <h3 class="text-lg font-bold font-display text-slate-800">Key Chancenkarte Facts</h3>
          <ul class="space-y-3 list-disc pl-5">
            <li>Must hold an academic degree or vocational qualification.</li>
            <li>Allows you to work up to 20 hours per week in trial employment while looking for a permanent role.</li>
            <li>Requires a Blocked Account or sponsorship guarantee of at least €1,027/month to cover living costs.</li>
          </ul>
        </div>

        <div class="glass-card rounded-[2rem] p-6 bg-gradient-to-br from-indigo-50/50 to-white border border-indigo-100 shadow-md space-y-6">
          <div class="space-y-2">
            <h3 class="text-xl font-bold text-slate-800 font-display tracking-tight">Need a Germany Job Seeker Visa?</h3>
            <p class="text-xs text-slate-500 leading-relaxed">
              Book a profiling audit to verify your degree recognition on ANABIN and prepare your blocking account dossier.
            </p>
          </div>
          
          <div class="space-y-2.5">
            <a 
              href="https://wa.me/919824152731?text=Hi%20TESCA,%20I%20want%20to%20apply%20for%20the%20Germany%20Opportunity%20Card%20(Chancenkarte).%20Please%20guide%20me%20on%20ANABIN%20verification." 
              target="_blank"
              rel="noopener noreferrer"
              data-direct-wa="true"
              class="w-full py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm rounded-xl shadow-md shadow-emerald-600/20 transition-all duration-200 text-center cursor-pointer tracking-wide flex items-center justify-center gap-2 no-underline"
            >
              <span>💬 Fast Track on WhatsApp</span>
            </a>
            <button 
              type="button" 
              onclick="window.dispatchEvent(new CustomEvent('open-counsellor-form'))"
              class="w-full py-3 bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm rounded-xl shadow-md transition-all duration-200 text-center cursor-pointer tracking-wide block"
            >
              Book In-Person / Video Consultation
            </button>
          </div>
        </div>
      </div>

    </div>

  </section>

  <!-- Interactive script to handle calculations & lead capture -->
  <script is:inline>
    let currentScore = 10;

    function calculatePoints() {
      const ageVal = Number(document.getElementById('calc-age')?.value) || 0;
      const expVal = Number(document.getElementById('calc-exp')?.value) || 0;
      const langVal = Number(document.getElementById('calc-lang')?.value) || 0;
      const degVal = Number(document.getElementById('calc-deg')?.value) || 0;
      
      const stayRadio = document.querySelector('input[name="calc-stay"]:checked');
      const stayVal = stayRadio ? Number(stayRadio.value) : 0;

      const total = ageVal + expVal + langVal + degVal + stayVal;
      currentScore = total;

      const scoreEl = document.getElementById('score-display');
      const statusEl = document.getElementById('status-display');
      const lowPointsBox = document.getElementById('ck-low-points-box');

      if (scoreEl) scoreEl.textContent = `${total} / 14`;

      if (statusEl) {
        if (total >= 6) {
          statusEl.textContent = "Eligible to Apply (6+ Points) ✓";
          statusEl.className = "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-emerald-100 border border-emerald-300 text-emerald-800 shadow-xs";
          if (lowPointsBox) lowPointsBox.classList.add('hidden');
        } else {
          statusEl.textContent = "Not Eligible Yet (< 6 Points)";
          statusEl.className = "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-amber-100 border border-amber-300 text-amber-800 shadow-xs";
          if (lowPointsBox) lowPointsBox.classList.remove('hidden');
        }
      }
    }

    function initCalculator() {
      const form = document.getElementById('chancenkarte-form');
      if (form) {
        form.addEventListener('change', calculatePoints);
        calculatePoints();
      }

      const submitLeadBtn = document.getElementById('ck-submit-lead-btn');
      const nameInput = document.getElementById('ck-lead-name');
      const phoneInput = document.getElementById('ck-lead-phone');
      const feedback = document.getElementById('ck-feedback');

      if (submitLeadBtn && !submitLeadBtn.dataset.bound) {
        submitLeadBtn.dataset.bound = "true";
        submitLeadBtn.addEventListener('click', async () => {
          const name = nameInput?.value?.trim() || "";
          const rawPhone = phoneInput?.value?.trim() || "";
          const phoneDigits = rawPhone.replace(/\D/g, "");

          if (!name) {
            if (feedback) {
              feedback.className = "text-xs font-semibold p-2.5 rounded-xl text-center bg-rose-50 text-rose-700 border border-rose-200 block";
              feedback.textContent = "Please enter your full name.";
            }
            nameInput?.focus();
            return;
          }

          if (phoneDigits.length < 10) {
            if (feedback) {
              feedback.className = "text-xs font-semibold p-2.5 rounded-xl text-center bg-rose-50 text-rose-700 border border-rose-200 block";
              feedback.textContent = "Please enter a valid 10-digit WhatsApp number.";
            }
            phoneInput?.focus();
            return;
          }

          const fullPhone = `+91 ${phoneDigits}`;
          submitLeadBtn.disabled = true;
          submitLeadBtn.textContent = "Sending & Preparing Checklist...";

          const payload = {
            name: name,
            phone: fullPhone,
            lead_type: 'germany_opportunity_card',
            source: 'Germany Opportunity Card Points Calculator',
            subject: `Chancenkarte Assessment: ${name} (${currentScore}/14 Points)`,
            category: 'germany',
            message: `User calculated Chancenkarte score: ${currentScore}/14 points. Name: ${name}. Phone: ${fullPhone}. Page: ${window.location.href}`
          };

          try {
            if (navigator.sendBeacon) {
              const blob = new Blob([JSON.stringify(payload)], { type: 'application/json' });
              navigator.sendBeacon('/api/contact', blob);
            } else {
              fetch('/api/contact', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload),
                keepalive: true
              }).catch(() => {});
            }

            if (window.posthog) {
              window.posthog.capture('germany_chancenkarte_lead', {
                name: name,
                score: currentScore,
                phone: fullPhone
              }, { transport: 'sendBeacon' });
            }

            if (window.trackLeadEvent) {
              window.trackLeadEvent('counsellor', { lead_channel: 'germany_chancenkarte', score: currentScore });
            }

            if (feedback) {
              feedback.className = "text-xs font-semibold p-2.5 rounded-xl text-center bg-emerald-50 text-emerald-700 border border-emerald-200 block";
              feedback.textContent = "✓ Success! Opening WhatsApp with your personalized checklist...";
            }

            const waText = encodeURIComponent(`Hi TESCA, I am ${name}. I calculated my Germany Opportunity Card (Chancenkarte) score as ${currentScore}/14 points on your website and qualify. Please share the official document checklist and ANABIN degree verification process.`);
            const waUrl = `https://wa.me/919824152731?text=${waText}`;

            setTimeout(() => {
              window.open(waUrl, '_blank', 'noopener,noreferrer');
              submitLeadBtn.disabled = false;
              submitLeadBtn.textContent = "Checklist Sent ✓ Open WhatsApp Again";
            }, 600);

          } catch (e) {
            submitLeadBtn.disabled = false;
            submitLeadBtn.textContent = "📲 Send My Checklist to WhatsApp";
            const waUrl = `https://wa.me/919824152731?text=Hi%20TESCA,%20I%20am%20${encodeURIComponent(name)}%20and%20scored%20${currentScore}/14%20points%20for%20the%20Germany%20Opportunity%20Card.`;
            window.open(waUrl, '_blank', 'noopener,noreferrer');
          }
        });
      }
    }

    document.addEventListener('DOMContentLoaded', initCalculator);
    document.addEventListener('astro:page-load', initCalculator);
  </script>

  <AICounsellor client:only="react" />
</Layout>
