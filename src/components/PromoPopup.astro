---
// PromoPopup.astro
// Clean Poster Image Popup (Type 1: Custom Link Redirect, Type 2: Lead Submission Page Redirect) & Drawer
import { supabase } from "../utils/supabase";

let activePopups: any[] = [];
try {
  const { data } = await supabase
    .from('popup_settings')
    .select('*')
    .eq('is_active', true)
    .order('id', { ascending: false });

  activePopups = data && data.length > 0 ? data : [];
} catch (e) {
  activePopups = [];
}

// Fallback popup if DB returns empty list
const defaultPopup = {
  id: "default-china-visa",
  title: "China Business (M) Visa & Canton Fair 2026",
  subtitle: "Heading to Guangzhou, Shanghai or Canton Fair? Get 4-5 Day Express Processing with 100% Visa Approval Guarantee & Zero Risk!",
  image_url: null,
  delay_seconds: 5,
  button_text: "Apply China Visa Now",
  link_url: "/china-business-visa",
  redirect_to_link: true,
  lead_capture_enabled: false
};

const popupsList = activePopups.length > 0 ? activePopups : [defaultPopup];
const initialPopup = popupsList[0];
const delaySeconds = initialPopup?.delay_seconds || 5;
---

<!-- 1. Main Screen Center Modal Popup Overlay (Clean Image Poster Display) -->
<div
  id="promo-popup-overlay"
  class="hidden fixed inset-0 z-[9999] bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-3 sm:p-6 transition-all duration-300 select-none overflow-y-auto"
  data-delay={delaySeconds}
  data-total={popupsList.length}
>
  <div
    id="promo-popup-card"
    class="relative bg-transparent w-full max-w-lg rounded-3xl shadow-2xl flex flex-col transform scale-95 opacity-0 transition-all duration-300 overflow-hidden text-left my-auto"
  >
    {/* Close Button */}
    <button
      type="button"
      id="promo-popup-close"
      class="absolute top-3.5 right-3.5 z-50 p-2 bg-slate-900/85 hover:bg-slate-900 text-white rounded-full transition-all cursor-pointer shadow-lg hover:scale-110 border border-white/20"
      aria-label="Close popup"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>

    {/* Previous < and Next > Navigation Arrows (Shown when more than 1 active popup) */}
    {popupsList.length > 1 && (
      <>
        <button
          type="button"
          id="promo-popup-prev"
          class="absolute left-3 top-1/2 -translate-y-1/2 z-50 p-2.5 bg-slate-900/85 hover:bg-slate-900 text-white rounded-full transition-all cursor-pointer shadow-2xl hover:scale-110 border border-white/30 flex items-center justify-center"
          aria-label="Previous popup"
          title="Previous Offer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </button>
        <button
          type="button"
          id="promo-popup-next"
          class="absolute right-3 top-1/2 -translate-y-1/2 z-50 p-2.5 bg-slate-900/85 hover:bg-slate-900 text-white rounded-full transition-all cursor-pointer shadow-2xl hover:scale-110 border border-white/30 flex items-center justify-center"
          aria-label="Next popup"
          title="Next Offer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        </button>

        {/* Slide Counter Badge */}
        <div class="absolute top-3.5 left-3.5 z-50 px-3 py-1 bg-slate-900/85 backdrop-blur-md text-white text-[11px] font-extrabold rounded-full border border-white/20 shadow-md">
          <span id="promo-slide-current">1</span> / <span>{popupsList.length}</span>
        </div>
      </>
    )}

    {/* Popup Slides Container */}
    <div id="promo-slides-container" class="relative w-full">
      {popupsList.map((popup, idx) => {
        const title = popup.title || "Special Offer";
        const subtitle = popup.subtitle || "";
        const imageUrl = popup.image_url || null;
        const buttonText = popup.button_text || "Apply Now";

        // Determine destination link for image click:
        // Type 1 (redirect_to_link): Custom link URL
        // Type 2 (detail submission page): link_url if provided, else fallback to /china-business-visa
        const targetUrl = popup.link_url && popup.link_url.trim().length > 0
          ? popup.link_url
          : "/check-eligibility";

        return (
          <div
            id={`promo-slide-${idx}`}
            class={`promo-slide-item w-full transition-all duration-300 ${idx === 0 ? 'block' : 'hidden'}`}
            data-index={idx}
            data-title={title}
            data-subtitle={subtitle}
            data-button={buttonText}
            data-link={targetUrl}
          >
            {imageUrl ? (
              /* Clean Image Only Mode (Clicking image redirects to target page/form) */
              <div class="bg-slate-950 rounded-3xl overflow-hidden shadow-2xl border border-slate-700/80 p-1 sm:p-1.5">
                <a
                  href={targetUrl}
                  class="block relative w-full overflow-hidden group cursor-pointer"
                  title={`Click to view ${title}`}
                >
                  <img
                    src={imageUrl}
                    alt={title}
                    class="w-full h-auto max-h-[80vh] object-contain rounded-2xl shadow-xl block mx-auto hover:scale-[1.01] transition-transform duration-300"
                  />
                </a>
              </div>
            ) : (
              /* Fallback Text Card Mode (Only if no photo is uploaded) */
              <div class="bg-white rounded-3xl overflow-hidden shadow-2xl border border-slate-200/90 p-6 space-y-4">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-600 text-white text-xs font-extrabold uppercase tracking-wider shadow-sm shadow-red-500/30">
                    🔥 Special Offer
                  </span>
                  <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-extrabold border border-emerald-200/60">
                    🛡️ No Visa No Payment
                  </span>
                </div>

                <div>
                  <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight leading-snug">
                    {title}
                  </h3>
                  {subtitle && (
                    <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
                      {subtitle}
                    </p>
                  )}
                </div>

                <div class="grid grid-cols-2 gap-2.5 pt-1">
                  <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs font-bold text-slate-700 flex items-center gap-2">
                    <span class="text-emerald-600 font-extrabold text-sm">✓</span> No Visa, No Payment
                  </div>
                  <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs font-bold text-slate-700 flex items-center gap-2">
                    <span class="text-amber-600 font-extrabold text-sm">⚡</span> 4-5 Day Express
                  </div>
                </div>

                <div class="pt-2 flex items-center gap-3">
                  <a
                    href={targetUrl}
                    class="flex-1 py-3.5 px-6 rounded-2xl bg-gradient-to-r from-red-600 to-amber-600 hover:from-red-700 hover:to-amber-700 text-white font-extrabold text-xs sm:text-sm shadow-xl shadow-red-500/25 text-center transition-all hover:scale-[1.02] active:scale-[0.98]"
                  >
                    {buttonText}
                  </a>
                  <a
                    href="https://wa.me/919824152731?text=Hi%20TESCA,%20I%20want%20info"
                    target="_blank"
                    rel="noreferrer"
                    class="p-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white transition-all shadow-lg shrink-0 flex items-center justify-center hover:scale-105"
                    title="Instant WhatsApp Chat"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-0.999 3.648 3.742-.981z"/>
                    </svg>
                  </a>
                </div>
              </div>
            )}
          </div>
        );
      })}
    </div>
  </div>
</div>

<!-- 2. Floating Bottom Smart Drawer Popup (Persistent Access) -->
<div
  id="promo-drawer-overlay"
  class="fixed inset-x-4 bottom-24 md:bottom-6 md:right-6 md:left-auto z-[99] max-w-full md:max-w-[420px] pointer-events-none transition-all duration-500 ease-out select-none"
>
  <div
    id="promo-drawer-card"
    class="relative bg-white/95 backdrop-blur-xl w-full rounded-3xl p-4 md:p-5 shadow-2xl border border-slate-200/90 flex flex-col transform translate-y-12 opacity-0 pointer-events-auto transition-all duration-500 ease-out overflow-hidden"
  >
    {/* Drawer Close Button */}
    <button
      type="button"
      id="promo-drawer-close"
      class="absolute top-3.5 right-3.5 z-50 p-1.5 bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-900 rounded-full transition-all cursor-pointer hover:scale-110"
      aria-label="Close drawer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>

    {/* Drawer Header Badges */}
    <div class="flex items-center justify-between gap-2 mb-2 pr-8">
      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-red-600 text-white text-[10px] font-extrabold uppercase tracking-wider">
        🔥 Trending Promo
      </span>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-extrabold">
        🛡️ No Visa No Payment
      </span>
    </div>

    <div class="space-y-2 text-left">
      <h4 id="drawer-title" class="text-sm md:text-base font-extrabold text-slate-900 tracking-tight leading-snug">
        {initialPopup.title || "Special Offer"}
      </h4>
      <p id="drawer-subtitle" class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
        {initialPopup.subtitle || ""}
      </p>

      <div class="pt-2 flex items-center gap-2">
        <a
          id="drawer-action-link"
          href={initialPopup.link_url || "/check-eligibility"}
          class="flex-1 py-2.5 px-4 rounded-xl bg-gradient-to-r from-red-600 to-amber-600 text-white font-bold text-xs text-center shadow-md hover:scale-[1.01] transition-all"
        >
          {initialPopup.button_text || "Apply Now"}
        </a>
        <button
          type="button"
          id="reopen-main-popup-btn"
          class="px-3 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200 shrink-0 transition-all cursor-pointer"
        >
          View Poster
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let popupTimer: ReturnType<typeof setTimeout> | null = null;
  let currentSlideIndex = 0;

  function isAdminOrExcludedPath() {
    const path = window.location.pathname.toLowerCase();
    const host = window.location.hostname.toLowerCase();
    return (
      path.startsWith("/admin") ||
      host.startsWith("admin.") ||
      path.includes("review-generator") ||
      path.startsWith("/documents") ||
      path.startsWith("/promo")
    );
  }

  function initPromoPopups() {
    if (popupTimer) {
      clearTimeout(popupTimer);
      popupTimer = null;
    }

    if (isAdminOrExcludedPath()) return;

    const mainOverlay = document.getElementById("promo-popup-overlay");
    const mainCard = document.getElementById("promo-popup-card");
    const mainCloseBtn = document.getElementById("promo-popup-close");

    const drawerCard = document.getElementById("promo-drawer-card");
    const drawerCloseBtn = document.getElementById("promo-drawer-close");
    const reopenBtn = document.getElementById("reopen-main-popup-btn");

    const prevBtn = document.getElementById("promo-popup-prev");
    const nextBtn = document.getElementById("promo-popup-next");

    if (!mainOverlay || !mainCard) return;

    const delaySec = Number(mainOverlay.getAttribute("data-delay")) || 5;
    const urlParams = new URLSearchParams(window.location.search);
    const isTestMode = urlParams.get("test-popup") === "true";

    const slides = document.querySelectorAll(".promo-slide-item");

    const goToSlide = (idx: number) => {
      if (!slides || slides.length === 0) return;
      const total = slides.length;
      currentSlideIndex = (idx + total) % total;

      slides.forEach((slide, i) => {
        if (i === currentSlideIndex) {
          slide.classList.remove("hidden");
        } else {
          slide.classList.add("hidden");
        }
      });

      const currentBadge = document.getElementById("promo-slide-current");
      if (currentBadge) {
        currentBadge.innerText = (currentSlideIndex + 1).toString();
      }

      // Sync drawer with active slide
      const activeSlide = slides[currentSlideIndex] as HTMLElement | null;
      if (activeSlide) {
        const title = activeSlide.getAttribute("data-title") || "";
        const subtitle = activeSlide.getAttribute("data-subtitle") || "";
        const link = activeSlide.getAttribute("data-link") || "";
        const button = activeSlide.getAttribute("data-button") || "";

        const drawerTitle = document.getElementById("drawer-title");
        const drawerSub = document.getElementById("drawer-subtitle");
        const drawerLink = document.getElementById("drawer-action-link") as HTMLAnchorElement | null;

        if (drawerTitle) drawerTitle.innerText = title;
        if (drawerSub) drawerSub.innerText = subtitle;
        if (drawerLink) {
          drawerLink.href = link;
          drawerLink.innerText = button;
        }
      }
    };

    if (prevBtn) prevBtn.onclick = () => goToSlide(currentSlideIndex - 1);
    if (nextBtn) nextBtn.onclick = () => goToSlide(currentSlideIndex + 1);

    const showDrawer = () => {
      if (!drawerCard) return;
      const lastDrawerClosed = sessionStorage.getItem("promo_drawer_closed_at");
      if (lastDrawerClosed && !isTestMode) return;
      drawerCard.classList.remove("translate-y-12", "opacity-0", "pointer-events-none");
      drawerCard.classList.add("translate-y-0", "opacity-100");
    };

    const closeDrawer = () => {
      sessionStorage.setItem("promo_drawer_closed_at", Date.now().toString());
      if (drawerCard) {
        drawerCard.classList.remove("translate-y-0", "opacity-100");
        drawerCard.classList.add("translate-y-12", "opacity-0", "pointer-events-none");
      }
    };

    if (drawerCloseBtn) drawerCloseBtn.onclick = closeDrawer;

    const showMainPopup = () => {
      mainOverlay.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      requestAnimationFrame(() => {
        mainCard.classList.remove("scale-95", "opacity-0");
        mainCard.classList.add("scale-100", "opacity-100");
      });
    };

    const closeMainPopup = () => {
      sessionStorage.setItem("main_popup_closed_at", Date.now().toString());
      mainCard.classList.remove("scale-100", "opacity-100");
      mainCard.classList.add("scale-95", "opacity-0");
      document.body.style.overflow = "";
      setTimeout(() => {
        mainOverlay.classList.add("hidden");
        showDrawer();
      }, 300);
    };

    if (mainCloseBtn) mainCloseBtn.onclick = closeMainPopup;
    mainOverlay.onclick = (e) => {
      if (e.target === mainOverlay) closeMainPopup();
    };

    if (reopenBtn) {
      reopenBtn.onclick = () => {
        showMainPopup();
      };
    }

    // Keyboard Arrow Navigation
    window.onkeydown = (e) => {
      if (mainOverlay && !mainOverlay.classList.contains("hidden")) {
        if (e.key === "ArrowLeft") goToSlide(currentSlideIndex - 1);
        if (e.key === "ArrowRight") goToSlide(currentSlideIndex + 1);
      }
    };

    // Trigger main screen popup after delaySec seconds
    popupTimer = setTimeout(() => {
      if (isAdminOrExcludedPath()) return;

      const currentClosed = sessionStorage.getItem("main_popup_closed_at");
      if (currentClosed && !isTestMode) {
        const elapsed = Date.now() - parseInt(currentClosed, 10);
        if (elapsed < 3 * 60 * 1000) {
          showDrawer();
          return;
        }
      }

      showMainPopup();
    }, delaySec * 1000);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPromoPopups);
  } else {
    initPromoPopups();
  }

  document.addEventListener("astro:page-load", () => {
    initPromoPopups();
  });
</script>
