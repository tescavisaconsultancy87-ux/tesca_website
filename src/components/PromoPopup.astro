---
// PromoPopup.astro
// Includes both Main Screen Big Poster Image Popup & Persistent Floating Bottom Drawer
import { supabase } from "../utils/supabase";

let activePopup: any = null;
try {
  const { data } = await supabase
    .from('popup_settings')
    .select('*')
    .eq('is_active', true)
    .order('id', { ascending: false })
    .limit(1)
    .maybeSingle();

  activePopup = data || null;
} catch (e) {
  activePopup = null;
}

const title = activePopup?.title || "China Business (M) Visa & Canton Fair 2026";
const subtitle = activePopup?.subtitle || "Heading to Guangzhou, Shanghai or Canton Fair? Get 4-5 Day Express Processing with 100% Visa Approval Guarantee & Zero Risk!";
const imageUrl = activePopup?.image_url || null;
const delaySeconds = activePopup?.delay_seconds || 5;
const buttonText = activePopup?.button_text || "Apply China Visa Now";
const linkUrl = activePopup?.link_url || "/china-business-visa";
const leadCapture = activePopup?.lead_capture_enabled ?? false;
---

<!-- 1. Main Screen Center Modal Popup Overlay (Big Poster Image Display) -->
<div
  id="promo-popup-overlay"
  class="hidden fixed inset-0 z-[9999] bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-3 sm:p-6 transition-all duration-300 select-none overflow-y-auto"
  data-delay={delaySeconds}
>
  <div
    id="promo-popup-card"
    class="relative bg-transparent w-full max-w-lg rounded-3xl shadow-2xl flex flex-col transform scale-95 opacity-0 transition-all duration-300 overflow-hidden text-left my-auto"
  >
    {/* Close Button */}
    <button
      type="button"
      id="promo-popup-close"
      class="absolute top-3.5 right-3.5 z-50 p-2 bg-slate-900/85 hover:bg-slate-900 text-white rounded-full transition-all cursor-pointer shadow-lg hover:scale-110 border border-white/20"
      aria-label="Close popup"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>

    {/* Poster Image Mode (Big Size, 100% Uncropped, No redundant text under image) */}
    {imageUrl ? (
      <div class="bg-white rounded-3xl overflow-hidden shadow-2xl border border-slate-200/90">
        <a href={linkUrl} class="block relative w-full overflow-hidden bg-slate-950 p-1.5 sm:p-2 group">
          <img
            src={imageUrl}
            alt={title}
            class="w-full h-auto max-h-[75vh] object-contain rounded-2xl shadow-xl block mx-auto hover:scale-[1.01] transition-transform duration-300"
          />
        </a>

        {leadCapture && (
          <div class="p-5 bg-white space-y-3">
            <form id="popup-lead-form">
              <div id="popup-form-fields" class="space-y-3">
                <input type="text" name="name" required placeholder="Full Name (As in Passport)" class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:border-red-500 focus:bg-white transition-all" />
                <input type="tel" name="phone" required pattern="[0-9]{10}" placeholder="WhatsApp Mobile No." class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:border-red-500 focus:bg-white transition-all" />
                <button type="submit" id="popup-submit-btn" class="w-full py-3 px-5 rounded-2xl bg-gradient-to-r from-red-600 to-amber-600 hover:from-red-700 hover:to-amber-700 text-white font-extrabold text-xs sm:text-sm shadow-xl shadow-red-500/25 transition-all cursor-pointer hover:scale-[1.01]">
                  {buttonText}
                </button>
              </div>
              <div id="popup-form-success" class="hidden p-4 bg-emerald-50 border border-emerald-200 rounded-2xl text-emerald-800 text-xs font-bold text-center space-y-1">
                <p>✓ Application Submitted Successfully!</p>
                <p class="font-normal text-emerald-700">Our team will call you within 30 minutes.</p>
              </div>
            </form>
          </div>
        )}
      </div>
    ) : (
      /* Fallback Text Card if no poster image uploaded */
      <div class="bg-white rounded-3xl overflow-hidden shadow-2xl border border-slate-200/90 p-6 space-y-4">
        <div class="flex items-center gap-2 flex-wrap">
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-red-600 text-white text-xs font-extrabold uppercase tracking-wider shadow-sm shadow-red-500/30">
            🔥 Special Offer
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-100 text-emerald-800 text-xs font-extrabold border border-emerald-200/60">
            🛡️ No Visa No Payment
          </span>
        </div>

        <div>
          <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight leading-snug">
            {title}
          </h3>
          {subtitle && (
            <p class="text-xs sm:text-sm text-slate-600 mt-2 leading-relaxed">
              {subtitle}
            </p>
          )}
        </div>

        <div class="grid grid-cols-2 gap-2.5 pt-1">
          <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs font-bold text-slate-700 flex items-center gap-2">
            <span class="text-emerald-600 font-extrabold text-sm">✓</span> No Visa, No Payment
          </div>
          <div class="p-3 rounded-2xl bg-slate-50 border border-slate-200/80 text-xs font-bold text-slate-700 flex items-center gap-2">
            <span class="text-amber-600 font-extrabold text-sm">⚡</span> 4-5 Day Express
          </div>
        </div>

        {leadCapture ? (
          <form id="popup-lead-form" class="space-y-3 pt-2">
            <div id="popup-form-fields" class="space-y-3">
              <input type="text" name="name" required placeholder="Full Name (As in Passport)" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:border-red-500 focus:bg-white transition-all" />
              <input type="tel" name="phone" required pattern="[0-9]{10}" placeholder="WhatsApp Mobile No." class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium focus:outline-none focus:border-red-500 focus:bg-white transition-all" />
              <button type="submit" id="popup-submit-btn" class="w-full py-3.5 px-6 rounded-2xl bg-gradient-to-r from-red-600 to-amber-600 hover:from-red-700 hover:to-amber-700 text-white font-extrabold text-xs sm:text-sm shadow-xl shadow-red-500/25 transition-all cursor-pointer hover:scale-[1.01]">
                {buttonText}
              </button>
            </div>
            <div id="popup-form-success" class="hidden p-4 bg-emerald-50 border border-emerald-200 rounded-2xl text-emerald-800 text-xs font-bold text-center space-y-1">
              <p>✓ Application Submitted Successfully!</p>
              <p class="font-normal text-emerald-700">Our team will call you within 30 minutes.</p>
            </div>
          </form>
        ) : (
          <div class="pt-2 flex items-center gap-3">
            <a
              href={linkUrl}
              class="flex-1 py-3.5 px-6 rounded-2xl bg-gradient-to-r from-red-600 to-amber-600 hover:from-red-700 hover:to-amber-700 text-white font-extrabold text-xs sm:text-sm shadow-xl shadow-red-500/25 text-center transition-all hover:scale-[1.02] active:scale-[0.98]"
            >
              {buttonText}
            </a>
            <a
              href="https://wa.me/919824152731?text=Hi%20TESCA,%20I%20want%20info%20on%20China%20Business%20Visa"
              target="_blank"
              rel="noreferrer"
              class="p-3.5 rounded-2xl bg-emerald-500 hover:bg-emerald-600 text-white transition-all shadow-lg shrink-0 flex items-center justify-center hover:scale-105"
              title="Instant WhatsApp Chat"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-0.999 3.648 3.742-.981z"/>
              </svg>
            </a>
          </div>
        )}
      </div>
    )}
  </div>
</div>

<!-- 2. Floating Bottom Smart Drawer Popup (Persistent Access) -->
<div
  id="promo-drawer-overlay"
  class="fixed inset-x-4 bottom-24 md:bottom-6 md:right-6 md:left-auto z-[99] max-w-full md:max-w-[420px] pointer-events-none transition-all duration-500 ease-out select-none"
>
  <div
    id="promo-drawer-card"
    class="relative bg-white/95 backdrop-blur-xl w-full rounded-3xl p-4 md:p-5 shadow-2xl border border-slate-200/90 flex flex-col transform translate-y-12 opacity-0 pointer-events-auto transition-all duration-500 ease-out overflow-hidden"
  >
    {/* Drawer Close Button */}
    <button
      type="button"
      id="promo-drawer-close"
      class="absolute top-3.5 right-3.5 z-50 p-1.5 bg-slate-100 hover:bg-slate-200 text-slate-500 hover:text-slate-900 rounded-full transition-all cursor-pointer hover:scale-110"
      aria-label="Close drawer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>

    {/* Drawer Header Badges */}
    <div class="flex items-center justify-between gap-2 mb-2 pr-8">
      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-red-600 text-white text-[10px] font-extrabold uppercase tracking-wider">
        🔥 Trending Promo
      </span>
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 text-[10px] font-extrabold">
        🛡️ No Visa No Payment
      </span>
    </div>

    <div class="space-y-2 text-left">
      <h4 class="text-sm md:text-base font-extrabold text-slate-900 tracking-tight leading-snug">
        {title}
      </h4>
      <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
        {subtitle}
      </p>

      <div class="pt-2 flex items-center gap-2">
        <a
          href={linkUrl}
          class="flex-1 py-2.5 px-4 rounded-xl bg-gradient-to-r from-red-600 to-amber-600 text-white font-bold text-xs text-center shadow-md hover:scale-[1.01] transition-all"
        >
          {buttonText}
        </a>
        <button
          type="button"
          id="reopen-main-popup-btn"
          class="px-3 py-2.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs border border-slate-200 shrink-0 transition-all cursor-pointer"
        >
          View Poster
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let popupTimer: ReturnType<typeof setTimeout> | null = null;

  function isAdminOrExcludedPath() {
    const path = window.location.pathname.toLowerCase();
    const host = window.location.hostname.toLowerCase();
    return (
      path.startsWith("/admin") ||
      host.startsWith("admin.") ||
      path.includes("review-generator") ||
      path.startsWith("/documents") ||
      path.startsWith("/promo")
    );
  }

  function initPromoPopups() {
    if (popupTimer) {
      clearTimeout(popupTimer);
      popupTimer = null;
    }

    if (isAdminOrExcludedPath()) return;

    const mainOverlay = document.getElementById("promo-popup-overlay");
    const mainCard = document.getElementById("promo-popup-card");
    const mainCloseBtn = document.getElementById("promo-popup-close");

    const drawerCard = document.getElementById("promo-drawer-card");
    const drawerCloseBtn = document.getElementById("promo-drawer-close");
    const reopenBtn = document.getElementById("reopen-main-popup-btn");

    if (!mainOverlay || !mainCard) return;

    const delaySec = Number(mainOverlay.getAttribute("data-delay")) || 5;
    const urlParams = new URLSearchParams(window.location.search);
    const isTestMode = urlParams.get("test-popup") === "true";

    const showDrawer = () => {
      if (!drawerCard) return;
      const lastDrawerClosed = sessionStorage.getItem("promo_drawer_closed_at");
      if (lastDrawerClosed && !isTestMode) return;
      drawerCard.classList.remove("translate-y-12", "opacity-0", "pointer-events-none");
      drawerCard.classList.add("translate-y-0", "opacity-100");
    };

    const closeDrawer = () => {
      sessionStorage.setItem("promo_drawer_closed_at", Date.now().toString());
      if (drawerCard) {
        drawerCard.classList.remove("translate-y-0", "opacity-100");
        drawerCard.classList.add("translate-y-12", "opacity-0", "pointer-events-none");
      }
    };

    if (drawerCloseBtn) drawerCloseBtn.onclick = closeDrawer;

    const showMainPopup = () => {
      mainOverlay.classList.remove("hidden");
      document.body.style.overflow = "hidden";
      requestAnimationFrame(() => {
        mainCard.classList.remove("scale-95", "opacity-0");
        mainCard.classList.add("scale-100", "opacity-100");
      });
    };

    const closeMainPopup = () => {
      sessionStorage.setItem("main_popup_closed_at", Date.now().toString());
      mainCard.classList.remove("scale-100", "opacity-100");
      mainCard.classList.add("scale-95", "opacity-0");
      document.body.style.overflow = "";
      setTimeout(() => {
        mainOverlay.classList.add("hidden");
        showDrawer();
      }, 300);
    };

    if (mainCloseBtn) mainCloseBtn.onclick = closeMainPopup;
    mainOverlay.onclick = (e) => {
      if (e.target === mainOverlay) closeMainPopup();
    };

    if (reopenBtn) {
      reopenBtn.onclick = () => {
        showMainPopup();
      };
    }

    // Safe Lead Form Submit Handling (no DOM removal errors)
    const leadForm = document.getElementById("popup-lead-form") as HTMLFormElement | null;
    const formFields = document.getElementById("popup-form-fields");
    const formSuccess = document.getElementById("popup-form-success");

    if (leadForm && formFields && formSuccess) {
      leadForm.onsubmit = async (e) => {
        e.preventDefault();
        const submitBtn = document.getElementById("popup-submit-btn") as HTMLButtonElement | null;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.innerText = "Submitting...";
        }

        const formData = new FormData(leadForm);
        const name = formData.get("name")?.toString() || "";
        const phone = formData.get("phone")?.toString() || "";

        try {
          const res = await fetch("/api/inquiry", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              name,
              phone,
              preferred_countries: ["China 🇨🇳"],
              visa_type: "Business (M Visa) / Special Promo",
              notes: "Submitted via Main Screen Promo Popup",
              source: "Main Screen Popup",
            }),
          });

          if (res.ok) {
            formFields.classList.add("hidden");
            formSuccess.classList.remove("hidden");
            setTimeout(closeMainPopup, 2500);
          }
        } catch (err) {
          alert("Failed to submit. Please try again.");
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerText = "Submit Request";
          }
        }
      };
    }

    // Trigger main screen popup after delaySec seconds
    popupTimer = setTimeout(() => {
      if (isAdminOrExcludedPath()) return;

      const currentClosed = sessionStorage.getItem("main_popup_closed_at");
      if (currentClosed && !isTestMode) {
        const elapsed = Date.now() - parseInt(currentClosed, 10);
        if (elapsed < 3 * 60 * 1000) {
          showDrawer();
          return;
        }
      }

      showMainPopup();
    }, delaySec * 1000);
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initPromoPopups);
  } else {
    initPromoPopups();
  }

  document.addEventListener("astro:page-load", () => {
    initPromoPopups();
  });
</script>
